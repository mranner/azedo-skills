def _global_styles_id(inst):
    """Die User-Global-Styles-ID haengt am aktiven Theme (_links)"""
    themes = api_call(inst, "GET", "themes", params={"status": "active"})
    if not themes:
        print("Error: kein aktives Theme ueber die API sichtbar", file=sys.stderr)
        sys.exit(1)
    links = themes[0].get("_links") or {}
    href = (links.get("wp:user-global-styles") or [{}])[0].get("href")
    if not href:
        print(
            "Error: keine Global Styles vorhanden -- das aktive Theme ist "
            "vermutlich ein Classic-Theme. Customizer-CSS geht nur ueber wp-cli.",
            file=sys.stderr,
        )
        sys.exit(1)
    return href.rstrip("/").rsplit("/", 1)[-1]


def cmd_get_global_styles(args):
    inst = resolve_instance(args.instance)
    if args.theme_defaults:
        themes = api_call(inst, "GET", "themes", params={"status": "active"})
        stylesheet = themes[0].get("stylesheet")
        item = api_call(inst, "GET", f"global-styles/themes/{stylesheet}")
    else:
        item = api_call(inst, "GET", f"global-styles/{_global_styles_id(inst)}")

    if args.css_output:
        css = ((item.get("styles") or {}).get("css")) or ""
        with open(args.css_output, "w", encoding="utf-8") as f:
            f.write(css)
        out_json({"id": item.get("id"), "css_file": os.path.abspath(args.css_output), "bytes": len(css.encode("utf-8"))})
        return
    out_json(item)


def cmd_set_global_css(args):
    inst = resolve_instance(args.instance)
    gid = _global_styles_id(inst)
    current = api_call(inst, "GET", f"global-styles/{gid}")
    styles = current.get("styles") or {}
    # Nur das Feld css ersetzen, der Rest der theme.json-Ebene bleibt stehen.
    styles["css"] = read_content(args) or ""
    item = api_call(inst, "POST", f"global-styles/{gid}", data={"styles": styles})
    out_json({"id": item.get("id"), "bytes": len(styles["css"].encode("utf-8"))})


def cmd_set_global_styles(args):
    inst = resolve_instance(args.instance)
    gid = _global_styles_id(inst)
    payload = read_json_file(args.file)
    item = api_call(inst, "POST", f"global-styles/{gid}", data=payload)
    out_json({"id": item.get("id"), "gesetzt": sorted(payload.keys())})


# ---- WooCommerce ----------------------------------------------------------


def cmd_wc_list(args):
    inst = resolve_instance(args.instance)
    params = {"per_page": args.per_page, "page": args.page, "search": args.search}
    for pair in args.param or []:
        if "=" not in pair:
            print(f"Error: --param braucht key=value, nicht '{pair}'", file=sys.stderr)
            sys.exit(1)
        k, v = pair.split("=", 1)
        params[k] = v
    items = api_call(inst, "GET", args.resource, params=params, namespace="wc/v3")
    out_json(items if args.json else [slim_generic(i) for i in items])


def cmd_wc_get(args):
    inst = resolve_instance(args.instance)
    out_json(api_call(inst, "GET", f"{args.resource}/{args.id}", namespace="wc/v3"))


def cmd_wc_create(args):
    inst = resolve_instance(args.instance)
    item = api_call(
        inst, "POST", args.resource, data=read_json_file(args.file), namespace="wc/v3"
    )
    out_json(slim_generic(item))


def cmd_wc_update(args):
    inst = resolve_instance(args.instance)
    item = api_call(
        inst,
        "PUT",
        f"{args.resource}/{args.id}",
        data=read_json_file(args.file),
        namespace="wc/v3",
    )
    out_json(slim_generic(item))


def cmd_wc_delete(args):
    inst = resolve_instance(args.instance)
    path = f"{args.resource}/{args.id}"
    if not args.yes:
        item = api_call(inst, "GET", path, namespace="wc/v3")
        out_json(
            {
                "dry_run": True,
                "wuerde_loeschen": slim_generic(item),
                "endgueltig": bool(args.force),
                "hinweis": "mit --yes ausfuehren",
            }
        )
        return
    res = api_call(
        inst, "DELETE", path, params={"force": args.force}, namespace="wc/v3"
    )
    out_json({"geloescht": True, "endgueltig": bool(args.force), "id": (res or {}).get("id", args.id)})


# ---- Roher Aufruf ---------------------------------------------------------


def cmd_request(args):
    inst = resolve_instance(args.instance)
    params = {}
    for pair in args.param or []:
        if "=" not in pair:
            print(f"Error: --param braucht key=value, nicht '{pair}'", file=sys.stderr)
            sys.exit(1)
        k, v = pair.split("=", 1)
        params[k] = v
    data = read_json_file(args.file) if args.file else None
    out_json(
        api_call(
            inst, args.method.upper(), args.path, data=data, params=params,
            namespace=args.namespace,
        )
    )


def build_parser():
    p = argparse.ArgumentParser(
        prog="wp-rest",
        description="WordPress REST API helper (multi-instance): Inhalte, Medien, "
        "Templates, Global Styles, WooCommerce",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_instance(sp):
        sp.add_argument(
            "-i", "--instance", help="Instanz-Name (Default: WP_DEFAULT_INSTANCE)"
        )

    def add_type(sp):
        sp.add_argument(
            "--type",
            default="post",
            help="Post-Type: post, page, wp_block, media (Default post)",
        )
        sp.add_argument(
            "--endpoint", help="Endpunkt unter wp/v2 direkt angeben (statt --type)"
        )

    def add_paging(sp):
        sp.add_argument("--per-page", type=int, default=20, help="Treffer pro Seite (Default 20)")
        sp.add_argument("--page", type=int, default=1, help="Seite (Default 1)")

    def add_json(sp):
        sp.add_argument("--json", action="store_true", help="rohes JSON ausgeben")

    def add_content(sp):
        sp.add_argument("--content", help="Inhalt inline (nur ASCII-Text zumutbar)")
        sp.add_argument(
            "--content-file", help="Inhalt aus Datei lesen, UTF-8 ('-' = stdin)"
        )

    sp = sub.add_parser("instances", help="konfigurierte Instanzen auflisten")
    sp.set_defaults(func=cmd_instances)

    sp = sub.add_parser("whoami", help="Zugang und Rechte des App-Passworts pruefen")
    add_instance(sp)
    sp.set_defaults(func=cmd_whoami)

    sp = sub.add_parser("list-posts", help="Beitraege/Seiten/Bloecke auflisten")
    add_instance(sp)
    add_type(sp)
    add_paging(sp)
    add_json(sp)
    sp.add_argument("--status", help="publish, draft, pending, private, any")
    sp.add_argument("--search", help="Suchbegriff")
    sp.add_argument("--parent", type=int, help="nur Kinder dieser Seite")
    sp.add_argument("--categories", help="Kategorie-IDs, komma-getrennt")
    sp.add_argument("--tags", help="Schlagwort-IDs, komma-getrennt")
    sp.add_argument("--orderby", help="date, title, menu_order, modified")
    sp.add_argument("--order", help="asc oder desc")
    sp.set_defaults(func=cmd_list_posts)

    sp = sub.add_parser("get-post", help="einzelnen Beitrag/Seite anzeigen")
    add_instance(sp)
    add_type(sp)
    add_json(sp)
    sp.add_argument("id", type=int)
    sp.add_argument(
        "--rendered",
        action="store_true",
        help="content.rendered statt Roh-Markup (NICHT zum Zurueckschreiben)",
    )
    sp.add_argument("--output", help="Inhalt in diese Datei schreiben")
    sp.set_defaults(func=cmd_get_post)

    def add_post_fields(sp):
        sp.add_argument("--title")
        sp.add_argument("--excerpt")
        sp.add_argument("--status", help="publish, draft, pending, private")
        sp.add_argument("--slug")
        sp.add_argument("--date", help="ISO-8601, z.B. 2026-09-14T10:00:00")
        sp.add_argument("--parent", type=int, help="Elternseite")
        sp.add_argument("--featured-media", type=int, help="Beitragsbild (Media-ID)")
        sp.add_argument("--template", help="Seitentemplate (Dateiname)")

    sp = sub.add_parser("create-post", help="Beitrag/Seite/Block anlegen (schreibend)")
    add_instance(sp)
    add_type(sp)
    add_content(sp)
    add_post_fields(sp)
    sp.set_defaults(func=cmd_create_post)

    sp = sub.add_parser("update-post", help="einzelne Felder aendern (schreibend)")
    add_instance(sp)
    add_type(sp)
    add_content(sp)
    add_post_fields(sp)
    sp.add_argument("id", type=int)
    sp.set_defaults(func=cmd_update_post)

    sp = sub.add_parser("set-status", help="Status setzen (schreibend)")
    add_instance(sp)
    add_type(sp)
    sp.add_argument("id", type=int)
    sp.add_argument("status", help="publish, draft, pending, private")
    sp.set_defaults(func=cmd_set_status)

    sp = sub.add_parser("delete-post", help="Beitrag/Seite loeschen (--yes noetig)")
    add_instance(sp)
    add_type(sp)
    sp.add_argument("id", type=int)
    sp.add_argument("--force", action="store_true", help="endgueltig statt Papierkorb")
    sp.add_argument("--yes", action="store_true", help="ausfuehren (ohne: nur dry-run)")
    sp.set_defaults(func=cmd_delete_post)

    sp = sub.add_parser("list-terms", help="Kategorien/Schlagworte auflisten")
    add_instance(sp)
    add_paging(sp)
    add_json(sp)
    sp.add_argument("--taxonomy", default="categories", help="categories oder tags")
    sp.add_argument("--search")
    sp.set_defaults(func=cmd_list_terms)

    sp = sub.add_parser("create-term", help="Kategorie/Schlagwort anlegen (schreibend)")
    add_instance(sp)
    sp.add_argument("--taxonomy", default="categories", help="categories oder tags")
    sp.add_argument("--name", required=True)
    sp.add_argument("--slug")
    sp.add_argument("--parent", type=int)
    sp.add_argument("--description")
    sp.set_defaults(func=cmd_create_term)

    sp = sub.add_parser("set-terms", help="Kategorien/Schlagworte zuweisen (schreibend)")
    add_instance(sp)
    add_type(sp)
    sp.add_argument("id", type=int)
    sp.add_argument("--categories", help="Namen oder IDs, komma-getrennt")
    sp.add_argument("--tags", help="Namen oder IDs, komma-getrennt")
    sp.add_argument("--create", action="store_true", help="fehlende Begriffe anlegen")
    sp.set_defaults(func=cmd_set_terms)

    sp = sub.add_parser("upload-media", help="Datei hochladen (schreibend)")
    add_instance(sp)
    sp.add_argument("file", help="absoluter Pfad zur Datei")
    sp.add_argument("--filename", help="abweichender Dateiname (wird zum Slug)")
    sp.add_argument("--title")
    sp.add_argument("--alt", help="Alt-Text")
    sp.add_argument("--caption")
    sp.add_argument("--description")
    sp.add_argument("--post", type=int, help="Zuordnung zu einem Beitrag")
    sp.set_defaults(func=cmd_upload_media)

    sp = sub.add_parser("list-media", help="Mediathek auflisten")
    add_instance(sp)
    add_paging(sp)
    add_json(sp)
    sp.add_argument("--search")
    sp.add_argument("--media-type", help="image, video, audio, application")
    sp.add_argument("--post", type=int, help="nur Anhaenge dieses Beitrags")
    sp.set_defaults(func=cmd_list_media)

    sp = sub.add_parser("update-media", help="Titel/Alt-Text aendern (schreibend)")
    add_instance(sp)
    sp.add_argument("id", type=int)
    sp.add_argument("--title")
    sp.add_argument("--alt")
    sp.add_argument("--caption")
    sp.add_argument("--description")
    sp.add_argument("--post", type=int)
    sp.set_defaults(func=cmd_update_media)

    sp = sub.add_parser("delete-media", help="Medium loeschen (--yes noetig)")
    add_instance(sp)
    sp.add_argument("id", type=int)
    sp.add_argument("--yes", action="store_true", help="ausfuehren (ohne: nur dry-run)")
    sp.set_defaults(func=cmd_delete_media)

    sp = sub.add_parser("list-templates", help="Templates auflisten (Block-Themes)")
    add_instance(sp)
    add_json(sp)
    sp.add_argument("--parts", action="store_true", help="template-parts statt templates")
    sp.set_defaults(func=cmd_list_templates)

    sp = sub.add_parser("get-template", help="Template anzeigen (Block-Themes)")
    add_instance(sp)
    add_json(sp)
    sp.add_argument("id", help="Template-ID, z.B. theme//single")
    sp.add_argument("--parts", action="store_true")
    sp.add_argument("--output", help="Markup in diese Datei schreiben")
    sp.set_defaults(func=cmd_get_template)

    sp = sub.add_parser("update-template", help="Template-Markup setzen (schreibend)")
    add_instance(sp)
    add_content(sp)
    sp.add_argument("id", help="Template-ID, z.B. theme//single")
    sp.add_argument("--parts", action="store_true")
    sp.set_defaults(func=cmd_update_template)

    sp = sub.add_parser("get-global-styles", help="Global Styles lesen (Block-Themes)")
    add_instance(sp)
    sp.add_argument(
        "--theme-defaults",
        action="store_true",
        help="Theme-Vorgaben statt der eigenen Einstellungen",
    )
    sp.add_argument("--css-output", help="nur styles.css in diese Datei schreiben")
    sp.set_defaults(func=cmd_get_global_styles)

    sp = sub.add_parser("set-global-css", help="styles.css setzen (schreibend)")
    add_instance(sp)
    add_content(sp)
    sp.set_defaults(func=cmd_set_global_css)

    sp = sub.add_parser(
        "set-global-styles", help="Global-Styles-JSON setzen (schreibend)"
    )
    add_instance(sp)
    sp.add_argument("--file", required=True, help="JSON mit styles/settings")
    sp.set_defaults(func=cmd_set_global_styles)

    sp = sub.add_parser("wc-list", help="WooCommerce-Ressource auflisten")
    add_instance(sp)
    add_paging(sp)
    add_json(sp)
    sp.add_argument("resource", help="products, orders, customers, coupons, products/categories")
    sp.add_argument("--search")
    sp.add_argument("--param", action="append", help="key=value, mehrfach moeglich")
    sp.set_defaults(func=cmd_wc_list)

    sp = sub.add_parser("wc-get", help="einzelne WooCommerce-Ressource anzeigen")
    add_instance(sp)
    sp.add_argument("resource")
    sp.add_argument("id")
    sp.set_defaults(func=cmd_wc_get)

    sp = sub.add_parser("wc-create", help="WooCommerce-Ressource anlegen (schreibend)")
    add_instance(sp)
    sp.add_argument("resource")
    sp.add_argument("--file", required=True, help="JSON-Datei mit den Feldern ('-' = stdin)")
    sp.set_defaults(func=cmd_wc_create)

    sp = sub.add_parser("wc-update", help="WooCommerce-Ressource aendern (schreibend)")
    add_instance(sp)
    sp.add_argument("resource")
    sp.add_argument("id")
    sp.add_argument("--file", required=True, help="JSON-Datei mit den Feldern ('-' = stdin)")
    sp.set_defaults(func=cmd_wc_update)

    sp = sub.add_parser("wc-delete", help="WooCommerce-Ressource loeschen (--yes noetig)")
    add_instance(sp)
    sp.add_argument("resource")
    sp.add_argument("id")
    sp.add_argument("--force", action="store_true", help="endgueltig statt Papierkorb")
    sp.add_argument("--yes", action="store_true", help="ausfuehren (ohne: nur dry-run)")
    sp.set_defaults(func=cmd_wc_delete)

    sp = sub.add_parser("request", help="roher REST-Aufruf (Escape-Hatch)")
    add_instance(sp)
    sp.add_argument("method", help="GET, POST, PUT, DELETE")
    sp.add_argument("path", help="Pfad unter dem Namespace, z.B. settings")
    sp.add_argument("--namespace", default="wp/v2", help="Default wp/v2")
    sp.add_argument("--param", action="append", help="key=value, mehrfach moeglich")
    sp.add_argument("--file", help="JSON-Body aus Datei ('-' = stdin)")
    sp.set_defaults(func=cmd_request)

    return p


def main():
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
