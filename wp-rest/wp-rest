#!/usr/bin/env python3

# WordPress REST API helper (multi-instance): /wp-json/wp/v2/ fuer Inhalte,
# /wp-json/wc/v3/ fuer WooCommerce. Auth per Application Password (Basic).
# stdlib only, no pip dependencies

import argparse
import base64
import json
import mimetypes
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from collections import namedtuple

SKILL_DIR = os.path.dirname(os.path.realpath(__file__))

# Aufgeloeste Instanz: name + base-URL + Authorization-Header fuer wp/v2 und wc/v3
Instance = namedtuple("Instance", "name url auth wc_auth")

# Post-Type -> Endpunkt unter wp/v2. Alles andere geht ueber --endpoint.

TYPE_ENDPOINTS = {
    "post": "posts",
    "page": "pages",
    "wp_block": "blocks",
    "media": "media",
    "nav_menu_item": "menu-items",
}


def env_path():
    override = os.environ.get("WP_REST_ENV")
    if override:
        return override
    if os.path.exists(".env"):
        return os.path.abspath(".env")
    return os.path.join(os.path.expanduser("~"), ".env")


_env = None


def load_env():
    """Liest die .env (gecached) und legt sie ueber os.environ; die Datei gewinnt."""
    global _env
    if _env is not None:
        return _env

    values = dict(os.environ)
    path = env_path()
    if os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if line.startswith("export "):
                        line = line[len("export "):].strip()
                    if "=" not in line:
                        continue
                    key, val = line.split("=", 1)
                    val = val.strip()
                    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                        val = val[1:-1]
                    values[key.strip()] = val
        except OSError as e:
            print(f"Error: {path} nicht lesbar: {e}", file=sys.stderr)
            sys.exit(1)

    _env = values
    return _env


def list_instances():
    """Instanz-Namen aus allen WP_<NAME>_URL ableiten (klein geschrieben)"""
    env = load_env()
    names = []
    for key in env:
        m = re.fullmatch(r"WP_([A-Z0-9_]+)_URL", key)
        if m:
            names.append(m.group(1).lower())
    return sorted(names)


def resolve_instance(name):
    """(--instance | WP_DEFAULT_INSTANCE | einzige konfigurierte) -> Instance"""
    env = load_env()
    available = list_instances()

    if not name:
        name = env.get("WP_DEFAULT_INSTANCE")
    if not name and len(available) == 1:
        name = available[0]
    if not name:
        avail = ", ".join(available) or "(keine)"
        print(
            "Error: keine Instanz bestimmbar (kein --instance, kein "
            f"WP_DEFAULT_INSTANCE). Verfuegbar: {avail}",
            file=sys.stderr,
        )
        sys.exit(1)

    key = name.upper().replace("-", "_")
    url = env.get(f"WP_{key}_URL")
    user = env.get(f"WP_{key}_USER")
    password = env.get(f"WP_{key}_APP_PASSWORD")

    if not url:
        avail = ", ".join(available) or "(keine)"
        print(
            f"Error: Instanz '{name}' unbekannt (kein WP_{key}_URL in "
            f"{env_path()}). Verfuegbar: {avail}",
            file=sys.stderr,
        )
        sys.exit(1)
    if not user or not password:
        print(
            f"Error: Instanz '{name}' ohne WP_{key}_USER / WP_{key}_APP_PASSWORD",
            file=sys.stderr,
        )
        sys.exit(1)

    auth = "Basic " + base64.b64encode(f"{user}:{password}".encode()).decode()

    # WooCommerce akzeptiert dasselbe Application Password; eigene Consumer-Keys
    # nur, wenn sie gesetzt sind.
    ck = env.get(f"WP_{key}_WC_KEY")
    cs = env.get(f"WP_{key}_WC_SECRET")
    wc_auth = auth
    if ck and cs:
        wc_auth = "Basic " + base64.b64encode(f"{ck}:{cs}".encode()).decode()

    return Instance(name.lower(), url.rstrip("/"), auth, wc_auth)


def api_call(inst, method, path, data=None, params=None, namespace="wp/v2"):
    """HTTP-Request an /wp-json/<namespace>/<path>"""
    url = f"{inst.url}/wp-json/{namespace.strip('/')}/{path.lstrip('/')}"

    if params:
        flat = []
        for k, v in params.items():
            if v is None:
                continue
            if isinstance(v, (list, tuple)):
                flat.append((k, ",".join(str(x) for x in v)))
            elif isinstance(v, bool):
                flat.append((k, "true" if v else "false"))
            else:
                flat.append((k, str(v)))
        if flat:
            url += "?" + urllib.parse.urlencode(flat)

    body = json.dumps(data).encode("utf-8") if data is not None else None
    auth = inst.wc_auth if namespace.startswith("wc/") else inst.auth
    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Authorization": auth,
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "wp-rest-skill",
        },
        method=method,
    )
    return _send(req, url)


def api_upload(inst, filepath, filename=None):
    """Medien-Upload als Binary-Body; der Dateiname wird zum Slug."""
    fname = filename or os.path.basename(filepath)
    ctype = mimetypes.guess_type(fname)[0] or "application/octet-stream"
    try:
        with open(filepath, "rb") as f:
            content = f.read()
    except OSError as e:
        print(f"Error: {filepath} nicht lesbar: {e}", file=sys.stderr)
        sys.exit(1)

    url = f"{inst.url}/wp-json/wp/v2/media"
    req = urllib.request.Request(
        url,
        data=content,
        method="POST",
        headers={
            "Authorization": inst.auth,
            "Content-Type": ctype,
            "Content-Disposition": f'attachment; filename="{fname}"',
            "Accept": "application/json",
            "User-Agent": "wp-rest-skill",
        },
    )
    return _send(req, url)


def _send(req, url):
    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            if not raw:
                return None
            try:
                return json.loads(raw.decode("utf-8"))
            except ValueError:
                # 200 mit HTML statt JSON: meist eine vorgeschaltete Login-/
                # Security-Seite oder ein Plugin, das die REST-API abschaltet.
                print(
                    f"Error: Antwort von {url} ist kein JSON "
                    f"({resp.headers.get('Content-Type', '?')}) -- vermutlich eine "
                    "Login-Seite oder eine gesperrte REST-API.",
                    file=sys.stderr,
                )
                sys.exit(1)
    except urllib.error.HTTPError as e:
        err = e.read().decode("utf-8", errors="replace")
        print(f"API error {e.code}: {err}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Verbindungsfehler: {e.reason}", file=sys.stderr)
        sys.exit(1)


def out_json(data):
    print(json.dumps(data, indent=2, ensure_ascii=False))


def read_content(args):
    """Inhalt aus --content-file ('-' = stdin) oder --content lesen"""
    path = getattr(args, "content_file", None)
    if path:
        if path == "-":
            return sys.stdin.read()
        try:
            with open(path, encoding="utf-8") as f:
                return f.read()
        except OSError as e:
            print(f"Error: {path} nicht lesbar: {e}", file=sys.stderr)
            sys.exit(1)
    return getattr(args, "content", None)


def read_json_file(path):
    if path == "-":
        raw = sys.stdin.read()
    else:
        try:
            with open(path, encoding="utf-8") as f:
                raw = f.read()
        except OSError as e:
            print(f"Error: {path} nicht lesbar: {e}", file=sys.stderr)
            sys.exit(1)
    try:
        return json.loads(raw)
    except ValueError as e:
        print(f"Error: {path} ist kein gueltiges JSON: {e}", file=sys.stderr)
        sys.exit(1)


def endpoint_for(args):
    """Endpunkt aus --endpoint oder --type ableiten"""
    if getattr(args, "endpoint", None):
        return args.endpoint.strip("/")
    ptype = getattr(args, "type", None) or "post"
    if ptype in TYPE_ENDPOINTS:
        return TYPE_ENDPOINTS[ptype]
    print(
        f"Error: unbekannter Post-Type '{ptype}'. Bekannt: "
        f"{', '.join(sorted(TYPE_ENDPOINTS))}. Sonst --endpoint verwenden.",
        file=sys.stderr,
    )
    sys.exit(1)


def _text(field):
    """{'rendered': ...} / {'raw': ...} auf den Text reduzieren"""
    if isinstance(field, dict):
        return field.get("raw") or field.get("rendered") or ""
    return field


def slim_post(item):
    return {
        "id": item.get("id"),
        "date": item.get("date"),
        "status": item.get("status"),
        "type": item.get("type"),
        "slug": item.get("slug"),
        "title": _text(item.get("title")),
        "parent": item.get("parent"),
        "link": item.get("link"),
    }


def slim_media(item):
    return {
        "id": item.get("id"),
        "date": item.get("date"),
        "slug": item.get("slug"),
        "title": _text(item.get("title")),
        "alt_text": item.get("alt_text"),
        "mime_type": item.get("mime_type"),
        "post": item.get("post"),
        "source_url": item.get("source_url"),
    }


def slim_term(item):
    return {
        "id": item.get("id"),
        "name": item.get("name"),
        "slug": item.get("slug"),
        "parent": item.get("parent"),
        "count": item.get("count"),
    }


def slim_generic(item):
    """Fuer WooCommerce und Templates: die ueblichen Kennfelder, sofern vorhanden"""
    keys = (
        "id",
        "name",
        "slug",
        "sku",
        "status",
        "type",
        "price",
        "number",
        "total",
        "theme",
        "date_created",
        "date_modified",
    )
    out = {k: item[k] for k in keys if k in item}
    if "title" in item:
        out["title"] = _text(item["title"])
    return out or item


# ---- Instanzen und Zugang -------------------------------------------------


def cmd_instances(args):
    env = load_env()
    rows = []
    for name in list_instances():
        key = name.upper()
        rows.append(
            {
                "instance": name,
                "url": env.get(f"WP_{key}_URL"),
                "user": env.get(f"WP_{key}_USER"),
                "app_password": "gesetzt" if env.get(f"WP_{key}_APP_PASSWORD") else "fehlt",
                "wc_keys": "eigene" if env.get(f"WP_{key}_WC_KEY") else "App Password",
            }
        )
    out_json({"env": env_path(), "default": env.get("WP_DEFAULT_INSTANCE"), "instances": rows})


def cmd_whoami(args):
    inst = resolve_instance(args.instance)
    me = api_call(inst, "GET", "users/me", params={"context": "edit"})
    out_json(
        {
            "instance": inst.name,
            "url": inst.url,
            "id": me.get("id"),
            "name": me.get("name"),
            "slug": me.get("slug"),
            "roles": me.get("roles"),
            "capabilities": sorted(
                k for k, v in (me.get("capabilities") or {}).items() if v
            ),
        }
    )


# ---- Beitraege, Seiten, wiederverwendbare Bloecke --------------------------


def cmd_list_posts(args):
    inst = resolve_instance(args.instance)
    params = {
        "status": args.status,
        "search": args.search,
        "per_page": args.per_page,
        "page": args.page,
        "parent": args.parent,
        "categories": args.categories,
        "tags": args.tags,
        "orderby": args.orderby,
        "order": args.order,
        "context": "edit",
    }
    items = api_call(inst, "GET", endpoint_for(args), params=params)
    if args.json:
        out_json(items)
        return
    slim = slim_media if endpoint_for(args) == "media" else slim_post
    out_json([slim(i) for i in items])


def cmd_get_post(args):
    inst = resolve_instance(args.instance)
    # context=edit liefert content.raw -- nur das darf zurueckgeschrieben werden.
    ctx = "view" if args.rendered else "edit"
    item = api_call(inst, "GET", f"{endpoint_for(args)}/{args.id}", params={"context": ctx})

    if args.output:
        content = _text(item.get("content"))
        try:
            with open(args.output, "w", encoding="utf-8") as f:
                f.write(content)
        except OSError as e:
            print(f"Error: {args.output} nicht schreibbar: {e}", file=sys.stderr)
            sys.exit(1)
        out_json(
            {
                "id": item.get("id"),
                "title": _text(item.get("title")),
                "status": item.get("status"),
                "context": ctx,
                "content_file": os.path.abspath(args.output),
                "bytes": len(content.encode("utf-8")),
            }
        )
        return

    if args.json:
        out_json(item)
        return
    data = slim_post(item)
    data["content"] = _text(item.get("content"))
    out_json(data)


def _post_payload(args, content):
    """Nur die tatsaechlich uebergebenen Felder einsammeln"""
    payload = {}
    if args.title is not None:
        payload["title"] = args.title
    if content is not None:
        payload["content"] = content
    if args.excerpt is not None:
        payload["excerpt"] = args.excerpt
    if args.status is not None:
        payload["status"] = args.status
    if args.slug is not None:
        payload["slug"] = args.slug
    if args.date is not None:
        payload["date"] = args.date
    if args.parent is not None:
        payload["parent"] = args.parent
    if args.featured_media is not None:
        payload["featured_media"] = args.featured_media
    if getattr(args, "template", None) is not None:
        payload["template"] = args.template
    return payload


def cmd_create_post(args):
    inst = resolve_instance(args.instance)
    payload = _post_payload(args, read_content(args))
    if not payload.get("title") and not payload.get("content"):
        print("Error: mindestens --title oder --content/--content-file noetig", file=sys.stderr)
        sys.exit(1)
    payload.setdefault("status", "draft")
    item = api_call(inst, "POST", endpoint_for(args), data=payload)
    out_json(slim_post(item))


def cmd_update_post(args):
    inst = resolve_instance(args.instance)
    payload = _post_payload(args, read_content(args))
    if not payload:
        print("Error: kein Feld zum Aendern angegeben", file=sys.stderr)
        sys.exit(1)
    item = api_call(inst, "POST", f"{endpoint_for(args)}/{args.id}", data=payload)
    out_json(slim_post(item))


def cmd_set_status(args):
    inst = resolve_instance(args.instance)
    item = api_call(
        inst, "POST", f"{endpoint_for(args)}/{args.id}", data={"status": args.status}
    )
    out_json(slim_post(item))


def cmd_delete_post(args):
    inst = resolve_instance(args.instance)
    path = f"{endpoint_for(args)}/{args.id}"
    if not args.yes:
        item = api_call(inst, "GET", path, params={"context": "edit"})
        out_json(
            {
                "dry_run": True,
                "wuerde_loeschen": slim_post(item),
                "endgueltig": bool(args.force),
                "hinweis": "mit --yes ausfuehren",
            }
        )
        return
    res = api_call(inst, "DELETE", path, params={"force": args.force})
    out_json({"geloescht": True, "endgueltig": bool(args.force), "antwort": slim_post(res.get("previous", res) if isinstance(res, dict) else res)})


