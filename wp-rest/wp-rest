def _taxonomy_endpoint(taxonomy):
    if taxonomy in ("categories", "category"):
        return "categories"
    if taxonomy in ("tags", "tag", "post_tag"):
        return "tags"
    return taxonomy


def cmd_list_terms(args):
    inst = resolve_instance(args.instance)
    items = api_call(
        inst,
        "GET",
        _taxonomy_endpoint(args.taxonomy),
        params={"search": args.search, "per_page": args.per_page, "page": args.page},
    )
    out_json(items if args.json else [slim_term(i) for i in items])


def cmd_create_term(args):
    inst = resolve_instance(args.instance)
    payload = {"name": args.name}
    if args.slug:
        payload["slug"] = args.slug
    if args.parent is not None:
        payload["parent"] = args.parent
    if args.description:
        payload["description"] = args.description
    item = api_call(inst, "POST", _taxonomy_endpoint(args.taxonomy), data=payload)
    out_json(slim_term(item))


def _resolve_terms(inst, endpoint, names, create):
    """Namen oder IDs zu Term-IDs aufloesen, fehlende optional anlegen"""
    ids = []
    for raw in names:
        raw = raw.strip()
        if not raw:
            continue
        if raw.isdigit():
            ids.append(int(raw))
            continue
        found = api_call(inst, "GET", endpoint, params={"search": raw, "per_page": 100})
        match = next((t for t in found if t.get("name", "").lower() == raw.lower()), None)
        if match:
            ids.append(match["id"])
            continue
        if not create:
            print(
                f"Error: Begriff '{raw}' existiert nicht in {endpoint} "
                "(mit --create anlegen lassen)",
                file=sys.stderr,
            )
            sys.exit(1)
        ids.append(api_call(inst, "POST", endpoint, data={"name": raw})["id"])
    return ids


def cmd_set_terms(args):
    inst = resolve_instance(args.instance)
    payload = {}
    if args.categories is not None:
        payload["categories"] = _resolve_terms(
            inst, "categories", args.categories.split(","), args.create
        )
    if args.tags is not None:
        payload["tags"] = _resolve_terms(inst, "tags", args.tags.split(","), args.create)
    if not payload:
        print("Error: --categories und/oder --tags angeben", file=sys.stderr)
        sys.exit(1)
    item = api_call(inst, "POST", f"{endpoint_for(args)}/{args.id}", data=payload)
    out_json(
        {
            "id": item.get("id"),
            "title": _text(item.get("title")),
            "categories": item.get("categories"),
            "tags": item.get("tags"),
        }
    )


# ---- Medien ---------------------------------------------------------------


def cmd_upload_media(args):
    inst = resolve_instance(args.instance)
    item = api_upload(inst, args.file, args.filename)

    meta = {}
    if args.title is not None:
        meta["title"] = args.title
    if args.alt is not None:
        meta["alt_text"] = args.alt
    if args.caption is not None:
        meta["caption"] = args.caption
    if args.description is not None:
        meta["description"] = args.description
    if args.post is not None:
        meta["post"] = args.post
    if meta:
        item = api_call(inst, "POST", f"media/{item['id']}", data=meta)

    out_json(slim_media(item))


def cmd_list_media(args):
    inst = resolve_instance(args.instance)
    items = api_call(
        inst,
        "GET",
        "media",
        params={
            "search": args.search,
            "media_type": args.media_type,
            "parent": args.post,
            "per_page": args.per_page,
            "page": args.page,
            "context": "edit",
        },
    )
    out_json(items if args.json else [slim_media(i) for i in items])


def cmd_update_media(args):
    inst = resolve_instance(args.instance)
    payload = {}
    for field, value in (
        ("title", args.title),
        ("alt_text", args.alt),
        ("caption", args.caption),
        ("description", args.description),
        ("post", args.post),
    ):
        if value is not None:
            payload[field] = value
    if not payload:
        print("Error: kein Feld zum Aendern angegeben", file=sys.stderr)
        sys.exit(1)
    out_json(slim_media(api_call(inst, "POST", f"media/{args.id}", data=payload)))


def cmd_delete_media(args):
    inst = resolve_instance(args.instance)
    # Medien kennen keinen Papierkorb -- die API verlangt force=true.
    if not args.yes:
        item = api_call(inst, "GET", f"media/{args.id}", params={"context": "edit"})
        out_json(
            {
                "dry_run": True,
                "wuerde_loeschen": slim_media(item),
                "hinweis": "Medien kennen keinen Papierkorb; mit --yes ausfuehren",
            }
        )
        return
    api_call(inst, "DELETE", f"media/{args.id}", params={"force": True})
    out_json({"geloescht": True, "id": args.id})


