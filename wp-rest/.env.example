# Profile fuer wp-rest. Echte Werte gehoeren in die .env ausserhalb des Repos
# (Projekt-.env oder ~/.env), niemals hierher.
#
# Das Application Password wird in WordPress unter Benutzer > Profil >
# "Anwendungspasswoerter" erzeugt und ist einzeln widerrufbar.

WP_DEFAULT_INSTANCE=<instanz>

WP_<INSTANZ>_URL=https://www.example.org
WP_<INSTANZ>_USER=<username>
WP_<INSTANZ>_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Optional: eigene WooCommerce-Consumer-Keys. Ohne diese beiden Zeilen wird das
# Application Password auch fuer /wc/v3 verwendet (Benutzer braucht dann
# manage_woocommerce).
#WP_<INSTANZ>_WC_KEY=ck_...
#WP_<INSTANZ>_WC_SECRET=cs_...
