#!/usr/bin/env python3

# GeoSphere Austria Wetter-Skill
# Kurzfristvorhersage (AROME, stuendlich ~60 h), Nowcast (15-min, ~3 h)
# und amtliche Wetterwarnungen fuer Oesterreich.
# stdlib only, keine pip-Abhaengigkeiten, keine Authentifizierung noetig.
# version 1.11.5

import argparse
import json
import math
import os
import sys
import urllib.parse
import urllib.request
import urllib.error
from datetime import datetime, timezone

try:
    from zoneinfo import ZoneInfo
    TZ = ZoneInfo("Europe/Vienna")
except Exception:
    TZ = None

# API-Basisadressen

FORECAST_BASE = "https://dataset.api.hub.geosphere.at/v1/timeseries/forecast"
NWP = "nwp-v1-1h-2500m"
NOWCAST = "nowcast-v1-15min-1km"
STATION_BASE = "https://dataset.api.hub.geosphere.at/v1/station/current/tawes-v1-10min"
WARN_BASE = "https://warnungen.zamg.at/wsapp/api/getWarningsForCoords"
NOMINATIM = "https://nominatim.openstreetmap.org/search"

USER_AGENT = "azedo-wetter-skill/1.0 (ich@example.org)"

# Favoriten-Stationen (kuratierte Liste) und Frische-Grenze fuer Messwerte

FAV_PATH = os.path.expanduser("~/.claude/wetter-favorites.json")
FRESH_MAX_SEC = 2 * 3600

# Gueltiger Koordinaten-Bereich der Modelle (bbox aus Metadaten)

BBOX = (42.981, 5.498, 51.819, 22.102)

# Warntypen und -stufen (dokumentiert in der Warn-API OpenAPI-Spec)

WARN_TYPE = {
    1: "Sturm", 2: "Regen", 3: "Schnee", 4: "Glatteis",
    5: "Gewitter", 6: "Hitze", 7: "Kaelte",
}
WARN_LEVEL = {1: "gelb", 2: "orange", 3: "rot"}

COMPASS = ["N", "NNO", "NO", "ONO", "O", "OSO", "SO", "SSO",
           "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]


def die(msg):
    print("Fehler: " + msg, file=sys.stderr)
    sys.exit(1)


def http_get(url, headers=None):
    req = urllib.request.Request(url, headers=headers or {"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        die("HTTP %s bei %s" % (e.code, url))
    except urllib.error.URLError as e:
        die("Netzwerkfehler bei %s: %s" % (url, e.reason))


def http_get_soft(url):
    """Wie http_get, aber ohne Abbruch: gibt bei Fehlern None zurueck."""
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except Exception:
        return None


# --- Standort ---------------------------------------------------------------

def parse_location(loc):
    """Gibt (lat, lon, label) zurueck. loc ist 'lat,lon' oder ein Ortsname."""
    s = loc.strip()
    parts = s.split(",")
    if len(parts) == 2:
        try:
            lat = float(parts[0].strip())
            lon = float(parts[1].strip())
            return lat, lon, "%.4f, %.4f" % (lat, lon)
        except ValueError:
            pass
    return geocode(s)


def geocode(name):
    q = urllib.parse.urlencode({
        "q": name, "format": "json", "limit": "1",
        "countrycodes": "at", "accept-language": "de",
    })
    data = http_get(NOMINATIM + "?" + q,
                    headers={"User-Agent": USER_AGENT})
    if not data:
        die("Ort '%s' in Oesterreich nicht gefunden. "
            "Alternativ Koordinaten als 'lat,lon' angeben." % name)
    top = data[0]
    lat, lon = float(top["lat"]), float(top["lon"])
    label = top.get("display_name", name).split(",")[0]
    return lat, lon, label


def check_bbox(lat, lon):
    if not (BBOX[0] <= lat <= BBOX[2] and BBOX[1] <= lon <= BBOX[3]):
        die("Koordinaten %.3f,%.3f liegen ausserhalb des Modellgebiets." % (lat, lon))


# --- Zeit/Format-Helfer -----------------------------------------------------

def to_local(iso):
    """API-Zeitstempel (UTC, '...+00:00') -> aware datetime in Wiener Zeit."""
    dt = datetime.fromisoformat(iso)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(TZ) if TZ else dt


def wind_speed_dir(u, v):
    """u/v-Komponenten (m/s) -> (km/h, Kompassrichtung)."""
    if u is None or v is None:
        return None, None
    spd = math.hypot(u, v) * 3.6
    deg = (270 - math.degrees(math.atan2(v, u))) % 360
    return spd, COMPASS[int((deg + 11.25) % 360 / 22.5)]


# --- TAWES-Stationsmesswerte ------------------------------------------------

def _haversine(lat1, lon1, lat2, lon2):
    """Grosskreis-Distanz in km."""
    r = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = math.radians(lat2 - lat1)
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * r * math.asin(math.sqrt(a))


def load_favorites():
    """Favoriten-Stationen aus ~/.claude/wetter-favorites.json ([] wenn keine)."""
    try:
        with open(FAV_PATH, encoding="utf-8") as f:
            d = json.load(f)
    except FileNotFoundError:
        return []
    except Exception:
        return []
    out = []
    for x in d.get("favorites", []):
        if x.get("id") is not None:
            out.append({"id": str(x["id"]), "name": x.get("name", str(x["id"]))})
    return out


def _fresh(ts):
    """True, wenn Zeitstempel nicht aelter als FRESH_MAX_SEC ist."""
    if not ts:
        return False
    try:
        dt = datetime.fromisoformat(ts)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return (datetime.now(timezone.utc) - dt).total_seconds() <= FRESH_MAX_SEC
    except Exception:
        return True


def _feat_val(par, k):
    p = par.get(k) or {}
    data = p.get("data") or []
    return data[0] if data else None


def station_snapshot(sid, params="TL,RF,TP,FF,FFX,DD,RR,P"):
    """Aktuelle Messwerte EINER Station (eigener Zeitstempel) oder None.

    Einzelabfrage, weil die current-API bei Mehr-Stationen-Requests auf einen
    gemeinsamen Zeitstempel ausrichtet und veraltete Stationen frische auf
    null ziehen wuerden.
    """
    d = http_get_soft("%s?%s" % (STATION_BASE, urllib.parse.urlencode(
        {"station_ids": str(sid), "parameters": params})))
    if not d:
        return None
    ts = (d.get("timestamps") or [None])[0]
    try:
        f = d["features"][0]
        par = f["properties"]["parameters"]
    except (KeyError, IndexError, TypeError):
        return None
    coords = (f.get("geometry") or {}).get("coordinates") or [None, None]
    return {"ts": ts, "lon": coords[0], "lat": coords[1], "par": par}


def station_measurement(lat, lon, favorites):
    """Aktueller Messwert der naechsten Favoritenstation mit frischen Daten.

    Nur Favoriten werden beruecksichtigt; veraltete Werte (aelter als
    FRESH_MAX_SEC) werden uebersprungen. Gibt dict oder None zurueck.
    """
    best = None
    for fav in favorites:
        snap = station_snapshot(fav["id"])
        if not snap or not _fresh(snap["ts"]):
            continue
        par = snap["par"]
        tl = _feat_val(par, "TL")
        if tl is None or snap["lat"] is None or snap["lon"] is None:
            continue
        dist = _haversine(lat, lon, snap["lat"], snap["lon"])
        if best is None or dist < best["_dist"]:
            best = {"station": fav["name"], "station_id": fav["id"],
                    "distanz_km": round(dist, 1), "ts": snap["ts"], "tl": tl,
                    "rf": _feat_val(par, "RF"), "tp": _feat_val(par, "TP"),
                    "ff": _feat_val(par, "FF"), "ffx": _feat_val(par, "FFX"),
                    "dd": _feat_val(par, "DD"), "rr": _feat_val(par, "RR"),
                    "p": _feat_val(par, "P"), "_dist": dist}
    if best:
        best.pop("_dist", None)
    return best


def messwert_header(m):
    """Formatiert den Messwert-Header (zwei Zeilen) oder None."""
    if not m:
        return None
    parts = ["%.1f °C" % m["tl"]]
    if m["rf"] is not None:
        parts.append("rF %.0f%%" % m["rf"])
    if m["tp"] is not None:
        parts.append("Taupunkt %.1f °C" % m["tp"])
    if m["ff"] is not None:
        wdir = COMPASS[int((m["dd"] + 11.25) % 360 / 22.5)] \
            if m["dd"] is not None else ""
        w = "Wind %.0f km/h %s" % (m["ff"] * 3.6, wdir)
        if m["ffx"] is not None and (m["ffx"] - m["ff"]) * 3.6 > 5:
            w += " (Boeen %.0f)" % (m["ffx"] * 3.6)
        parts.append(w.strip())
    if m["rr"] is not None and m["rr"] >= 0.05:
        parts.append("%.1f mm/10min" % m["rr"])
    when = to_local(m["ts"]).strftime("%H:%M") if m["ts"] else "?"
    return ("Aktueller Messwert — %s (%.0f km), Stand %s:\n   %s"
            % (m["station"], m["distanz_km"], when, ", ".join(parts)))


def cloud_word(tcc):
    if tcc is None:
        return "?"
    if tcc < 0.13:
        return "wolkenlos"
    if tcc < 0.35:
        return "heiter"
    if tcc < 0.65:
        return "wolkig"
    if tcc < 0.87:
        return "stark bewoelkt"
    return "bedeckt"


def precip_word(mm_rain, mm_snow):
    """mm_rain/mm_snow pro Intervall -> Beschreibung oder ''."""
    total = (mm_rain or 0) + (mm_snow or 0)
    if total < 0.05:
        return ""
    if (mm_snow or 0) > (mm_rain or 0):
        art = "Schnee"
    elif (mm_snow or 0) > 0.05:
        art = "Schneeregen"
    else:
        art = "Regen"
    if total < 0.5:
        staerke = "leichter"
    elif total < 2.5:
        staerke = "maessiger"
    elif total < 7:
        staerke = "kraeftiger"
    else:
        staerke = "heftiger"
    return "%s %s" % (staerke, art)


def series(feat, name):
    p = feat["properties"]["parameters"].get(name)
    return p["data"] if p else None


def diffs(data):
    """Akkumulierte Reihe -> Werte pro Intervall (Delta, geclampt >= 0)."""
    if data is None:
        return None
    out = []
    prev = 0.0
    for x in data:
        if x is None:
            out.append(None)
            continue
        d = x - prev
        out.append(d if d >= 0 else 0.0)
        prev = x
    return out


# --- Forecast (NWP, stuendlich) ---------------------------------------------

def cmd_forecast(args):
    lat, lon, label = parse_location(args.ort)
    check_bbox(lat, lon)
    params = "t2m,tcc,sy,rr_acc,rain_acc,snow_acc,u10m,v10m,ugust,vgust,snowlmt,rh2m"
    url = "%s/%s?%s" % (FORECAST_BASE, NWP, urllib.parse.urlencode(
        {"lat_lon": "%.5f,%.5f" % (lat, lon), "parameters": params}))
    d = http_get(url)
    ts = d["timestamps"]
    feat = d["features"][0]
    reftime = d.get("reference_time") or d.get("reftime")

    t2m = series(feat, "t2m")
    tcc = series(feat, "tcc")
    sy = series(feat, "sy")
    rh = series(feat, "rh2m")
    rain = diffs(series(feat, "rain_acc"))
    snow = diffs(series(feat, "snow_acc"))
    rr = diffs(series(feat, "rr_acc"))
    u = series(feat, "u10m")
    v = series(feat, "v10m")
    ug = series(feat, "ugust")
    vg = series(feat, "vgust")

    rows = []
    for i, iso in enumerate(ts):
        lt = to_local(iso)
        r = rain[i] if rain else None
        s = snow[i] if snow else None
        # Falls rain/snow fehlen: Gesamtniederschlag als Regen behandeln
        if (r is None and s is None) and rr:
            r = rr[i]
        gust, gdir = wind_speed_dir(ug[i] if ug else None, vg[i] if vg else None)
        wspd, wdir = wind_speed_dir(u[i] if u else None, v[i] if v else None)
        rows.append({
            "time": iso, "local": lt, "day": lt.date().isoformat(),
            "t2m": t2m[i] if t2m else None,
            "tcc": tcc[i] if tcc else None,
            "rh": rh[i] if rh else None,
            "sy": int(sy[i]) if sy and sy[i] is not None else None,
            "rain": r, "snow": s,
            "precip": (r or 0) + (s or 0),
            "wind": wspd, "wdir": wdir or gdir,
            "gust": gust,
        })

    # nur die gewuenschte Anzahl Tage
    days = []
    for r in rows:
        if r["day"] not in days:
            days.append(r["day"])
    days = days[:args.tage]
    rows = [r for r in rows if r["day"] in days]

    # aktueller Messwert der naechsten Favoritenstation (best effort)
    messwert = station_measurement(lat, lon, load_favorites())

    if args.json:
        out = []
        for r in rows:
            rr = dict(r)
            rr["local"] = r["local"].isoformat()
            out.append(rr)
        print(json.dumps({"ort": label, "lat": lat, "lon": lon,
                          "reftime": reftime, "messwert": messwert,
                          "stunden": out},
                         ensure_ascii=False, indent=2))
        return

    print("Vorhersage fuer %s (%.4f, %.4f) — GeoSphere AROME%s\n"
          % (label, lat, lon,
             ", Lauf %s" % _fmt_ref(reftime) if reftime else ""))
    hdr = messwert_header(messwert)
    if hdr:
        print(hdr + "\n")
    wtag = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]
    for day in days:
        drows = [r for r in rows if r["day"] == day]
        temps = [r["t2m"] for r in drows if r["t2m"] is not None]
        psum = sum(r["precip"] for r in drows)
        gmax = max([r["gust"] for r in drows if r["gust"] is not None] or [0])
        dd = drows[0]["local"]
        head = "%s %02d.%02d." % (wtag[dd.weekday()], dd.day, dd.month)
        tmin = "%.0f" % min(temps) if temps else "?"
        tmax = "%.0f" % max(temps) if temps else "?"
        print("%s  %s–%s °C   Niederschlag %.1f mm   Boeen bis %.0f km/h"
              % (head, tmin, tmax, psum, gmax))
        # 3-stuendliche Zeilen
        for r in drows:
            if r["local"].hour % 3 != 0:
                continue
            cond = cloud_word(r["tcc"])
            pw = precip_word(r["rain"], r["snow"])
            if pw:
                cond += ", " + pw
            wind = ""
            if r["wind"] is not None:
                wind = "  Wind %2.0f km/h %s" % (r["wind"], r["wdir"] or "")
            feuchte = "rF %2.0f%%" % r["rh"] if r["rh"] is not None else "      "
            print("   %02dh  %3s°  %s  %-28s%s"
                  % (r["local"].hour,
                     "%.0f" % r["t2m"] if r["t2m"] is not None else "?",
                     feuchte, cond, wind))
        print()


def _fmt_ref(reftime):
    try:
        return to_local(reftime).strftime("%d.%m. %H:%M")
    except Exception:
        return reftime


# --- Nowcast (15-min) -------------------------------------------------------

def cmd_nowcast(args):
    lat, lon, label = parse_location(args.ort)
    check_bbox(lat, lon)
    params = "t2m,rr,ff,fx,dd,rh2m"
    url = "%s/%s?%s" % (FORECAST_BASE, NOWCAST, urllib.parse.urlencode(
        {"lat_lon": "%.5f,%.5f" % (lat, lon), "parameters": params}))
    d = http_get(url)
    ts = d["timestamps"]
    feat = d["features"][0]
    t2m = series(feat, "t2m")
    rr = series(feat, "rr")
    ff = series(feat, "ff")
    fx = series(feat, "fx")
    dd = series(feat, "dd")
    rh = series(feat, "rh2m")

    rows = []
    for i, iso in enumerate(ts):
        lt = to_local(iso)
        direction = None
        if dd and dd[i] is not None:
            direction = COMPASS[int((dd[i] + 11.25) % 360 / 22.5)]
        rows.append({
            "time": iso, "local": lt.isoformat(),
            "t2m": t2m[i] if t2m else None,
            "rr": rr[i] if rr else None,
            "rh": rh[i] if rh else None,
            "ff_kmh": (ff[i] * 3.6) if ff and ff[i] is not None else None,
            "fx_kmh": (fx[i] * 3.6) if fx and fx[i] is not None else None,
            "dir": direction, "_lt": lt,
        })

    # aktueller Messwert der naechsten Favoritenstation (best effort)
    messwert = station_measurement(lat, lon, load_favorites())

    if args.json:
        for r in rows:
            r.pop("_lt", None)
        print(json.dumps({"ort": label, "lat": lat, "lon": lon,
                          "messwert": messwert, "schritte": rows},
                         ensure_ascii=False, indent=2))
        return

    if rows:
        print("Nowcast fuer %s (%.4f, %.4f) — naechste ~3 h, Stand %s\n"
              % (label, lat, lon, rows[0]["_lt"].strftime("%d.%m. %H:%M")))
    hdr = messwert_header(messwert)
    if hdr:
        print(hdr + "\n")
    for r in rows:
        rain = ""
        if r["rr"] and r["rr"] >= 0.05:
            rain = "  Regen %.1f mm/15min" % r["rr"]
        wind = ""
        if r["ff_kmh"] is not None:
            wind = "  Wind %2.0f km/h %s" % (r["ff_kmh"], r["dir"] or "")
            if r["fx_kmh"] and r["fx_kmh"] - r["ff_kmh"] > 5:
                wind += " (Boeen %.0f)" % r["fx_kmh"]
        feuchte = ""
        if r["rh"] is not None:
            feuchte = "  rF %2.0f%%" % r["rh"]
        print("   %s  %4s°%s%s%s"
              % (r["_lt"].strftime("%H:%M"),
                 "%.1f" % r["t2m"] if r["t2m"] is not None else "?",
                 feuchte, wind, rain))


# --- Warnungen --------------------------------------------------------------

def cmd_warnungen(args):
    lat, lon, label = parse_location(args.ort)
    check_bbox(lat, lon)
    url = "%s?%s" % (WARN_BASE, urllib.parse.urlencode(
        {"lat": "%.5f" % lat, "lon": "%.5f" % lon, "lang": "de"}))
    d = http_get(url)
    props = d.get("properties", {})
    loc = props.get("location", {}).get("properties", {})
    gemeinde = loc.get("name", label)
    warnings = props.get("warnings", []) or []

    if args.json:
        print(json.dumps({"ort": label, "gemeinde": gemeinde,
                          "gemeindenr": loc.get("gemeindenr"),
                          "warnungen": warnings},
                         ensure_ascii=False, indent=2))
        return

    print("Wetterwarnungen fuer %s%s\n"
          % (gemeinde,
             " (Gemeinde %s)" % loc["gemeindenr"] if loc.get("gemeindenr") else ""))
    if not warnings:
        print("Keine aktiven Warnungen.")
        return

    for w in warnings:
        p = w.get("properties", w)
        typ = WARN_TYPE.get(p.get("warntypid"), "Warnung")
        stufe = WARN_LEVEL.get(p.get("warnstufeid"), "?")
        print("• %s (%s)" % (typ, stufe))
        beg, end = p.get("begin"), p.get("end")
        if beg or end:
            print("  Zeitraum: %s – %s"
                  % (_fmt_ref(beg) if beg else "?",
                     _fmt_ref(end) if end else "?"))
        for key, lbl in (("text", None), ("auswirkungen", "Auswirkungen"),
                         ("empfehlungen", "Empfehlung"),
                         ("meteotext", "Details")):
            val = (p.get(key) or "").strip()
            if val:
                print("  %s%s" % (lbl + ": " if lbl else "", val))
        print()


# --- Stationen (Favoriten-Auswahl) ------------------------------------------

def cmd_stations(args):
    lat, lon, label = parse_location(args.ort)
    check_bbox(lat, lon)
    meta = http_get_soft(STATION_BASE + "/metadata")
    if not meta:
        die("Stations-Metadaten nicht abrufbar.")
    cand = []
    for s in meta.get("stations", []):
        try:
            slat, slon = float(s["lat"]), float(s["lon"])
        except (KeyError, TypeError, ValueError):
            continue
        cand.append((_haversine(lat, lon, slat, slon),
                     str(s.get("id")), s.get("name", "?")))
    cand.sort(key=lambda x: x[0])
    top = cand[:args.anzahl]
    favids = {f["id"] for f in load_favorites()}

    # aktuelle Werte pro Station einzeln abfragen (eigener Zeitstempel)
    rows = []
    for dist, sid, name in top:
        snap = station_snapshot(sid, "TL,RF")
        tl = rf = ts = None
        if snap:
            ts = snap["ts"]
            tl = _feat_val(snap["par"], "TL")
            rf = _feat_val(snap["par"], "RF")
        rows.append({"id": sid, "name": name, "distanz_km": round(dist, 1),
                     "favorit": sid in favids, "ts": ts,
                     "frisch": bool(tl is not None and _fresh(ts)),
                     "tl": tl, "rf": rf})

    if args.json:
        print(json.dumps({"ort": label, "lat": lat, "lon": lon,
                          "stationen": rows}, ensure_ascii=False, indent=2))
        return

    print("Stationen nahe %s (%.4f, %.4f)\n" % (label, lat, lon))
    for r in rows:
        mark = "*" if r["favorit"] else " "
        if r["tl"] is not None:
            wert = "%.1f °C" % r["tl"]
            if r["rf"] is not None:
                wert += ", rF %.0f%%" % r["rf"]
            if not r["frisch"]:
                wert += " (veraltet, %s)" % (_fmt_ref(r["ts"]) if r["ts"] else "?")
        else:
            wert = "keine aktuellen Daten"
        print(" %s %6.1f km  %-9s %-32s %s"
              % (mark, r["distanz_km"], r["id"], r["name"], wert))
    print("\n* = Favorit. Favoriten-Datei: %s" % FAV_PATH)


def main():
    ap = argparse.ArgumentParser(
        prog="wetter",
        description="GeoSphere Austria: Vorhersage, Nowcast und Warnungen.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    f = sub.add_parser("forecast", help="Stundenvorhersage ~60 h (AROME)")
    f.add_argument("ort", help="Ortsname oder 'lat,lon'")
    f.add_argument("--tage", type=int, default=2, choices=range(1, 4),
                   metavar="1-3", help="Anzahl Tage (1-3, Standard 2)")
    f.add_argument("--json", action="store_true", help="Rohdaten als JSON")
    f.set_defaults(func=cmd_forecast)

    n = sub.add_parser("nowcast", help="Nahzeitvorhersage 15-min, ~3 h")
