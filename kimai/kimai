# ── Feiertage & Werktage ──────────────────────────────────────────────────


def easter(year):
    a = year % 19
    b, c = divmod(year, 100)
    d, e = divmod(b, 4)
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i, k = divmod(c, 4)
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * l) // 451
    month = (h + l - 7 * m + 114) // 31
    day = (h + l - 7 * m + 114) % 31 + 1
    return date(year, month, day)


def at_holidays(year):
    e = easter(year)
    return {
        date(year, 1, 1),
        date(year, 1, 6),
        e + timedelta(days=1),
        date(year, 5, 1),
        e + timedelta(days=39),
        e + timedelta(days=50),
        e + timedelta(days=60),
        date(year, 8, 15),
        date(year, 10, 26),
        date(year, 11, 1),
        date(year, 12, 8),
        date(year, 12, 25),
        date(year, 12, 26),
    }


def working_days(year, month):
    holidays = at_holidays(year)
    days, d = [], date(year, month, 1)
    while d.month == month:
        if d.weekday() < 5 and d not in holidays:
            days.append(d)
        d += timedelta(days=1)
    return days


# ── Stundenverteilung ─────────────────────────────────────────────────────


def to_kimai_hours(actual_h):
    """Konvertiert tatsächliche Stunden in Kimai-Stunden (aufgerundet)."""
    return math.ceil(actual_h * RATE_KH / RATE_KIMAI)


def distribute_hours(total, num_days):
    """Verteilt total Stunden gleichmäßig auf num_days Tage (Rest vorne)."""
    base, extra = divmod(total, num_days)
    return [base + (1 if i < extra else 0) for i in range(num_days)]


def pick_evenly(days, n):
    """Wählt n Tage gleichmäßig über die verfügbare Liste verteilt."""
    if n >= len(days):
        return list(days[:n])
    if n == 1:
        return [days[len(days) // 2]]
    step = (len(days) - 1) / (n - 1)
    return [days[round(i * step)] for i in range(n)]


def assign_days(all_days, needs):
    """Verteilt Tage gleichmäßig über den Monat."""
    result = {}
    available = list(all_days)
    for pk, n in sorted(needs, key=lambda x: -x[1]):
        picked = pick_evenly(available, n)
        result[pk] = picked
        for d in picked:
            available.remove(d)
    return result


def start_hour(index):
    """Abwechselnd 08:00 / 09:00 für realistische Variation."""
    return 8 if index % 2 == 0 else 9


def fmt(n):
    """Österreichisches Zahlenformat: Tausenderpunkt, kein Dezimal."""
    return f"{n:,.0f}".replace(",", ".")


