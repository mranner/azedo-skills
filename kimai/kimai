def _env_has_kimai(path):
    """Check if .env file contains KIMAI_HOST"""
    try:
        with open(path) as f:
            for line in f:
                if line.strip().startswith("KIMAI_HOST"):
                    return True
    except OSError:
        pass
    return False


def _find_env():
    override = os.environ.get("KIMAI_ENV")
    if override:
        return override
    cwd_env = os.path.join(os.getcwd(), ".env")
    if os.path.exists(cwd_env) and _env_has_kimai(cwd_env):
        return cwd_env
    return os.path.join(os.path.expanduser("~"), ".env")

ENV_FILE = _find_env()

_config = None

RATE_KH = 55
RATE_KIMAI = 77
MAX_PER_DAY = 7


def load_env():
    """Read KIMAI_HOST and KIMAI_TOKEN from .env (cached)"""
    global _config
    if _config is not None:
        return _config

    config = {}
    if not os.path.exists(ENV_FILE):
        print(f"Error: {ENV_FILE} not found", file=sys.stderr)
        sys.exit(1)
    with open(ENV_FILE) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                key, val = line.split("=", 1)
                config[key.strip()] = val.strip().strip('"').strip("'")
    for key in ("KIMAI_HOST", "KIMAI_TOKEN"):
        if key not in config:
            print(f"Error: {key} not set in {ENV_FILE}", file=sys.stderr)
            sys.exit(1)

    config["KIMAI_HOST"] = config["KIMAI_HOST"].rstrip("/")
    _config = config
    return _config


def api_call(method, path, data=None, params=None):
    """Make an HTTP request to Kimai API"""
    config = load_env()
    url = f"{config['KIMAI_HOST']}/api/{path.lstrip('/')}"

    if params:
        qs = "&".join(f"{k}={v}" for k, v in params.items() if v is not None)
        if qs:
            url += f"?{qs}"

    body = json.dumps(data).encode("utf-8") if data else None
    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Authorization": f"Bearer {config['KIMAI_TOKEN']}",
            "Content-Type": "application/json",
        },
        method=method,
    )

    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            if not raw:
                return None
            return json.loads(raw.decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")
        print(f"API error {e.code}: {err_body}", file=sys.stderr)
        sys.exit(1)


def output(data):
    """Print result as formatted JSON"""
    print(json.dumps(data, indent=2, ensure_ascii=False))


def parse_kimai_dt(s):
    """Parse a Kimai datetime string into a naive local datetime.

    Kimai returns a timezone suffix (+0200, +02:00, Z); we strip it and work
    in local wall-clock time, matching how log entries are created.
    """
    s = re.sub(r'[+-]\d{2}:?\d{2}$|Z$', '', s)
    return datetime.fromisoformat(s)


