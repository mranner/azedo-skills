def parse_duration(s):
    """Parse duration string into minutes.

    Accepts: 0.5 (decimal hours), 30m, 90m, 1h30m, 2h
    """
    s = s.strip()

    # 1h30m or 2h
    m = re.fullmatch(r'(\d+)h(?:(\d+)m)?', s)
    if m:
        return int(m.group(1)) * 60 + int(m.group(2) or 0)

    # 30m, 90m
    m = re.fullmatch(r'(\d+)m', s)
    if m:
        return int(m.group(1))

    # Decimal hours: 0.5, 1.5, 2
    try:
        return round(float(s) * 60)
    except ValueError:
        print(f"Error: invalid duration '{s}' (use e.g. 0.5, 30m, 1h30m)", file=sys.stderr)
        sys.exit(1)


def load_shortcuts():
    """Read .claude/kimai-shortcuts.json from cwd. Returns dict or {}."""
    path = os.path.join(os.getcwd(), ".claude", "kimai-shortcuts.json")
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        data = json.load(f)

    shortcuts = {}
    for key, val in data.items():
        if isinstance(val, list) and len(val) >= 3:
            shortcuts[key] = {"project": val[0], "activity": val[1], "label": val[2]}
        elif isinstance(val, dict) and "project" in val and "activity" in val:
            shortcuts[key] = val
    return shortcuts


def resolve_shortcut(name):
    """Find a shortcut by case-insensitive partial match on key or label."""
    shortcuts = load_shortcuts()
    if not shortcuts:
        return None

    name_lower = name.lower()

    # Exact key match
    if name_lower in shortcuts:
        return shortcuts[name_lower]

    # Partial match on key or label
    matches = []
    for key, val in shortcuts.items():
        if name_lower in key or name_lower in val.get("label", "").lower():
            matches.append((key, val))

    if len(matches) == 1:
        return matches[0][1]
    if len(matches) > 1:
        print(f"Error: ambiguous shortcut '{name}', matches:", file=sys.stderr)
        for key, val in matches:
            print(f"  {key}: {val.get('label', '')}", file=sys.stderr)
        sys.exit(1)

    return None


def cmd_log(args):
    """One-shot timesheet entry: resolve shortcut, find last entry, create."""

    # Resolve project/activity
    if args.shortcut:
        sc = resolve_shortcut(args.shortcut)
        if not sc:
            print(f"Error: shortcut '{args.shortcut}' not found", file=sys.stderr)
            sys.exit(1)
        project_id = sc["project"]
        activity_id = sc["activity"]
        label = sc.get("label", args.shortcut)
    elif args.project and args.activity:
        project_id = int(args.project)
        activity_id = int(args.activity)
        label = f"project {project_id} / activity {activity_id}"
    else:
        print("Error: provide --shortcut or both --project and --activity", file=sys.stderr)
        sys.exit(1)

    # Parse duration
    minutes = parse_duration(args.duration)

    # Fetch all of today's entries — used both to anchor the new entry and to
    # detect overlaps. timesheets/recent is Kimai's "recently used" list
    # (ordered by edit recency, not chronologically), so recent[0] is NOT
    # reliably the day's latest entry — using it lets new entries march into
    # already-filled slots. Take the maximum end of today's entries instead.
    today = date.today().isoformat()
    entries = api_call("GET", "timesheets", params={
        "begin": f"{today}T00:00:00",
        "end": f"{today}T23:59:59",
        "size": "100",
    }) or []

    # Collect existing (begin, end) spans as naive local datetimes
    spans = []
    for t in entries:
        if not t.get("begin") or not t.get("end"):
            continue
        spans.append((parse_kimai_dt(t["begin"]), parse_kimai_dt(t["end"])))

    # Determine the begin time: explicit --begin wins; otherwise the latest end
    # of today's entries; fallback 08:00 when there are none.
    if getattr(args, "begin", None):
        begin_dt = parse_kimai_dt(args.begin)
    elif spans:
        begin_dt = max(e for _, e in spans)
    else:
        begin_dt = datetime.fromisoformat(f"{today}T08:00:00")

    end_dt = begin_dt + timedelta(minutes=minutes)

    # Overlap guard: never book a slot that collides with an existing today
    # entry (covers the race between parallel Claude sessions too).
    for b, e in spans:
        if begin_dt < e and b < end_dt:
            print(
                f"Error: proposed slot "
                f"{begin_dt.strftime('%H:%M')}–{end_dt.strftime('%H:%M')} "
                f"overlaps existing entry "
                f"{b.strftime('%H:%M')}–{e.strftime('%H:%M')}. "
                f"Aborting — pass --begin to set the start time explicitly.",
                file=sys.stderr,
            )
            sys.exit(1)

    # Create timesheet
    data = {
        "begin": begin_dt.strftime("%Y-%m-%dT%H:%M:%S"),
        "end": end_dt.strftime("%Y-%m-%dT%H:%M:%S"),
        "project": int(project_id),
        "activity": int(activity_id),
    }
    if args.description:
        data["description"] = args.description

    result = api_call("POST", "timesheets", data=data)

    # Compact confirmation
    h = minutes / 60
    output({
        "id": result["id"],
        "label": label,
        "begin": data["begin"],
        "end": data["end"],
        "duration": f"{h:.1f}h" if h != int(h) else f"{int(h)}h",
        "description": args.description or "",
    })


