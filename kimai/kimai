# ── Setup ─────────────────────────────────────────────────────────────────


def cmd_setup(args):
    """Query instance for projects, activities, customers, users and write instance.json"""
    skill_dir = os.path.dirname(os.path.abspath(__file__))
    out_path = os.path.join(skill_dir, "instance.json")

    # Detect role via /users/me
    me = api_call("GET", "users/me")
    roles = me.get("roles", [])
    admin = "ROLE_SUPER_ADMIN" in roles

    projects = api_call("GET", "projects")
    proj_list = []
    for p in projects:
        if not p.get("visible", True):
            continue
        proj_list.append({
            "id": p["id"],
            "name": p["name"],
            "customer": p.get("parentTitle", ""),
        })

    activities = api_call("GET", "activities")
    act_list = []
    for a in activities:
        if not a.get("visible", True):
            continue
        act_list.append({
            "id": a["id"],
            "name": a["name"],
            "project": a.get("project"),
            "parentTitle": a.get("parentTitle", ""),
        })

    customers = api_call("GET", "customers")
    cust_list = []
    for c in customers:
        if not c.get("visible", True):
            continue
        cust_list.append({
            "id": c["id"],
            "name": c["name"],
        })

    # Users: admin gets all, non-admin only self
    if admin:
        users = api_call("GET", "users")
        user_list = []
        for u in users:
            if not u.get("enabled", True):
                continue
            user_list.append({
                "id": u["id"],
                "username": u["username"],
            })
    else:
        user_list = [{"id": me["id"], "username": me["username"]}]

    instance = {
        "is_admin": admin,
        "projects": proj_list,
        "activities": act_list,
        "customers": cust_list,
        "users": user_list,
    }

    with open(out_path, "w") as f:
        json.dump(instance, f, indent=2, ensure_ascii=False)

    print(f"Written to {out_path}")
    output(instance)


# ── Import Hours (replaces kimai_stunden.py) ──────────────────────────────


def cmd_import_hours(args):
    """Import external hours from JSON file"""

    PROJEKTE = {
        "myglobex": {"id": 107, "activity_id": 230, "name": "myglobex Entwicklung"},
        "myacme": {"id": 108, "activity_id": 239, "name": "myacme Entwicklung (BBT)"},
    }
    USER_ID = 9  # khpongratz

    with open(args.file, encoding="utf-8") as f:
        data = json.load(f)

    year, month = map(int, data["monat"].split("-"))
    wdays = working_days(year, month)

    # Einträge aufbereiten
    proj_kimai = {pk: 0 for pk in PROJEKTE}
    proj_actual = {pk: 0.0 for pk in PROJEKTE}
    proj_descs = {pk: [] for pk in PROJEKTE}

    for e in data["eintraege"]:
        proj = e["projekt"].lower()
        h = e["stunden"]
        desc = e["beschreibung"]
        if proj == "beide":
            half = h / 2
            for pk in PROJEKTE:
                proj_actual[pk] += half
                proj_kimai[pk] += to_kimai_hours(half)
                proj_descs[pk].append(desc)
        elif proj in PROJEKTE:
            proj_actual[proj] += h
            proj_kimai[proj] += to_kimai_hours(h)
            proj_descs[proj].append(desc)
        else:
            sys.exit(f"Unbekanntes Projekt: {proj!r}  (erlaubt: {', '.join(PROJEKTE)}, beide)")

    active = {pk: h for pk, h in proj_kimai.items() if h > 0}

    # Tage je Projekt
    needs = [(pk, math.ceil(h / MAX_PER_DAY)) for pk, h in active.items()]
    total_days_needed = sum(n for _, n in needs)
    if total_days_needed > len(wdays):
