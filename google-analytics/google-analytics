#!/usr/bin/env python3

# Google Analytics 4 REST API helper
# stdlib only, no pip dependencies
# version 1.39.2

import argparse
import json
import os
import sys
import time
import urllib.parse
import urllib.request
import urllib.error

_token_cache = {}
_sa_config = None

# OAuth-Scopes. Lesende Aufrufe bleiben auf readonly; nur die schreibenden
# Admin-Operationen (Custom Dimensions, Datenaufbewahrung) fordern edit an.
SCOPE_READONLY = "https://www.googleapis.com/auth/analytics.readonly"
SCOPE_EDIT = "https://www.googleapis.com/auth/analytics.edit"

ADMIN_BASE = "https://analyticsadmin.googleapis.com/v1beta"

def cryptography_hint():
    # Der Weg zum Paket ist je Plattform ein anderer; ein pauschales
    # "pip install --user" scheitert auf FreeBSD am Port und bei
    # Homebrew-Python an der externally-managed-Sperre (PEP 668).

    version = "py%d%d" % (sys.version_info.major, sys.version_info.minor)

    if sys.platform.startswith("freebsd"):
        return "  pkg install %s-cryptography" % version

    if sys.platform == "darwin":
        return ("  python3 -m pip install --user cryptography\n"
                "  Bricht das mit 'externally-managed-environment' ab (Homebrew-Python),\n"
                "  ein venv anlegen und das Script daraus aufrufen:\n"
                "    python3 -m venv ~/.claude/venv ; ~/.claude/venv/bin/pip install cryptography")

    return "  python3 -m pip install --user cryptography"


def _find_sa_file():
    """Find service account JSON file"""
    # Ein gesetzter, aber ins Leere zeigender Override bricht hier ab, statt still auf
    # den Default-Pfad auszuweichen: sonst maskiert der Fallback einen Tippfehler in
    # der Variablen und der Aufruf laeuft gegen die falsche Property-Sammlung.
    override = os.environ.get("GA4_SERVICE_ACCOUNT")
    if override:
        if not os.path.exists(override):
            print(f"Error: GA4_SERVICE_ACCOUNT verweist auf {override} — Datei nicht vorhanden.",
                  file=sys.stderr)
            sys.exit(1)
        return override
    default = os.path.join(os.path.expanduser("~"), ".config", "ga4-service-account.json")
    if os.path.exists(default):
        return default
    return None


def _load_sa():
    """Load service account config (cached)"""
    global _sa_config
    if _sa_config is not None:
        return _sa_config

    path = _find_sa_file()
    if not path:
        print("Error: Service account JSON not found.", file=sys.stderr)
        print("Set GA4_SERVICE_ACCOUNT or place file at ~/.config/ga4-service-account.json", file=sys.stderr)
        sys.exit(1)
    with open(path) as f:
        _sa_config = json.load(f)
    return _sa_config


def _b64url(data):
    """Base64url encode bytes"""
    import base64
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")


def _get_access_token(scope=SCOPE_READONLY):
    """Get OAuth2 access token via service account JWT (cached per scope)"""
    global _token_cache
    now = int(time.time())

    cached = _token_cache.get(scope)
    if cached and cached["exp"] > now + 60:
        return cached["token"]

    sa = _load_sa()

    # Build JWT
    header = _b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    payload = _b64url(json.dumps({
        "iss": sa["client_email"],
        "scope": scope,
        "aud": sa["token_uri"],
        "iat": now,
        "exp": now + 3600,
    }).encode())

    signing_input = f"{header}.{payload}".encode()

    # Sign with RSA key
    from hashlib import sha256
    try:
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import padding
        private_key = serialization.load_pem_private_key(sa["private_key"].encode(), password=None)
        signature = private_key.sign(signing_input, padding.PKCS1v15(), hashes.SHA256())
    except ImportError:
        print("Fehlt: python-Modul 'cryptography' (RSA-Signatur fuer den JWT).\n"
              + cryptography_hint(), file=sys.stderr)
        sys.exit(1)

    jwt = f"{header}.{payload}.{_b64url(signature)}"

    # Exchange JWT for access token
    data = urllib.parse.urlencode({
        "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
        "assertion": jwt,
    }).encode()

    req = urllib.request.Request(sa["token_uri"], data=data, method="POST")
    req.add_header("Content-Type", "application/x-www-form-urlencoded")

    try:
        with urllib.request.urlopen(req) as resp:
            result = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body = e.read().decode()
        print(f"Error getting access token: {e.code} {body}", file=sys.stderr)
        sys.exit(1)

    _token_cache[scope] = {"token": result["access_token"], "exp": now + result.get("expires_in", 3600)}
    return _token_cache[scope]["token"]


def api_call(method, url, data=None, scope=SCOPE_READONLY):
    """Make authenticated HTTP request to Google API"""
    token = _get_access_token(scope)
    body = json.dumps(data).encode() if data else None
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Content-Type", "application/json")

    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body = e.read().decode()
        print(f"Error: {e.code} {body}", file=sys.stderr)
        sys.exit(1)


# --- Subcommands ---

def cmd_setup(args):
    """Test connection and list accessible accounts/properties"""
    token = _get_access_token()
    print("Auth OK\n")

    # List accounts
    result = api_call("GET", "https://analyticsadmin.googleapis.com/v1beta/accounts")
    accounts = result.get("accounts", [])

    if not accounts:
        print("Keine Accounts gefunden. Service Account als Betrachter in GA4 hinzufuegen.")
        return

    instance = {"accounts": [], "properties": []}

    for acc in accounts:
        acc_id = acc["name"].split("/")[-1]
        acc_name = acc.get("displayName", "")
        print(f"Account: {acc_name} ({acc_id})")
        instance["accounts"].append({"id": acc_id, "name": acc_name})

        # List properties for this account
        props_result = api_call("GET",
            f"https://analyticsadmin.googleapis.com/v1beta/properties?filter=parent:accounts/{acc_id}")
        props = props_result.get("properties", [])

        for prop in props:
            prop_id = prop["name"].split("/")[-1]
            prop_name = prop.get("displayName", "")
            print(f"  Property: {prop_name} ({prop_id})")
            instance["properties"].append({
                "id": prop_id,
                "name": prop_name,
                "account_id": acc_id,
                "account_name": acc_name,
            })

    # Save instance.json
    skill_dir = os.path.dirname(os.path.abspath(__file__))
    instance_path = os.path.join(skill_dir, "instance.json")
    with open(instance_path, "w") as f:
        json.dump(instance, f, indent=2, ensure_ascii=False)
    print(f"\ninstance.json geschrieben ({len(instance['properties'])} Properties)")


def cmd_accounts(args):
    """List accounts"""
    result = api_call("GET", "https://analyticsadmin.googleapis.com/v1beta/accounts")
    for acc in result.get("accounts", []):
        acc_id = acc["name"].split("/")[-1]
        print(f"{acc_id}\t{acc.get('displayName', '')}")


def cmd_properties(args):
    """List properties for an account"""
    filt = f"parent:accounts/{args.account}" if args.account else ""
    url = f"https://analyticsadmin.googleapis.com/v1beta/properties?filter={filt}&pageSize=200"
    result = api_call("GET", url)
    for prop in result.get("properties", []):
        prop_id = prop["name"].split("/")[-1]
        print(f"{prop_id}\t{prop.get('displayName', '')}")


def cmd_report(args):
    """Run a GA4 report"""
    url = f"https://analyticsdata.googleapis.com/v1beta/properties/{args.property}:runReport"

    body = {
        "dateRanges": [{"startDate": args.start, "endDate": args.end}],
        "dimensions": [{"name": d} for d in args.dimensions.split(",")],
        "metrics": [{"name": m} for m in args.metrics.split(",")],
    }

    if args.limit:
        body["limit"] = args.limit

    if args.order_by:
        desc = True
        field = args.order_by
        if field.startswith("+"):
            desc = False
            field = field[1:]
        elif field.startswith("-"):
            field = field[1:]

        order = {"desc": desc}
        if field in args.metrics.split(","):
            order["metric"] = {"metricName": field}
        else:
            order["dimension"] = {"dimensionName": field}
        body["orderBys"] = [order]

    if args.filter:
        # Simple filter: dimension==value
        parts = args.filter.split("==", 1)
        if len(parts) == 2:
            body["dimensionFilter"] = {
                "filter": {
                    "fieldName": parts[0],
                    "stringFilter": {"value": parts[1]}
                }
            }

    result = api_call("POST", url, body)

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return

    # Header
    dims = [h.get("name", "") for h in result.get("dimensionHeaders", [])]
    mets = [h.get("name", "") for h in result.get("metricHeaders", [])]
    print("\t".join(dims + mets))

    # Rows
    for row in result.get("rows", []):
        dim_vals = [v.get("value", "") for v in row.get("dimensionValues", [])]
        met_vals = [v.get("value", "") for v in row.get("metricValues", [])]
        print("\t".join(dim_vals + met_vals))

    total = result.get("rowCount", 0)
    if total and args.limit and total > args.limit:
        print(f"\n({args.limit} von {total} Zeilen)", file=sys.stderr)


def cmd_realtime(args):
    """Run a GA4 realtime report"""
    url = f"https://analyticsdata.googleapis.com/v1beta/properties/{args.property}:runRealtimeReport"

    dims = args.dimensions.split(",") if args.dimensions else ["country"]
    mets = args.metrics.split(",") if args.metrics else ["activeUsers"]

    body = {
        "dimensions": [{"name": d} for d in dims],
        "metrics": [{"name": m} for m in mets],
    }

    if args.limit:
        body["limit"] = args.limit

    result = api_call("POST", url, body)

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return

    # Header
    dim_headers = [h.get("name", "") for h in result.get("dimensionHeaders", [])]
    met_headers = [h.get("name", "") for h in result.get("metricHeaders", [])]
    print("\t".join(dim_headers + met_headers))

    for row in result.get("rows", []):
        dim_vals = [v.get("value", "") for v in row.get("dimensionValues", [])]
        met_vals = [v.get("value", "") for v in row.get("metricValues", [])]
        print("\t".join(dim_vals + met_vals))


def cmd_metadata(args):
    """List available dimensions and metrics for a property"""
    url = f"https://analyticsdata.googleapis.com/v1beta/properties/{args.property}/metadata"
    result = api_call("GET", url)

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return

    if not args.type or args.type == "dimensions":
        print("=== Dimensions ===")
        for d in result.get("dimensions", []):
            name = d.get("apiName", "")
            desc = d.get("uiName", "")
            if args.search and args.search.lower() not in name.lower() and args.search.lower() not in desc.lower():
                continue
            print(f"{name}\t{desc}")

    if not args.type or args.type == "metrics":
        print("\n=== Metrics ===")
        for m in result.get("metrics", []):
            name = m.get("apiName", "")
            desc = m.get("uiName", "")
            if args.search and args.search.lower() not in name.lower() and args.search.lower() not in desc.lower():
                continue
            print(f"{name}\t{desc}")


def _fetch_custom_dimensions(property_id):
    """Alle Custom Dimensions einer Property holen (paginiert)"""
    dims = []
    page_token = None
    while True:
        url = f"{ADMIN_BASE}/properties/{property_id}/customDimensions?pageSize=200"
        if page_token:
            url += f"&pageToken={urllib.parse.quote(page_token)}"
        result = api_call("GET", url)
        dims.extend(result.get("customDimensions", []))
        page_token = result.get("nextPageToken")
        if not page_token:
            break
    return dims


def cmd_list_custom_dimensions(args):
    """List custom dimensions of a property"""
    dims = _fetch_custom_dimensions(args.property)

    if args.json:
        print(json.dumps(dims, indent=2, ensure_ascii=False))
        return

    if not dims:
        print("(keine Custom Dimensions registriert)")
        return

    print("parameterName\tscope\tdisplayName")
    for d in dims:
        print(f"{d.get('parameterName', '')}\t{d.get('scope', '')}\t{d.get('displayName', '')}")


# GA4 erlaubt im displayName nur Buchstaben, Ziffern, Unterstrich und Leerzeichen.
# Geprueft wird auf bekannt-ungueltige Zeichen, nicht gegen eine ASCII-Whitelist:
# Umlaute zaehlen fuer isalnum() als Buchstaben und werden durchgelassen, damit die
# Pruefung nichts ablehnt, was die API womoeglich akzeptiert. Der praktisch relevante
# Fall ist ohnehin der Bindestrich — im Deutschen die naheliegende Schreibweise.
def _invalid_display_name_chars(name):
    return sorted({c for c in name if not (c.isalnum() or c in "_ ")})


def cmd_create_custom_dimension(args):
    """Create a custom dimension (needs Editor role on the property)"""
    # Zeichenpruefung vor dem Duplikat-GET: ein ungueltiger Anzeigename scheitert so
    # ohne API-Aufruf, mit einem Hinweis statt einem 400 INVALID_ARGUMENT.
    display_name = args.display_name or args.parameter
    bad = _invalid_display_name_chars(display_name)
    if bad:
        print(f"Ungueltiger --display-name: {display_name!r}", file=sys.stderr)
        print(f"Nicht erlaubte Zeichen: {' '.join(bad)}", file=sys.stderr)
        print("GA4 erlaubt nur Buchstaben, Ziffern, Unterstrich und Leerzeichen "
              "(z.B. \"Klick Ziel\" statt \"Klick-Ziel\").", file=sys.stderr)
        sys.exit(1)

    # Duplikatschutz: GA4 quittiert doppelte Parameternamen mit einem Fehler, und
    # ein Abbruch mitten in einer Schleife ueber mehrere Dimensionen ist teurer als
    # die eine zusaetzliche GET-Abfrage.
    for d in _fetch_custom_dimensions(args.property):
        if d.get("parameterName") == args.parameter and d.get("scope") == args.scope:
            print(f"Bereits vorhanden: {args.parameter} ({d.get('displayName', '')}) — nichts geaendert")
            return

    body = {
        "parameterName": args.parameter,
        "displayName": display_name,
        "scope": args.scope,
    }
    if args.description:
        body["description"] = args.description

    url = f"{ADMIN_BASE}/properties/{args.property}/customDimensions"
    result = api_call("POST", url, body, scope=SCOPE_EDIT)
    print(f"Angelegt: {result.get('parameterName')}\t{result.get('scope')}\t{result.get('displayName')}")


# GA4-Aufbewahrungsstufen; 26/38/50 Monate nur mit Analytics 360.
RETENTION_MONTHS = {
    "2": "TWO_MONTHS",
    "14": "FOURTEEN_MONTHS",
    "26": "TWENTY_SIX_MONTHS",
    "38": "THIRTY_EIGHT_MONTHS",
    "50": "FIFTY_MONTHS",
}


def cmd_data_retention(args):
    """Show or set event data retention of a property"""
    url = f"{ADMIN_BASE}/properties/{args.property}/dataRetentionSettings"

    if args.set:
        body = {"eventDataRetention": RETENTION_MONTHS[args.set]}
        result = api_call("PATCH", f"{url}?updateMask=eventDataRetention", body, scope=SCOPE_EDIT)
    else:
        result = api_call("GET", url)

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return

    print(f"eventDataRetention\t{result.get('eventDataRetention', '')}")
    print(f"resetUserDataOnNewActivity\t{result.get('resetUserDataOnNewActivity', '')}")


def cmd_version(args):
    print("google-analytics 1.39.2")


def main():
    parser = argparse.ArgumentParser(description="Google Analytics 4 API")
    sub = parser.add_subparsers(dest="command")

    # setup
    sub.add_parser("setup", help="Test auth, list accounts/properties, write instance.json")

    # version
    sub.add_parser("version", help="Show version")

    # accounts
    sub.add_parser("accounts", help="List accessible accounts")

    # properties
    p_props = sub.add_parser("properties", help="List properties")
    p_props.add_argument("--account", help="Account ID filter")

    # report
    p_report = sub.add_parser("report", help="Run a GA4 report")
    p_report.add_argument("--property", "-p", required=True, help="Property ID (e.g. 123123123)")
    p_report.add_argument("--dimensions", "-d", default="date", help="Comma-separated dimensions (default: date)")
    p_report.add_argument("--metrics", "-m", default="sessions,totalUsers,screenPageViews",
                          help="Comma-separated metrics (default: sessions,totalUsers,screenPageViews)")
    p_report.add_argument("--start", "-s", default="7daysAgo", help="Start date (default: 7daysAgo)")
    p_report.add_argument("--end", "-e", default="today", help="End date (default: today)")
    p_report.add_argument("--limit", "-l", type=int, help="Max rows")
    p_report.add_argument("--order-by", "-o", help="Order by field (prefix - for desc, + for asc)")
    p_report.add_argument("--filter", "-f", help="Simple filter: dimension==value")
    p_report.add_argument("--json", action="store_true", help="Raw JSON output")

    # realtime
    p_rt = sub.add_parser("realtime", help="Realtime report")
    p_rt.add_argument("--property", "-p", required=True, help="Property ID")
    p_rt.add_argument("--dimensions", "-d", help="Comma-separated dimensions (default: country)")
    p_rt.add_argument("--metrics", "-m", help="Comma-separated metrics (default: activeUsers)")
    p_rt.add_argument("--limit", "-l", type=int, help="Max rows")
    p_rt.add_argument("--json", action="store_true", help="Raw JSON output")

    # metadata
    p_meta = sub.add_parser("metadata", help="List available dimensions/metrics")
    p_meta.add_argument("--property", "-p", required=True, help="Property ID")
    p_meta.add_argument("--type", "-t", choices=["dimensions", "metrics"], help="Filter type")
    p_meta.add_argument("--search", "-s", help="Search filter")
    p_meta.add_argument("--json", action="store_true", help="Raw JSON output")

    # custom dimensions
    p_lcd = sub.add_parser("list-custom-dimensions", help="List custom dimensions of a property")
    p_lcd.add_argument("--property", "-p", required=True, help="Property ID")
    p_lcd.add_argument("--json", action="store_true", help="Raw JSON output")

    p_ccd = sub.add_parser("create-custom-dimension", help="Create a custom dimension (needs Editor role)")
    p_ccd.add_argument("--property", "-p", required=True, help="Property ID")
    p_ccd.add_argument("--parameter", required=True, help="Event parameter name, e.g. target_url")
    p_ccd.add_argument("--display-name",
                       help="UI name, letters/digits/underscore/space only (default: parameter name)")
    p_ccd.add_argument("--description", help="Optional description")
    p_ccd.add_argument("--scope", default="EVENT", choices=["EVENT", "USER", "ITEM"],
                       help="Dimension scope (default: EVENT)")

    # data retention
    p_dr = sub.add_parser("data-retention", help="Show or set event data retention")
    p_dr.add_argument("--property", "-p", required=True, help="Property ID")
    p_dr.add_argument("--set", choices=sorted(RETENTION_MONTHS, key=int),
                      help="Set retention in months (26/38/50 require Analytics 360)")
    p_dr.add_argument("--json", action="store_true", help="Raw JSON output")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    cmds = {
        "setup": cmd_setup,
        "version": cmd_version,
        "accounts": cmd_accounts,
        "properties": cmd_properties,
        "report": cmd_report,
        "realtime": cmd_realtime,
        "metadata": cmd_metadata,
        "list-custom-dimensions": cmd_list_custom_dimensions,
        "create-custom-dimension": cmd_create_custom_dimension,
        "data-retention": cmd_data_retention,
    }
    cmds[args.command](args)


if __name__ == "__main__":
    main()
