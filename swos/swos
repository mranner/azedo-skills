def fmt_temp(v):
    return f"{v} °C" if isinstance(v, int) else "-"


def print_sys(rep):
    s = rep["sys"]
    print(f"# {rep['name']}  ({rep['mode']}, {s['dialect']})")
    print(f"  Modell    : {s['model'] or '?'}")
    print(f"  Identity  : {s['identity'] or '?'}")
    print(f"  Version   : {s['version'] or '?'}")
    print(f"  MAC       : {s['mac'] or '?'}")
    print(f"  Serial    : {s['serial'] or '?'}")
    print(f"  IP aktuell: {s['ip_current'] or '?'}")
    print(f"  IP statisch: {s['ip_static'] or '?'}")
    if s["temp_c"] is not None:
        print(f"  Temp      : {fmt_temp(s['temp_c'])}")


def print_vlans(rep, portnames):
    vlans = rep["vlans"]
    if not vlans:
        print("  (keine VLANs)")
        return
    for v in vlans:
        name = v["name"] or f"VLAN {v['vid']}"
        members = ", ".join(portnames[i] for i in v["members"]
                            if i < len(portnames))
        print(f"  VLAN {v['vid']:>4}  {name:<22} {members}")


def print_ports(rep):
    for p in rep["ports"]:
        vid = p["pvid"]
        vn = p["pvid_name"] or (f"VLAN {vid}" if vid is not None else "-")
        spd = f"  {p['speed']}" if p.get("speed") else ""
        poe = f"  PoE: {p['poe']}" if p["poe"] else ""
        # Runtime-Status nur zeigen, wenn aussagekraeftig (nicht leer/'disabled').
        st = p.get("poe_status")
        poe += f" ({st})" if (poe and st and st != "disabled") else ""
        vids = f"{vid:>4}" if vid is not None else "   -"
        print(f"  {p['port']:<10} PVID {vids}  ({vn}){spd}{poe}")


def print_fdb(rep):
    if not rep["fdb"]:
        print("  (FDB leer / im Backup nicht enthalten)")
        return
    for e in rep["fdb"]:
        vid = f"  VLAN {e['vid']}" if e["vid"] is not None else ""
        print(f"  {e['mac']}  ->  {e['port']}{vid}")


