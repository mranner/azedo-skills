    wf = _wf(target, "link.b")
    spdf, lnkf, anf = wf["speed"], wf["link"], wf["autoneg"]
    enum = _speed_enum(target._dialect)
    names = {v: k for k, v in enum.items()}
    nports = len(post[wf["names"]])
    sfp = SFP_PORTS.get(target._dialect, 2)
    if not (1 <= args.port <= nports):
        raise SystemExit(f"speed: Port {args.port} ungueltig (1..{nports}; "
                         f"die letzten {sfp} sind SFP/SFP+).")
