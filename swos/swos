# ---------------------------------------------------------------------------
# SwOS-Blob-Parser (die Blobs sind KEIN valides JSON: unquoted Keys, Hex-Ints,
# Single-Quote-Hex-Strings). Recursive-descent statt Regex-pro-Key.
# ---------------------------------------------------------------------------

class BlobError(Exception):
    pass


class _Blob:
    def __init__(self, s):
        self.s = s
        self.i = 0
        self.n = len(s)

    def parse(self):
        v = self._value()
        return v

    def _ws(self):
        while self.i < self.n and self.s[self.i] in " \t\r\n":
            self.i += 1

    def _value(self):
        self._ws()
        if self.i >= self.n:
            raise BlobError("unexpected end")
        c = self.s[self.i]
        if c == "{":
            return self._object()
        if c == "[":
            return self._array()
        if c == "'":
            return self._qstring()
        return self._number()

    def _object(self):
        obj = {}
        self.i += 1                       # {
        self._ws()
        if self.i < self.n and self.s[self.i] == "}":
            self.i += 1
            return obj
        while True:
            self._ws()
            key = self._key()
            self._ws()
            if self.i >= self.n or self.s[self.i] != ":":
                raise BlobError("expected ':' after key %r" % key)
            self.i += 1                   # :
            obj[key] = self._value()
            self._ws()
            if self.i >= self.n:
                raise BlobError("unterminated object")
            if self.s[self.i] == ",":
                self.i += 1
                continue
            if self.s[self.i] == "}":
                self.i += 1
                break
            raise BlobError("expected ',' or '}' at %d" % self.i)
        return obj

    def _array(self):
        arr = []
        self.i += 1                       # [
        self._ws()
        if self.i < self.n and self.s[self.i] == "]":
            self.i += 1
            return arr
        while True:
            arr.append(self._value())
            self._ws()
            if self.i >= self.n:
                raise BlobError("unterminated array")
            if self.s[self.i] == ",":
                self.i += 1
                continue
            if self.s[self.i] == "]":
                self.i += 1
                break
            raise BlobError("expected ',' or ']' at %d" % self.i)
        return arr

    def _key(self):
        start = self.i
        while self.i < self.n and (self.s[self.i].isalnum() or self.s[self.i] == "_"):
            self.i += 1
        if self.i == start:
            raise BlobError("empty key at %d" % self.i)
        return self.s[start:self.i]

    def _qstring(self):
        self.i += 1                       # opening '
        start = self.i
        while self.i < self.n and self.s[self.i] != "'":
            self.i += 1
        val = self.s[start:self.i]
        self.i += 1                       # closing '
        # Quoted values are hex-encoded; keep the raw hex, decode per field.
        return val

    def _number(self):
        start = self.i
        while self.i < self.n and self.s[self.i] not in ",]}":
            self.i += 1
        tok = self.s[start:self.i].strip()
        if tok.startswith(("0x", "0X")):
            return int(tok, 16)
        try:
            return int(tok)
        except ValueError:
            return tok


def parse_blob(s):
    s = s.strip()
    if not s or s[0] not in "{[":
        return None
    return _Blob(s).parse()


# ---------------------------------------------------------------------------
# Decode-Helfer
# ---------------------------------------------------------------------------

def hexascii(h):
    if h is None:
        return None
    try:
        return bytes.fromhex(h).decode("utf-8", errors="replace").rstrip("\x00")
    except (ValueError, TypeError):
        return h


def mac_fmt(h):
    if not h or len(h) < 12:
        return h
    return ":".join(h[i:i + 2] for i in range(0, 12, 2))


def le_ip(val):
    if not isinstance(val, int):
        return None
    return ".".join(str((val >> (8 * i)) & 0xFF) for i in range(4))


def bits_to_ports(mask, total):
    return [i for i in range(total) if (mask >> i) & 1]


