def _vlan_ports(target, spec, what):
    """Komma-Portliste parsen und gegen die Portzahl (aus link.b) validieren.
    Gibt (set_of_ports, nports) zurueck."""
    linkb = target.get("link.b")
    if not isinstance(linkb, dict):
        raise SystemExit(f"[{target.name}] link.b nicht lesbar (fuer Portzahl noetig)")
    nports = len(linkb[_wf(target, "link.b")["names"]])
    try:
        ports = [int(x) for x in (spec or "").split(",") if x.strip() != ""]
    except ValueError:
        raise SystemExit(f"vlan-set: {what} = Komma-Liste von Portnummern (z.B. 1,2,9).")
    for p in ports:
        if not (1 <= p <= nports):
            raise SystemExit(f"vlan-set: Port {p} ungueltig (1..{nports}; die letzten "
                             "sind SFP/SFP+).")
    return set(ports), nports


