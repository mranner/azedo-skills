# Fallback-Portnamen je Modellfamilie, wenn link.b keine Namen liefert.
DEFAULT_PORTNAMES = {
    "css326": [f"ether{i}" for i in range(1, 25)] + ["SFP1", "SFP2"],
    "css610_new": [f"ether{i}" for i in range(1, 9)] + ["SFP+1", "SFP+2"],
    "css610_old": [f"ether{i}" for i in range(1, 9)] + ["SFP+1", "SFP+2"],
    "swos_lite": [f"Port{i}" for i in range(1, 6)] + ["SFP"],
}


def _first(sysobj, spec):
    """spec = str (ein Key) oder tuple (Keys der Reihe nach)."""
    if spec is None:
        return None
    if isinstance(spec, str):
        return sysobj.get(spec)
    for k in spec:
        if k in sysobj:
            return sysobj[k]
    return None


# ---------------------------------------------------------------------------
# Transporte — liefern den geparsten Blob eines Endpoints (oder None)
# ---------------------------------------------------------------------------

READ_ENDPOINTS = ["sys.b", "link.b", "vlan.b", "fwd.b", "poe.b", "!dhost.b"]


class Target:
    """Zugriffsobjekt: entweder live (direct/ssh-curl) oder offline (swb)."""

    def __init__(self, name, mode, ip=None, user="admin", password="",
                 jump=None, swb_data=None, timeout=8):
        self.name = name
        self.mode = mode
        self.ip = ip
        self.user = user
        self.password = password
        self.jump = jump
        self.swb_data = swb_data or {}
        self.timeout = timeout
        self._cache = {}

    def get(self, endpoint):
        if endpoint in self._cache:
            return self._cache[endpoint]
        if self.mode == "swb":
            val = self.swb_data.get(endpoint)
        elif self.mode == "direct":
            val = self._fetch_direct(endpoint)
        elif self.mode == "ssh-curl":
            val = self._fetch_sshcurl(endpoint)
        else:
            raise SystemExit(f"unknown mode: {self.mode}")
        self._cache[endpoint] = val
        return val

    def _fetch_direct(self, endpoint):
        url = f"http://{self.ip}/{endpoint}"
        mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
        mgr.add_password(None, f"http://{self.ip}/", self.user, self.password)
        opener = urllib.request.build_opener(
            urllib.request.HTTPDigestAuthHandler(mgr))
        try:
            with opener.open(url, timeout=self.timeout) as resp:
                body = resp.read().decode("latin-1", errors="replace")
        except (urllib.error.URLError, OSError) as exc:
            raise SystemExit(f"[{self.name}] direct {endpoint}: {exc}")
        return parse_blob(body)                # None bei 303/HTML

    def _fetch_sshcurl(self, endpoint):
        # Passwort kann '$' enthalten -> auf dem Jump als Script an `sh` pipen,
        # Passwort/URL dort single-quoten (kein !-Escaping noetig).
        pw = self.password.replace("'", "'\\''")
        url = f"http://{self.ip}/{endpoint}"
        script = (f"curl -s -m {self.timeout} --digest "
                  f"-u 'admin:{pw}' '{url}'\n")
        cmd = ["sudo", "ssh", "-C", f"root@{self.jump}", "sh"]
        try:
            proc = subprocess.run(cmd, input=script, capture_output=True,
                                  text=True, timeout=self.timeout + 15)
        except subprocess.TimeoutExpired:
            raise SystemExit(f"[{self.name}] ssh-curl {endpoint}: timeout")
        if proc.returncode != 0:
            raise SystemExit(f"[{self.name}] ssh-curl {endpoint}: "
                             f"{proc.stderr.strip() or 'exit ' + str(proc.returncode)}")
        return parse_blob(proc.stdout)

    def fetch_backup_bytes(self):
        """GET /backup.swb roh (keine Blob-Parse -- Inhalt ist selbst ein
        .swb-Container mehrerer Endpoints). Reines Lesen, kein Schreibzugriff
        auf den Switch."""
        if self.mode == "swb":
            raise SystemExit(f"[{self.name}] backup: --swb ist bereits ein "
                             "Backup, kein Live-Ziel")
        if self.mode == "direct":
            url = f"http://{self.ip}/backup.swb"
            mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
            mgr.add_password(None, f"http://{self.ip}/", self.user, self.password)
            opener = urllib.request.build_opener(
                urllib.request.HTTPDigestAuthHandler(mgr))
            try:
                with opener.open(url, timeout=self.timeout) as resp:
                    return resp.read()
            except (urllib.error.URLError, OSError) as exc:
                raise SystemExit(f"[{self.name}] backup: {exc}")
        if self.mode == "ssh-curl":
            pw = self.password.replace("'", "'\\''")
            url = f"http://{self.ip}/backup.swb"
            script = (f"curl -s -m {self.timeout} --digest "
                      f"-u 'admin:{pw}' '{url}'\n")
            cmd = ["sudo", "ssh", "-C", f"root@{self.jump}", "sh"]
            try:
                proc = subprocess.run(cmd, input=script.encode(),
                                      capture_output=True,
                                      timeout=self.timeout + 15)
            except subprocess.TimeoutExpired:
                raise SystemExit(f"[{self.name}] backup: timeout")
            if proc.returncode != 0:
                raise SystemExit(f"[{self.name}] backup: "
                                 f"{proc.stderr.decode(errors='replace').strip() or 'exit ' + str(proc.returncode)}")
            return proc.stdout
        raise SystemExit(f"unknown mode: {self.mode}")


# .swb-Backup: strings, dann jeden `<ep>:` Blob extrahieren
_EP_RE = re.compile(r"(![a-z]+\.b|[a-z]+\.b):")


def read_swb(path):
    try:
        out = subprocess.run(["strings", path], capture_output=True,
                             text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        raise SystemExit(f"strings {path}: {exc}")
    data = {}
    for m in _EP_RE.finditer(out):
        ep = m.group(1)
        start = m.end()
        # ab hier steht der Blob ({...} oder [...]); tolerant parsen
        try:
            val = _Blob(out[start:]).parse()
        except BlobError:
            continue
        data[ep] = val
    return data


# ---------------------------------------------------------------------------
# Views — aus den Blobs lesbare Strukturen bauen
# ---------------------------------------------------------------------------

def decode_ports(target, dia):
    """Liste der Portnamen (aus link.b, sonst Modell-Default)."""
    spec = DIALECTS[dia]
    link = target.get("link.b") or {}
    names = None
    if spec["portnames"] and isinstance(link, dict):
        raw = link.get(spec["portnames"])
        if isinstance(raw, list) and raw:
            names = [hexascii(h) or f"port{i+1}"
                     for i, h in enumerate(raw)]
    if not names:
        # Portzahl aus PVID-Array ableiten, sonst Modell-Default
        pvid = decode_pvid(target, dia)
        default = DEFAULT_PORTNAMES.get(dia, [])
        if pvid:
            names = [default[i] if i < len(default) else f"port{i+1}"
                     for i in range(len(pvid))]
        else:
            names = list(default)
    return names


def decode_pvid(target, dia):
    spec = DIALECTS[dia]
    fwd = target.get("fwd.b") or {}
    if not isinstance(fwd, dict):
        return []
    arr = fwd.get(spec["pvid"])
    return arr if isinstance(arr, list) else []


def decode_vlans(target, dia, portnames):
    spec = DIALECTS[dia]
    vlan = target.get("vlan.b")
    if not isinstance(vlan, list):
        return []
    total = len(portnames)
    out = []
    kind = spec["vlan"]
    for e in vlan:
        if not isinstance(e, dict):
            continue
        if kind == "nm_mbr":
            vid = e.get("vid"); mbr = e.get("mbr", 0)
            name = hexascii(e.get("nm")) or None
            members = bits_to_ports(mbr, total)
        elif kind == "i01_i02":
            vid = e.get("i01"); mbr = e.get("i02", 0)
            name = None
            members = bits_to_ports(mbr, total)
        elif kind == "B_C":
            vid = e.get("B"); mbr = e.get("C", 0)
            name = None
            members = bits_to_ports(mbr, total)
        elif kind == "prt":
            vid = e.get("vid"); prt = e.get("prt", [])
            name = None
            members = [i for i, v in enumerate(prt) if v]
        else:
            continue
        if vid is None:
            continue
        out.append({"vid": vid, "name": name, "members": members})
    out.sort(key=lambda v: v["vid"])
    return out


def decode_poe(target, dia, nports):
    """Liste der PoE-Modi je Port (oder None wenn kein PoE)."""
    spec = DIALECTS[dia]
    src = spec["poe"]
    if src is None:
        return None
    if src == "poe_i04":
        poe = target.get("poe.b")
        if isinstance(poe, dict) and isinstance(poe.get("i04"), list):
            return [POE_MODES.get(v, f"0x{v:02x}") for v in poe["i04"]]
    elif src == "poe_E":
        poe = target.get("poe.b")
        if isinstance(poe, dict) and isinstance(poe.get("E"), list):
            return [POE_MODES.get(v, f"0x{v:02x}") for v in poe["E"]]
    elif src == "link":
        # CSS106-PoE-Variante (z.B. CSS106-1G-4P-1S): poe.b fehlt (303), PoE-Info
        # steckt in link.b (poe=Faehigkeit, poes=Status). Die genaue Semantik von
        # `poes` ist noch nicht gegen engine.js verifiziert -> bewusst NICHT als
        # PoE-Modus ausgeben (nicht raten). TODO Stufe-1-Nacharbeit.
        poe = target.get("poe.b")
        if isinstance(poe, dict) and isinstance(poe.get("i04"), list):
            return [POE_MODES.get(v, f"0x{v:02x}") for v in poe["i04"]]
        return None
    return None


def decode_fdb(target, dia, portnames):
    """FDB (!dhost.b) -> Liste {mac, port, vid}."""
    fdb = target.get("!dhost.b")
    if not isinstance(fdb, list):
        return []
    out = []
    for e in fdb:
        if not isinstance(e, dict):
            continue
        if "adr" in e:                         # voll: {adr,vid,prt}
            mac = mac_fmt(e.get("adr")); idx = e.get("prt", 0); vid = e.get("vid")
        else:                                  # lite: {i01,i02}
            mac = mac_fmt(e.get("i01")); idx = e.get("i02", 0); vid = None
        port = portnames[idx] if idx < len(portnames) else f"port{idx+1}"
        out.append({"mac": mac, "port": port, "vid": vid})
    return out


def decode_sys(target, dia):
    sysobj = target.get("sys.b") or {}
    spec = DIALECTS[dia]
    return {
        "dialect": dia,
        "model": hexascii(_first(sysobj, spec["model"])),
        "identity": hexascii(_first(sysobj, spec["identity"])),
        "version": hexascii(_first(sysobj, spec["version"])),
        "mac": mac_fmt(_first(sysobj, spec["mac"])),
        "serial": hexascii(_first(sysobj, spec["serial"])),
        "ip_current": le_ip(_first(sysobj, spec["ip_cur"])),
        "ip_static": le_ip(_first(sysobj, spec["ip_stat"])),
        "temp_c": _first(sysobj, spec["temp"]),
        "uptime_raw": _first(sysobj, spec["uptime"]),
    }


def build_report(target):
    sysobj = target.get("sys.b")
    if not isinstance(sysobj, dict):
        raise SystemExit(f"[{target.name}] sys.b nicht lesbar (kein SwOS-Blob)")
    dia = detect_dialect(sysobj)
    portnames = decode_ports(target, dia)
    pvid = decode_pvid(target, dia)
    poe = decode_poe(target, dia, len(portnames))
    vlans = decode_vlans(target, dia, portnames)
    vlan_names = {v["vid"]: v["name"] for v in vlans if v["name"]}

    ports = []
    for i, pn in enumerate(portnames):
        vid = pvid[i] if i < len(pvid) else None
        ports.append({
            "port": pn,
            "pvid": vid,
            "pvid_name": vlan_names.get(vid),
            "poe": poe[i] if poe and i < len(poe) else None,
        })
    return {
        "name": target.name,
        "mode": target.mode,
        "sys": decode_sys(target, dia),
        "vlans": vlans,
        "ports": ports,
        "fdb": decode_fdb(target, dia, portnames),
    }


# ---------------------------------------------------------------------------
# Inventory
# ---------------------------------------------------------------------------

def _find_inventory():
    override = os.environ.get("SWOS_INVENTORY")
    if override:
        return override
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "inventory.json")
    if os.path.exists(here):
        return here
    home = os.path.join(os.path.expanduser("~"), ".config",
                        "swos-inventory.json")
    if os.path.exists(home):
        return home
    return None


def load_inventory():
    path = _find_inventory()
    if not path:
        return {}
    with open(path) as f:
        return json.load(f)


def resolve_cred(sw, inv):
    user = sw.get("user") or inv.get("defaults", {}).get("user", "admin")
    if "password" in sw:
        return user, sw["password"]
    cref = sw.get("cred")
    if cref:
        c = inv.get("credentials", {}).get(cref, {})
        user = c.get("user", user)
        if "password" in c:
            return user, c["password"]
        if "password_env" in c:
            pw = os.environ.get(c["password_env"])
            if pw is None:
                raise SystemExit(f"env {c['password_env']} nicht gesetzt "
                                 f"(credential {cref})")
            return user, pw
        if "password_file" in c:
            p = os.path.expanduser(c["password_file"])
            with open(p) as f:
                return user, f.read().strip()
    return user, sw.get("password", "")


def make_target(args):
    """Target aus --swb, --ip/--mode oder Inventory-Namen bauen."""
    if args.swb:
        data = read_swb(args.swb)
        name = args.switch or os.path.basename(args.swb)
        return Target(name, "swb", swb_data=data)

    inv = load_inventory()
    if args.switch and args.switch in inv.get("switches", {}):
        sw = inv["switches"][args.switch]
        user, pw = resolve_cred(sw, inv)
        return Target(args.switch, sw.get("mode", "direct"),
                      ip=sw.get("ip"), user=user, password=pw,
                      jump=sw.get("jump"))
    # ad-hoc
    if args.ip:
        return Target(args.switch or args.ip, args.mode or "direct",
                      ip=args.ip, user=args.user or "admin",
                      password=args.password or "", jump=args.jump)
    raise SystemExit("Kein Ziel: Inventory-Name, --ip oder --swb angeben "
                     "(swos list zeigt das Inventory).")


