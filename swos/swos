def fmt_temp(v):
    return f"{v} °C" if isinstance(v, int) else "-"


def print_sys(rep):
    s = rep["sys"]
    print(f"# {rep['name']}  ({rep['mode']}, {s['dialect']})")
    print(f"  Modell    : {s['model'] or '?'}")
    print(f"  Identity  : {s['identity'] or '?'}")
    print(f"  Version   : {s['version'] or '?'}")
    print(f"  MAC       : {s['mac'] or '?'}")
    print(f"  Serial    : {s['serial'] or '?'}")
    print(f"  IP aktuell: {s['ip_current'] or '?'}")
    print(f"  IP statisch: {s['ip_static'] or '?'}")
    if s["temp_c"] is not None:
        print(f"  Temp      : {fmt_temp(s['temp_c'])}")


def print_vlans(rep, portnames):
    vlans = rep["vlans"]
    if not vlans:
        print("  (keine VLANs)")
        return
    for v in vlans:
        name = v["name"] or f"VLAN {v['vid']}"
        members = ", ".join(portnames[i] for i in v["members"]
                            if i < len(portnames))
        print(f"  VLAN {v['vid']:>4}  {name:<22} {members}")


def print_ports(rep):
    for p in rep["ports"]:
        vid = p["pvid"]
        vn = p["pvid_name"] or (f"VLAN {vid}" if vid is not None else "-")
        poe = f"  PoE: {p['poe']}" if p["poe"] else ""
        vids = f"{vid:>4}" if vid is not None else "   -"
        print(f"  {p['port']:<10} PVID {vids}  ({vn}){poe}")


def print_fdb(rep):
    if not rep["fdb"]:
        print("  (FDB leer / im Backup nicht enthalten)")
        return
    for e in rep["fdb"]:
        vid = f"  VLAN {e['vid']}" if e["vid"] is not None else ""
        print(f"  {e['mac']}  ->  {e['port']}{vid}")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def add_target_args(p):
    p.add_argument("switch", nargs="?", help="Inventory-Name des Switches")
    p.add_argument("--ip", help="Ad-hoc: Switch-IP")
    p.add_argument("--mode", choices=["direct", "ssh-curl"],
                   help="Ad-hoc: Zugriffsmodus")
    p.add_argument("--jump", help="Ad-hoc: Jump-Host fuer ssh-curl")
    p.add_argument("--user", help="Ad-hoc: Digest-User (default admin)")
    p.add_argument("--password", help="Ad-hoc: Digest-Passwort")
    p.add_argument("--swb", help="Offline: .swb-Backup-Datei statt Live-Zugriff")
    p.add_argument("--json", action="store_true", help="JSON statt Tabelle")


def cmd_list(args):
    inv = load_inventory()
    sw = inv.get("switches", {})
    if not sw:
        print("Kein Inventory gefunden (SWOS_INVENTORY / inventory.json / "
              "~/.config/swos-inventory.json).")
        return
    for name, c in sorted(sw.items()):
        via = f" via {c['jump']}" if c.get("jump") else ""
        print(f"  {name:<14} {c.get('ip',''):<16} {c.get('mode','direct')}{via}"
              f"   {c.get('model','')}")


def _emit(args, rep, which):
    if args.json:
        print(json.dumps(rep, indent=2, ensure_ascii=False))
        return
    portnames = [p["port"] for p in rep["ports"]]
    if which in ("sys", "all"):
        print_sys(rep)
    if which in ("vlan", "all"):
        if which == "all":
            print("\nVLANs:")
        print_vlans(rep, portnames)
    if which in ("ports", "all"):
        if which == "all":
            print("\nPorts (PVID / PoE):")
        print_ports(rep)
    if which in ("hosts", "all"):
        if which == "all":
            print("\nFDB (MAC -> Port):")
        print_fdb(rep)


def cmd_view(args, which):
    target = make_target(args)
    rep = build_report(target)
    _emit(args, rep, which)


def cmd_raw(args):
    target = make_target(args)
    val = target.get(args.endpoint)
    print(json.dumps(val, indent=2, ensure_ascii=False))


def cmd_backup(args):
    target = make_target(args)
    data = target.fetch_backup_bytes()
    if not data:
        raise SystemExit(f"[{target.name}] backup: leere Antwort "
                         "(Endpoint existiert vermutlich nicht auf diesem Modell)")
    path = args.output or f"{target.name}.swb"
    with open(path, "wb") as f:
        f.write(data)
    print(f"Backup gespeichert: {path} ({len(data)} Bytes)")
    print("Achtung: .swb enthaelt das Digest-Passwort hex-kodiert (.pwd.b) -- "
          "nicht unbedacht weitergeben/anhaengen.")


def main():
    ap = argparse.ArgumentParser(
        prog="swos", description="MikroTik SwOS read-only Abfrage")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="Inventory anzeigen")

    for name, help_ in [("sys", "System-Info"), ("vlan", "VLAN-Mitglieder"),
                        ("ports", "Portbelegung (PVID/PoE)"),
                        ("hosts", "FDB (MAC->Port)"),
                        ("all", "alle Views")]:
        p = sub.add_parser(name, help=help_)
        add_target_args(p)

    p = sub.add_parser("raw", help="Rohen Endpoint-Blob als JSON")
    add_target_args(p)
    p.add_argument("endpoint", help="z.B. sys.b, vlan.b, !dhost.b")

    p = sub.add_parser("backup", help="Live-Backup ziehen (GET /backup.swb)")
    add_target_args(p)
    p.add_argument("--output", help="Zieldatei (default: <switch>.swb)")

    args = ap.parse_args()
    if args.cmd == "list":
        cmd_list(args)
    elif args.cmd == "raw":
        cmd_raw(args)
    elif args.cmd == "backup":
        cmd_backup(args)
    else:
        cmd_view(args, args.cmd)


if __name__ == "__main__":
    try:
        main()
        sys.stdout.flush()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        # z.B. Ausgabe nach `| head` -- sauber beenden statt Traceback
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(0)
