def _vlan_set_egress(target, args, cur, wf):
    """swos_lite (CSS106): VLAN-Membership ueber das Per-Port-Egress-Enum 'prt'
    setzen. --tagged -> 'add if missing' (2), --untagged -> 'always strip' (1),
    alle uebrigen Ports -> 'not a member' (3). Deklarativ: setzt den KOMPLETTEN
    Membership-Satz des VLANs (wie der Bitmask-Pfad die volle Maske); die Mode
    'leave as is' (0) ist ueber tagged/untagged bewusst nicht erreichbar."""
    if args.members:
        raise SystemExit(
            f"vlan-set: Dialekt '{target._dialect}' nutzt kein Member-Bitmask — "
            "Ports ueber --tagged/--untagged angeben, nicht --members.")
    vidf, egf, order = wf["vid"], wf["egress"], wf["order"]
    tagged, nports = _vlan_ports(target, args.tagged, "--tagged")
    untagged, _ = _vlan_ports(target, args.untagged, "--untagged")
    overlap = tagged & untagged
    if overlap:
        raise SystemExit(f"vlan-set: Port(s) {sorted(overlap)} zugleich tagged und untagged.")
    if not tagged and not untagged:
        raise SystemExit("vlan-set: mindestens --tagged oder --untagged angeben.")
    # prt-Array in Portreihenfolge: Default 3 (not a member), dann Overrides.
    prt = [3] * nports
    for p in tagged:
        prt[p - 1] = 2      # add if missing (tagged egress)
    for p in untagged:
        prt[p - 1] = 1      # always strip (untagged egress)

    def build(src):
        e = {}
        for k in order:
            if k == egf:
                e[k] = list(prt)
            elif src is not None and k in src:
                e[k] = src[k]
            elif k == vidf:
                e[k] = args.vid
            else:
                e[k] = wf["new"].get(k, 0)
        return e

    found = False
    new = []
    for v in cur:
        if v.get(vidf) == args.vid:
            new.append(build(v))
            found = True
        else:
            new.append({k: v.get(k, wf["new"].get(k, 0)) for k in order})
    if not found:
        new.append(build(None))

    orig = {v.get(vidf): v.get(egf) for v in cur}

    def verify(back):
        if not isinstance(back, list):
            return False, "vlan.b nicht als Liste zurueck"
        bmap = {v.get(vidf): v.get(egf) for v in back}
        if bmap.get(args.vid) != prt:
            return False, f"VLAN {args.vid} prt read-back {bmap.get(args.vid)} != {prt}"
        for ovid, oprt in orig.items():
            if ovid == args.vid:
                continue
            if bmap.get(ovid) != oprt:
                return False, (f"VLAN {ovid} prt unerwartet veraendert "
                               f"({oprt} -> {bmap.get(ovid)})")
        return True, ""

    action = "aktualisiert" if found else "angelegt (neu)"
    describe = [
        f"# {target.name}  VLAN {args.vid} {action}  tagged={sorted(tagged) or '-'} "
        f"untagged={sorted(untagged) or '-'}  (Rest: not a member)",
        f"  prt geplant : {_blob_arr(prt)}",
        f"  vlan.b geplant: {_ser(new)}",
    ]
    _commit_write(target, "vlan.b", new, describe, args,
                  f"VLAN {args.vid} tagged={sorted(tagged)} untagged={sorted(untagged)}.",
                  verify_fn=verify)


def _vlan_set_bitmask(target, args, cur, wf):
    vidf, mbrf, order = wf["vid"], wf["member"], wf["order"]
    if args.tagged or args.untagged:
        raise SystemExit(
            f"vlan-set: --tagged/--untagged nur fuer CSS106 (swos_lite); Dialekt "
            f"'{target._dialect}' nutzt --members (Member-Bitmask).")
    if not args.members:
        raise SystemExit("vlan-set: --members = Komma-Liste von Portnummern (z.B. 1,2,9).")
    ports_set, nports = _vlan_ports(target, args.members, "--members")
    ports = sorted(ports_set)
    mask = 0
    for p in ports:
        mask |= 1 << (p - 1)

    # Eintrag in kanonischer POST-Feldreihenfolge (order) aufbauen: bestehende
    # Felder erhalten (GET-Reihenfolge != POST-Reihenfolge!), Ziel-VLAN Member
    # ersetzen, fehlende Felder aus "new"-Defaults. Ziel-VLAN aktualisieren oder
    # neu anhaengen.
    def build(src):
        e = {}
        for k in order:
            if k == mbrf:
                e[k] = mask
            elif src is not None and k in src:
                e[k] = src[k]
            elif k == vidf:
                e[k] = args.vid
            elif k == wf.get("name"):
                e[k] = f"VLAN {args.vid}".encode("utf-8").hex()
            else:
                e[k] = wf["new"].get(k, 0)
        return e

    found = False
    new = []
    for v in cur:
        if v.get(vidf) == args.vid:
            new.append(build(v))
            found = True
        else:
            # unveraendert, aber in kanonische Reihenfolge gebracht
            new.append({k: v.get(k, wf["new"].get(k, 0)) for k in order})
    if not found:
        new.append(build(None))

    orig = {v.get(vidf): v.get(mbrf) for v in cur}

    def verify(back):
        if not isinstance(back, list):
            return False, "vlan.b nicht als Liste zurueck"
        bmap = {v.get(vidf): v.get(mbrf) for v in back}
        if bmap.get(args.vid) != mask:
            return False, f"VLAN {args.vid} member read-back {bmap.get(args.vid)} != {mask}"
        for ovid, omask in orig.items():
            if ovid == args.vid:
                continue
            if bmap.get(ovid) != omask:
                return False, (f"VLAN {ovid} unerwartet veraendert "
                               f"({omask} -> {bmap.get(ovid)})")
        return True, ""

    action = "aktualisiert" if found else "angelegt (neu)"
    describe = [
        f"# {target.name}  VLAN {args.vid} {action}  Members: Ports {ports} "
        f"(mask {_blob_hex(mask)})",
        f"  vlan.b geplant: {_ser(new)}",
    ]
    _commit_write(target, "vlan.b", new, describe, args,
                  f"VLAN {args.vid} Members = Ports {ports}.", verify_fn=verify)


def _vlan_entry_ordered(v, wf):
    """Bestehenden vlan.b-Eintrag feldtreu in kanonische POST-Reihenfolge bringen."""
    return {k: v.get(k, wf["new"].get(k, 0)) for k in wf["order"]}


def cmd_vlan_remove(args):
    """Ein VLAN aus vlan.b entfernen (dialekt-generisch ueber den vlan.b-Pfad).
    Uebrige VLANs bleiben feldtreu erhalten."""
    target = _write_guard(args, "vlan-remove", "vlan.b")
    cur = target.get("vlan.b")
    if not isinstance(cur, list):
        raise SystemExit(f"[{target.name}] vlan.b nicht lesbar")
    wf = _wf(target, "vlan.b")
    vidf, mbrf = wf["vid"], wf.get("member")   # mbrf fehlt bei swos_lite (prt-Modell)
    present = [v.get(vidf) for v in cur]
    if args.vid not in present:
        print(f"# {target.name}  VLAN {args.vid} nicht vorhanden — nichts zu entfernen "
              f"(vorhandene: {present or 'keine'}).")
        return
    new = [_vlan_entry_ordered(v, wf) for v in cur if v.get(vidf) != args.vid]
    remaining = sorted(x for x in present if x != args.vid)
    # Masken der uebrigen VLANs nur pruefen, wo ein Member-Bitmask existiert.
    orig = {v.get(vidf): v.get(mbrf) for v in cur} if mbrf else {}

    def verify(back):
        if not isinstance(back, list):
            return False, "vlan.b nicht als Liste zurueck"
        bvids = sorted(v.get(vidf) for v in back)
        if args.vid in bvids:
            return False, f"VLAN {args.vid} nach Entfernen noch vorhanden"
        if bvids != remaining:
            return False, f"VLAN-Satz unerwartet {bvids} != erwartet {remaining}"
        if mbrf:
            bmap = {v.get(vidf): v.get(mbrf) for v in back}
            for ovid, omask in orig.items():
                if ovid == args.vid:
                    continue
                if bmap.get(ovid) != omask:
                    return False, (f"VLAN {ovid} unerwartet veraendert "
                                   f"({omask} -> {bmap.get(ovid)})")
        return True, ""

    describe = [
        f"# {target.name}  VLAN {args.vid} entfernen  (verbleibend: {remaining or 'keine'})",
        f"  vlan.b geplant: {_ser(new)}",
    ]
    _commit_write(target, "vlan.b", new, describe, args,
                  f"VLAN {args.vid} entfernt.", verify_fn=verify)


def cmd_vlan_clear(args):
    """Komplette vlan.b leeren ([]) -- entfernt alle VLAN-Eintraege."""
    target = _write_guard(args, "vlan-clear", "vlan.b")
    cur = target.get("vlan.b")
    if not isinstance(cur, list):
        raise SystemExit(f"[{target.name}] vlan.b nicht lesbar")
    if not cur:
        print(f"# {target.name}  vlan.b ist bereits leer — nichts zu tun.")
        return
    vids = [v.get(_wf(target, "vlan.b")["vid"]) for v in cur]

    def verify(back):
        if not isinstance(back, list):
            return False, "vlan.b nicht als Liste zurueck"
        if back:
            return False, f"vlan.b nicht leer ({len(back)} Eintraege zurueck)"
        return True, ""

    describe = [
        f"# {target.name}  vlan.b LEEREN  (entfernt VLANs {vids})",
        "  vlan.b geplant: []",
    ]
    _commit_write(target, "vlan.b", [], describe, args,
                  "alle VLANs entfernt (vlan.b leer).", verify_fn=verify)


def main():
    ap = argparse.ArgumentParser(
        prog="swos", description="MikroTik SwOS read-only Abfrage")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="Inventory anzeigen")

    for name, help_ in [("sys", "System-Info"), ("vlan", "VLAN-Mitglieder"),
                        ("ports", "Portbelegung (PVID/PoE)"),
                        ("hosts", "FDB (MAC->Port)"),
                        ("all", "alle Views")]:
        p = sub.add_parser(name, help=help_)
        add_target_args(p)

    p = sub.add_parser("raw", help="Rohen Endpoint-Blob als JSON")
    add_target_args(p)
    p.add_argument("endpoint", help="z.B. sys.b, vlan.b, !dhost.b")

    p = sub.add_parser("backup", help="Live-Backup ziehen (GET /backup.swb)")
    add_target_args(p)
    p.add_argument("--output", help="Zieldatei (default: <switch>.swb)")

    def _commit_arg(p):
        p.add_argument("--commit", action="store_true",
                       help="tatsaechlich senden (Default: Dry-Run, sendet nichts)")

    p = sub.add_parser("poe-out",
                       help="PoE Out je Port setzen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert)")
    p.add_argument("--to", dest="mode", required=True,
                   choices=["off", "on", "auto", "calibr"],
                   help="PoE Out Zielwert: off | on | auto (| calibr nur CSS106). "
                        "Gueltige Werte je Dialekt werden zur Laufzeit geprueft.")
    _commit_arg(p)

    p = sub.add_parser("poe-voltage",
                       help="PoE Voltage Level je Port setzen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert)")
    p.add_argument("--to", dest="mode", required=True, choices=["auto", "low", "high"],
                   help="Voltage Level: auto | low | high")
    _commit_arg(p)

    p = sub.add_parser("portname",
                       help="Port-Name setzen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert)")
    p.add_argument("--name", required=True, help=f"neuer Name (max {PORTNAME_MAX} Bytes)")
    _commit_arg(p)

    for _n, _h in [("port-enable", "Port aktivieren/deaktivieren"),
                   ("autoneg", "Auto Negotiation je Port setzen"),
                   ("duplex", "Full Duplex je Port setzen")]:
        p = sub.add_parser(_n, help=f"{_h} (Stufe 2, schreibend)")
        add_target_args(p)
        p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert)")
        p.add_argument("--to", dest="state", required=True, choices=["on", "off"],
                       help="Zielwert: on | off")
        p.add_argument("--force", action="store_true",
                       help="Aenderung an Port mit aktivem Link erzwingen (Link-/Lockout-Gefahr)")
        _commit_arg(p)

    p = sub.add_parser("speed",
                       help="Forced Speed je Port setzen (Kupfer + SFP+; Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert, inkl. SFP+)")
    p.add_argument("--to", required=True,
                   help="Speed in Mbit/s (Enum dialektabhaengig, zur Laufzeit geprueft: "
                        "Kupfer 10/100/1000; SFP+ z.B. 2500/10000). Nur bei Auto-Neg=off wirksam.")
    p.add_argument("--force", action="store_true",
                   help="Aenderung an Port mit aktivem Link erzwingen (Link-/Lockout-Gefahr)")
    _commit_arg(p)

    p = sub.add_parser("vlan-mode",
                       help="VLAN Mode je Port setzen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert)")
    p.add_argument("--to", required=True,
                   choices=["disabled", "optional", "enabled", "strict"],
                   help="VLAN Mode: disabled | optional | enabled (nur css326) | strict "
                        "(je Dialekt gegen engine.js validiert)")
    p.add_argument("--force", action="store_true",
                   help="Aenderung an Port mit aktivem Link erzwingen (VLAN-Filter-/Lockout-Gefahr)")
    _commit_arg(p)

    p = sub.add_parser("vlan-receive",
                       help="VLAN Receive je Port setzen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert)")
    p.add_argument("--to", required=True, choices=["any", "tagged", "untagged"],
                   help="VLAN Receive: any | tagged (only tagged) | untagged (only untagged)")
    p.add_argument("--force", action="store_true",
                   help="Aenderung an Port mit aktivem Link erzwingen (VLAN-Filter-/Lockout-Gefahr)")
    _commit_arg(p)

    p = sub.add_parser("force-vlan-id",
                       help="Force VLAN ID je Port setzen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert)")
    p.add_argument("--to", dest="state", required=True, choices=["on", "off"],
                   help="Force VLAN ID: on | off")
    p.add_argument("--force", action="store_true",
                   help="Aenderung an Port mit aktivem Link erzwingen (VLAN-Filter-/Lockout-Gefahr)")
    _commit_arg(p)

    p = sub.add_parser("pvid",
                       help="PVID (Default VLAN ID) je Port setzen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--port", type=int, required=True, help="Portnummer (1-basiert)")
    p.add_argument("--vid", type=int, required=True, help="VLAN-ID 1..4095")
    _commit_arg(p)

    p = sub.add_parser("vlan-set",
                       help="VLAN-Membership setzen/anlegen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--vid", type=int, required=True, help="VLAN-ID 1..4094")
    p.add_argument("--members",
                   help="Bitmask-Dialekte (css610/css326): Komma-Liste Portnummern "
                        "(Portzahl je Modell; die letzten zwei sind SFP/SFP+)")
    p.add_argument("--tagged",
                   help="CSS106 (swos_lite): Ports mit tagged Egress (add if missing)")
    p.add_argument("--untagged",
                   help="CSS106 (swos_lite): Ports mit untagged Egress (always strip); "
                        "nicht genannte Ports werden not-a-member")
    _commit_arg(p)

    p = sub.add_parser("vlan-remove",
                       help="Ein VLAN aus vlan.b entfernen (Stufe 2, schreibend)")
    add_target_args(p)
    p.add_argument("--vid", type=int, required=True, help="zu entfernende VLAN-ID")
    _commit_arg(p)

    p = sub.add_parser("vlan-clear",
                       help="Alle VLANs aus vlan.b entfernen (Stufe 2, schreibend)")
    add_target_args(p)
    _commit_arg(p)

    args = ap.parse_args()
    dispatch = {
        "poe-out": cmd_poe_out,
        "poe-voltage": cmd_poe_voltage,
        "portname": cmd_portname,
        "port-enable": cmd_port_enable,
        "autoneg": cmd_autoneg,
        "duplex": cmd_duplex,
        "speed": cmd_speed,
        "vlan-mode": cmd_vlan_mode,
        "vlan-receive": cmd_vlan_receive,
        "force-vlan-id": cmd_force_vlan_id,
        "pvid": cmd_pvid,
        "vlan-set": cmd_vlan,
        "vlan-remove": cmd_vlan_remove,
        "vlan-clear": cmd_vlan_clear,
    }
    if args.cmd == "list":
        cmd_list(args)
    elif args.cmd == "raw":
        cmd_raw(args)
    elif args.cmd == "backup":
        cmd_backup(args)
    elif args.cmd in dispatch:
        dispatch[args.cmd](args)
    else:
        cmd_view(args, args.cmd)


if __name__ == "__main__":
    try:
        main()
        sys.stdout.flush()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        # z.B. Ausgabe nach `| head` -- sauber beenden statt Traceback
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(0)
