        valid = ", ".join(sorted(enum, key=lambda k: enum[k]))
        raise SystemExit(f"speed: '{args.to}' fuer Dialekt '{target._dialect}' "
                         f"ungueltig. Gueltig (Mbit/s): {valid}.")
    spd = list(post[spdf])
    tv = enum[args.to]
    old = spd[args.port - 1]
    changes = old != tv
    has_link = bool((cur.get(lnkf, 0) >> (args.port - 1)) & 1)
