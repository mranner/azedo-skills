def decode_ports(target, dia):
    """Liste der Portnamen (aus link.b, sonst Modell-Default)."""
    spec = DIALECTS[dia]
    link = target.get("link.b") or {}
    names = None
    if spec["portnames"] and isinstance(link, dict):
        raw = link.get(spec["portnames"])
        if isinstance(raw, list) and raw:
            names = [hexascii(h) or f"port{i+1}"
                     for i, h in enumerate(raw)]
    if not names:
        # Portzahl aus PVID-Array ableiten, sonst Modell-Default
        pvid = decode_pvid(target, dia)
        default = DEFAULT_PORTNAMES.get(dia, [])
        if pvid:
            names = [default[i] if i < len(default) else f"port{i+1}"
                     for i in range(len(pvid))]
        else:
            names = list(default)
    return names


def decode_pvid(target, dia):
    spec = DIALECTS[dia]
    fwd = target.get("fwd.b") or {}
    if not isinstance(fwd, dict):
        return []
    arr = fwd.get(spec["pvid"])
    return arr if isinstance(arr, list) else []


def decode_vlans(target, dia, portnames):
    spec = DIALECTS[dia]
    vlan = target.get("vlan.b")
    if not isinstance(vlan, list):
        return []
    total = len(portnames)
    out = []
    kind = spec["vlan"]
    for e in vlan:
        if not isinstance(e, dict):
            continue
        if kind == "nm_mbr":
            vid = e.get("vid"); mbr = e.get("mbr", 0)
            name = hexascii(e.get("nm")) or None
            members = bits_to_ports(mbr, total)
        elif kind == "i01_i02":
            vid = e.get("i01"); mbr = e.get("i02", 0)
            name = None
            members = bits_to_ports(mbr, total)
        elif kind == "B_C":
            vid = e.get("B"); mbr = e.get("C", 0)
            name = None
            members = bits_to_ports(mbr, total)
        elif kind == "prt":
            vid = e.get("vid"); prt = e.get("prt", [])
            name = None
            members = [i for i, v in enumerate(prt) if v]
        else:
            continue
        if vid is None:
            continue
        out.append({"vid": vid, "name": name, "members": members})
    out.sort(key=lambda v: v["vid"])
    return out


def _poe_status_names(arr):
    return [POE_STATUS[v] if 0 <= v < len(POE_STATUS) else f"0x{v:02x}" for v in arr]


def _is_poe_model(target, dia):
    """CSS106 (swos_lite) fuehrt ein link.b-`poe`-Feld auch auf Nicht-PoE-Modellen
    (z.B. CSS106-5G-1S). Echtes PoE nur beim `-4P-`-Modell (wie der Write-Pfad,
    _link_has_poe). css610 hat immer poe.b."""
    if dia == "swos_lite":
        model = hexascii(_first(target.get("sys.b") or {}, DIALECTS[dia]["model"])) or ""
        return "-4P-" in model
    return True


def _poe_port_range(dia, nports):
    """PoE-faehiger Portbereich (1-basiert, inkl.) je Dialekt. Ausserhalb liegende
    Ports (SFP(+), Uplink) haben keine PoE-Hardware -> kein Modus/Status."""
    spec = POE_OUT_SPEC.get(dia)
    if spec and spec.get("ports"):
        return spec["ports"]                       # swos_lite: (2,5)
    if dia == "css610_new":                         # Kupfer 1..8 (SFP+ 9/10 kein PoE)
        return (1, nports - SFP_PORTS.get(dia, 2))
    return (1, nports)                              # css610_old: Best-Effort alle


def decode_poe(target, dia, nports):
    """PoE-CONFIG-Modus je Port (off/on/auto bzw. off/auto/on/calibr), oder None.
    Wichtig: der Config-Modus, NICHT der Runtime-Status (dafuer decode_poe_status)."""
    spec = DIALECTS[dia]
    src = spec["poe"]
    if src is None or not _is_poe_model(target, dia):
        return None
    lo, hi = _poe_port_range(dia, nports)
    raw = None
    if src == "poe_i04":
        # css610_new: Config-Modus = poe.b i01 (engine.js u:["off","on","auto"]).
        # (i04 ist der Runtime-Status -> decode_poe_status.)
        poe = target.get("poe.b")
        if isinstance(poe, dict) and isinstance(poe.get("i01"), list):
            raw = [POE_OUT_NAMES.get(v, f"0x{v:02x}") for v in poe["i01"]]
    elif src == "poe_E":
        # css610_old (Buchstaben-Schema): kein verifiziertes Config-Feld/Enum
        # (kein Alt-FW-Geraet zum Gegenpruefen) -> Status-Enum als Best-Effort.
        poe = target.get("poe.b")
        if isinstance(poe, dict) and isinstance(poe.get("E"), list):
            raw = _poe_status_names(poe["E"])
    elif src == "link":
        # CSS106-PoE-Modell (CSS106-1G-4P-1S): poe.b fehlt (303), Config-Modus steht
        # in link.b poe (engine.js C:["off","auto","on","calibr"]). Non-PoE-CSS106
        # hat kein link.b poe -> None.
        link = target.get("link.b")
        if isinstance(link, dict) and isinstance(link.get("poe"), list):
            raw = [POE_OUT_NAMES_LITE.get(v, f"0x{v:02x}") for v in link["poe"]]
    if raw is None:
        return None
    return [m if lo <= i + 1 <= hi else None for i, m in enumerate(raw)]


def decode_poe_status(target, dia, nports):
    """PoE-Runtime-Status je Port (css610 poe.b i04 / CSS106 link.b poes), oder None.
    Enum POE_STATUS (engine.js), Index 0 = leer -> None. Nur PoE-faehige Ports."""
    if not _is_poe_model(target, dia):
        return None
    lo, hi = _poe_port_range(dia, nports)
    raw = None
    if dia == "css610_new":
        poe = target.get("poe.b")
        if isinstance(poe, dict) and isinstance(poe.get("i04"), list):
            raw = _poe_status_names(poe["i04"])
    elif dia == "swos_lite":
        link = target.get("link.b")
        if isinstance(link, dict) and isinstance(link.get("poes"), list):
            raw = _poe_status_names(link["poes"])
    if raw is None:
        return None
    return [(s or None) if lo <= i + 1 <= hi else None for i, s in enumerate(raw)]


# Ist-Speed-Feld (ausgehandelt) je Dialekt im link.b: css326/CSS106 'spd', css610 'i08'.
# Alle indizieren dasselbe Enum wie die Config (SPEED_ENUMS) -- Index ausserhalb =
# kein Link. CSS106-SFP ist 1G-only (SFP, kein SFP+) -> Enum [10,100,1000] genuegt.
_SPEED_ACTUAL_FIELD = {"css326": "spd", "css610_new": "i08", "swos_lite": "spd"}


def decode_speed(target, dia):
    """Ausgehandelte Ist-Geschwindigkeit je Port als Label (z.B. '10G'), oder None.
    None je Port, wenn der Speed-Code ausserhalb des Enums liegt (= kein Link)."""
    enum = SPEED_ENUMS.get(dia)
    fld = _SPEED_ACTUAL_FIELD.get(dia)
    if not enum or not fld:
        return None
    link = target.get("link.b")
    if not isinstance(link, dict) or not isinstance(link.get(fld), list):
        return None
    idx2mbit = {v: k for k, v in enum.items()}   # Enum-Index -> Mbit/s-String
    return [SPEED_LABELS.get(idx2mbit.get(v), None) for v in link[fld]]


def decode_fdb(target, dia, portnames):
    """FDB (!dhost.b) -> Liste {mac, port, vid}."""
    fdb = target.get("!dhost.b")
    if not isinstance(fdb, list):
        return []
    out = []
    for e in fdb:
        if not isinstance(e, dict):
            continue
        if "adr" in e:                         # voll: {adr,vid,prt}
            mac = mac_fmt(e.get("adr")); idx = e.get("prt", 0); vid = e.get("vid")
        else:                                  # lite: {i01,i02}
            mac = mac_fmt(e.get("i01")); idx = e.get("i02", 0); vid = None
        port = portnames[idx] if idx < len(portnames) else f"port{idx+1}"
        out.append({"mac": mac, "port": port, "vid": vid})
    return out


def decode_sys(target, dia):
    sysobj = target.get("sys.b") or {}
    spec = DIALECTS[dia]
    return {
        "dialect": dia,
        "model": hexascii(_first(sysobj, spec["model"])),
        "identity": hexascii(_first(sysobj, spec["identity"])),
        "version": hexascii(_first(sysobj, spec["version"])),
        "mac": mac_fmt(_first(sysobj, spec["mac"])),
        "serial": hexascii(_first(sysobj, spec["serial"])),
        "ip_current": le_ip(_first(sysobj, spec["ip_cur"])),
        "ip_static": le_ip(_first(sysobj, spec["ip_stat"])),
        "temp_c": _first(sysobj, spec["temp"]),
        "uptime_raw": _first(sysobj, spec["uptime"]),
    }


def build_report(target):
    sysobj = target.get("sys.b")
    if not isinstance(sysobj, dict):
        raise SystemExit(f"[{target.name}] sys.b nicht lesbar (kein SwOS-Blob)")
    dia = detect_dialect(sysobj)
    portnames = decode_ports(target, dia)
    pvid = decode_pvid(target, dia)
    poe = decode_poe(target, dia, len(portnames))
    poe_status = decode_poe_status(target, dia, len(portnames))
    speed = decode_speed(target, dia)
    vlans = decode_vlans(target, dia, portnames)
    vlan_names = {v["vid"]: v["name"] for v in vlans if v["name"]}

    ports = []
    for i, pn in enumerate(portnames):
        vid = pvid[i] if i < len(pvid) else None
        ports.append({
            "port": pn,
            "pvid": vid,
            "pvid_name": vlan_names.get(vid),
            "poe": poe[i] if poe and i < len(poe) else None,
            "poe_status": poe_status[i] if poe_status and i < len(poe_status) else None,
            "speed": speed[i] if speed and i < len(speed) else None,
        })
    return {
        "name": target.name,
        "mode": target.mode,
        "sys": decode_sys(target, dia),
        "vlans": vlans,
        "ports": ports,
        "fdb": decode_fdb(target, dia, portnames),
    }


