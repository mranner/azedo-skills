#!/usr/bin/env python3

# MikroTik SwOS read-only query helper
# stdlib only, no pip dependencies
# version 1.25.3
#
# Ein gemeinsamer Decoder, drei Transporte:
#   A) direct   – urllib HTTP-Digest direkt auf die Switch-IP (Runner routbar)
#   B) ssh-curl – curl --digest auf einem Jump-Host (interne Switches)
#   C) swb       – offline aus einem .swb-Backup (strings + Decoder)
#
# Vier SwOS-Feld-Dialekte: css326, css610_new, css610_old, swos_lite.
# `backup` zieht das Live-Backup (GET /backup.swb) -- reines Lesen (kein POST,
# keine Config-Aenderung), bleibt also innerhalb von Stufe 1.
# Siehe SKILL.md. read-only (Stufe 1) — kein Schreibzugriff.

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.request
import urllib.error


# ---------------------------------------------------------------------------
# SwOS-Blob-Parser (die Blobs sind KEIN valides JSON: unquoted Keys, Hex-Ints,
# Single-Quote-Hex-Strings). Recursive-descent statt Regex-pro-Key.
# ---------------------------------------------------------------------------

class BlobError(Exception):
    pass


class _Blob:
    def __init__(self, s):
        self.s = s
        self.i = 0
        self.n = len(s)

    def parse(self):
        v = self._value()
        return v

    def _ws(self):
        while self.i < self.n and self.s[self.i] in " \t\r\n":
            self.i += 1

    def _value(self):
        self._ws()
        if self.i >= self.n:
            raise BlobError("unexpected end")
        c = self.s[self.i]
        if c == "{":
            return self._object()
        if c == "[":
            return self._array()
        if c == "'":
            return self._qstring()
        return self._number()

    def _object(self):
        obj = {}
        self.i += 1                       # {
        self._ws()
        if self.i < self.n and self.s[self.i] == "}":
            self.i += 1
            return obj
        while True:
            self._ws()
            key = self._key()
            self._ws()
            if self.i >= self.n or self.s[self.i] != ":":
                raise BlobError("expected ':' after key %r" % key)
            self.i += 1                   # :
            obj[key] = self._value()
            self._ws()
            if self.i >= self.n:
                raise BlobError("unterminated object")
            if self.s[self.i] == ",":
                self.i += 1
                continue
            if self.s[self.i] == "}":
                self.i += 1
                break
            raise BlobError("expected ',' or '}' at %d" % self.i)
        return obj

    def _array(self):
        arr = []
        self.i += 1                       # [
        self._ws()
        if self.i < self.n and self.s[self.i] == "]":
            self.i += 1
            return arr
        while True:
            arr.append(self._value())
            self._ws()
            if self.i >= self.n:
                raise BlobError("unterminated array")
            if self.s[self.i] == ",":
                self.i += 1
                continue
            if self.s[self.i] == "]":
                self.i += 1
                break
            raise BlobError("expected ',' or ']' at %d" % self.i)
        return arr

    def _key(self):
        start = self.i
        while self.i < self.n and (self.s[self.i].isalnum() or self.s[self.i] == "_"):
            self.i += 1
        if self.i == start:
            raise BlobError("empty key at %d" % self.i)
        return self.s[start:self.i]

    def _qstring(self):
        self.i += 1                       # opening '
        start = self.i
        while self.i < self.n and self.s[self.i] != "'":
            self.i += 1
        val = self.s[start:self.i]
        self.i += 1                       # closing '
        # Quoted values are hex-encoded; keep the raw hex, decode per field.
        return val

    def _number(self):
        start = self.i
        while self.i < self.n and self.s[self.i] not in ",]}":
            self.i += 1
        tok = self.s[start:self.i].strip()
        if tok.startswith(("0x", "0X")):
            return int(tok, 16)
        try:
            return int(tok)
        except ValueError:
            return tok


def parse_blob(s):
    s = s.strip()
    if not s or s[0] not in "{[":
        return None
    return _Blob(s).parse()


# ---------------------------------------------------------------------------
# Decode-Helfer
# ---------------------------------------------------------------------------

def hexascii(h):
    if h is None:
        return None
    try:
        return bytes.fromhex(h).decode("utf-8", errors="replace").rstrip("\x00")
    except (ValueError, TypeError):
        return h


def mac_fmt(h):
    if not h or len(h) < 12:
        return h
    return ":".join(h[i:i + 2] for i in range(0, 12, 2))


def le_ip(val):
    if not isinstance(val, int):
        return None
    return ".".join(str((val >> (8 * i)) & 0xFF) for i in range(4))


def bits_to_ports(mask, total):
    return [i for i in range(total) if (mask >> i) & 1]


POE_MODES = {0x00: "off", 0x01: "forced-on", 0x02: "off",
             0x03: "auto", 0x05: "forced-on"}


# ---------------------------------------------------------------------------
# Dialekte
# ---------------------------------------------------------------------------

_I0X = re.compile(r"^i[0-9a-f]{2}$")


def detect_dialect(sysobj):
    """Dialekt aus sys.b-Keys/Modell bestimmen (live + backup robust)."""
    keys = set(sysobj.keys())
    if any(_I0X.match(k) for k in keys):
        return "css610_new"
    if "F" in keys and "J" in keys:
        return "css610_old"
    # mnemonisch: css326 vs swos_lite anhand Modell, dann anhand IP-Keys
    model = (hexascii(sysobj.get("brd")) or "").upper()
    if model.startswith("CSS326"):
        return "css326"
    if model.startswith("CSS106") or model.startswith("RB260"):
        return "swos_lite"
    if "cip" in keys:
        return "css326"
    if "sip" in keys:
        return "swos_lite"
    return "css326"


