def _link_bit_write(args, cmd, role, label):
    """Gemeinsam fuer link.b-Bitmaskenfelder (Enabled / Auto-Neg / Full-Duplex):
    ein Bit je Port on/off setzen. `role` ist die symbolische Feldrolle
    (enable/autoneg/duplex) -> Feldname je Dialekt. Lockout-/Link-Schutz: eine
    tatsaechliche Aenderung an einem Port MIT aktivem Link verlangt --force (kann
    den Link stoeren, evtl. Mgmt-/Uplink-Port). Der Dry-Run zeigt die Vorschau;
    erst der --commit erzwingt --force."""
    target = _write_guard(args, cmd, "link.b")
    cur, post = _post_subset(target, "link.b")
    wf = _wf(target, "link.b")
    field, lnkf = wf[role], wf["link"]
    _port_in_range(cmd, args.port, len(post[wf["names"]]))
    bit = 1 << (args.port - 1)
    val = post[field]
    want_on = args.state == "on"
    cur_on = bool(val & bit)
    changes = cur_on != want_on
    has_link = bool((cur.get(lnkf, 0) >> (args.port - 1)) & 1)
    if changes and has_link and not args.force and args.commit:
        raise SystemExit(f"{cmd}: Port {args.port} hat aktuell LINK ({lnkf}) — Aenderung nur "
                         "mit --force (kann den Link stoeren, evtl. Mgmt-/Uplink-Port).")
    new_val = (val | bit) if want_on else (val & ~bit)
    post[field] = new_val
    warn = "  [LINK aktiv!]" if (changes and has_link) else ""
    describe = [
        f"# {target.name}  {label}  Port {args.port}: "
        f"{'on' if cur_on else 'off'} -> {'on' if want_on else 'off'}{warn}",
        f"  {field} aktuell : {_blob_hex(val)}",
        f"  {field} geplant : {_blob_hex(new_val)}",
    ]
    _commit_write(target, "link.b", post, describe, args,
                  f"Port {args.port} {label} = {'on' if want_on else 'off'}, sonst unveraendert.")


