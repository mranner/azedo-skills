_I0X = re.compile(r"^i[0-9a-f]{2}$")


def detect_dialect(sysobj):
    """Dialekt aus sys.b-Keys/Modell bestimmen (live + backup robust)."""
    keys = set(sysobj.keys())
    if any(_I0X.match(k) for k in keys):
        return "css610_new"
    if "F" in keys and "J" in keys:
        return "css610_old"
    # mnemonisch: css326 vs swos_lite anhand Modell, dann anhand IP-Keys
    model = (hexascii(sysobj.get("brd")) or "").upper()
    if model.startswith("CSS326"):
        return "css326"
    if model.startswith("CSS106") or model.startswith("RB260"):
        return "swos_lite"
    if "cip" in keys:
        return "css326"
    if "sip" in keys:
        return "swos_lite"
    return "css326"


