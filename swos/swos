def _find_inventory():
    override = os.environ.get("SWOS_INVENTORY")
    if override:
        return override
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "inventory.json")
    if os.path.exists(here):
        return here
    home = os.path.join(os.path.expanduser("~"), ".config",
                        "swos-inventory.json")
    if os.path.exists(home):
        return home
    return None


def load_inventory():
    path = _find_inventory()
    if not path:
        return {}
    with open(path) as f:
        return json.load(f)


def resolve_cred(sw, inv):
    user = sw.get("user") or inv.get("defaults", {}).get("user", "admin")
    if "password" in sw:
        return user, sw["password"]
    cref = sw.get("cred")
    if cref:
        c = inv.get("credentials", {}).get(cref, {})
        user = c.get("user", user)
        if "password" in c:
            return user, c["password"]
        if "password_env" in c:
            pw = os.environ.get(c["password_env"])
            if pw is None:
                raise SystemExit(f"env {c['password_env']} nicht gesetzt "
                                 f"(credential {cref})")
            return user, pw
        if "password_file" in c:
            p = os.path.expanduser(c["password_file"])
            with open(p) as f:
                return user, f.read().strip()
    return user, sw.get("password", "")


def make_target(args):
    """Target aus --swb, --ip/--mode oder Inventory-Namen bauen."""
    if args.swb:
        data = read_swb(args.swb)
        name = args.switch or os.path.basename(args.swb)
        return Target(name, "swb", swb_data=data)

    inv = load_inventory()
    if args.switch and args.switch in inv.get("switches", {}):
        sw = inv["switches"][args.switch]
        user, pw = resolve_cred(sw, inv)
        return Target(args.switch, sw.get("mode", "direct"),
                      ip=sw.get("ip"), user=user, password=pw,
                      jump=sw.get("jump"))
    # ad-hoc
    if args.ip:
        return Target(args.switch or args.ip, args.mode or "direct",
                      ip=args.ip, user=args.user or "admin",
                      password=args.password or "", jump=args.jump)
    raise SystemExit("Kein Ziel: Inventory-Name, --ip oder --swb angeben "
                     "(swos list zeigt das Inventory).")


