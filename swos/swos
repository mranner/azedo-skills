def _wf(target, endpoint):
    """Schreib-Feldtabelle des Endpoints fuer den Dialekt des Targets."""
    return WRITE_FIELDS[target._dialect][endpoint]


def _wf_post(target, endpoint):
    """Zu postender Feld-Subset. Bei CSS106-PoE-Modell schliesst link.b zusaetzlich
    die PoE-Felder (poe/prio) ein — genau wie die SwOS-UI sie sendet."""
    wf = _wf(target, endpoint)
    if (endpoint == "link.b" and target._link_has_poe and "post_poe" in wf):
        return wf["post_poe"]
    return wf["post"]

PORTNAME_MAX = 16    # konservativ; Read-back-Verify faengt Ueberlauf/Trunkierung ab


def _blob_hex(v):
    # Byte-aligned: gerade Anzahl Hex-Ziffern, wie die SwOS-Web-UI sendet. Der
    # Switch-Parser liest Hex bytewise; ungerade Breite (z.B. "0x3ff") wird
    # falsch interpretiert (0x3ff -> 0x3f = 63) und warf im Test die
    # link.b-Enabled-Maske um. Werte 0..0xff bleiben 2-stellig wie bisher. CR4426.
    h = f"{int(v):x}"
    if len(h) % 2:
        h = "0" + h
    return "0x" + h


def _blob_arr(vals):
    return "[" + ",".join(_blob_hex(v) for v in vals) + "]"


def _ser(v):
    """Serialisiert einen geparsten Blob-Wert zurueck ins SwOS-Format
    (dict/list/int/quoted-hex-string) — genau wie die SwOS-UI ihn sendet."""
    if isinstance(v, list):
        return "[" + ",".join(_ser(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{" + ",".join(f"{k}:{_ser(x)}" for k, x in v.items()) + "}"
    if isinstance(v, str):
        return "'" + v + "'"          # Quoted-Hex-String (vom Parser roh gehalten)
    if isinstance(v, int):
        return _blob_hex(v)
    raise SystemExit(f"nicht serialisierbarer Wert: {v!r}")


def _norm(v):
    """Vergleichsnormalform: Hex-Strings case-insensitiv."""
    if isinstance(v, list):
        return [_norm(x) for x in v]
    if isinstance(v, dict):
        return {k: _norm(x) for k, x in v.items()}
    if isinstance(v, str):
        return v.lower()
    return v


def _snapshot_dir():
    """Ablageort fuer Snapshots. Praezedenz:
      1. SWOS_SNAPSHOT_DIR (explizit),
      2. <cwd>/.tmp (Projekt-lokal, dokumentiert),
      3. ~/.cache/swos als Fallback — falls cwd im Skill-Verzeichnis liegt
         (Konvention: Temp gehoert ins Projekt-.tmp, NIE ins $SKILL_DIR).
    So landet der Snapshot nie im Skill-Verzeichnis, egal von wo aufgerufen."""
    override = os.environ.get("SWOS_SNAPSHOT_DIR")
    if override:
        d = os.path.abspath(os.path.expanduser(override))
    else:
        skill_dirs = {os.path.dirname(os.path.abspath(__file__)),
                      os.path.dirname(os.path.realpath(__file__))}
        cwd = os.path.abspath(os.getcwd())
        in_skill = cwd in skill_dirs or any(
            cwd.startswith(s + os.sep) for s in skill_dirs)
        d = (os.path.join(os.path.expanduser("~"), ".cache", "swos")
             if in_skill else os.path.join(cwd, ".tmp"))
    os.makedirs(d, exist_ok=True)
    return d


def _snapshot_once(target):
    """Zieht einmalig ein .swb als Rollback-Punkt — nur wenn fuer diesen Switch
    noch keiner existiert ('vor der ersten Aenderung'). Ablage: _snapshot_dir()."""
    path = os.path.join(_snapshot_dir(), f"swos-snapshot-{target.name}.swb")
    if os.path.exists(path):
        return path, False
    data = target.fetch_backup_bytes()
    if not data:
        raise SystemExit(f"[{target.name}] Snapshot fehlgeschlagen (leeres .swb) — "
                         "Write abgebrochen, kein Rollback-Netz")
    with open(path, "wb") as f:
        f.write(data)
    return path, True


def _write_guard(args, cmd, endpoint):
    """Gemeinsame Guard-Rails: nur writable Inventory-Switch, nur Dialekte mit
    verifiziertem Schreibpfad, und der geforderte `endpoint` muss fuer diesen
    Dialekt freigegeben sein. Legt den erkannten Dialekt am Target ab
    (`target._dialect`) und liefert das Target."""
    if args.swb:
        raise SystemExit(f"{cmd}: --swb ist offline, kein Schreibziel.")
    inv = load_inventory()
    sw = inv.get("switches", {}).get(args.switch or "")
    if sw is None:
        raise SystemExit(f"{cmd}: '{args.switch}' nicht im Inventory — Schreibzugriff "
                         "nur auf freigegebene Inventory-Switches.")
    if not sw.get("writable"):
        raise SystemExit(f"{cmd}: '{args.switch}' ist nicht als writable markiert "
                         "(Inventory-Flag \"writable\": true fehlt). Schreibzugriff nur "
                         "auf freigegebenen Sandkasten-Switches.")
    target = make_target(args)
    sysobj = target.get("sys.b")
    if not isinstance(sysobj, dict):
        raise SystemExit(f"[{target.name}] sys.b nicht lesbar")
    dia = detect_dialect(sysobj)
    if dia not in WRITABLE_DIALECTS:
        raise SystemExit(f"{cmd}: Write-Format fuer Dialekt '{dia}' nicht verifiziert "
                         f"('{target.name}'). Erst per DevTools/HAR-Capture verifizieren "
                         f"(verfuegbar: {', '.join(sorted(WRITABLE_DIALECTS))}).")
    # Dialekt-abhaengiger Ziel-Endpoint: PoE liegt bei css610 in poe.b, bei CSS106
    # in link.b. `endpoint` kann daher ein {dialekt: endpoint}-Mapping sein.
    if isinstance(endpoint, dict):
        endpoint = endpoint.get(dia)
        if endpoint is None:
            raise SystemExit(f"{cmd}: auf Dialekt '{dia}' nicht verfuegbar "
                             f"('{target.name}').")
    if endpoint not in WRITE_FIELDS[dia]:
        raise SystemExit(f"{cmd}: Endpoint {endpoint} auf Dialekt '{dia}' noch nicht "
                         f"freigegeben ('{target.name}').")
    target._dialect = dia
    target._endpoint = endpoint
    # CSS106: PoE-Felder (poe/prio) nur beim PoE-Modell in link.b. engine.js gated
    # das exakt auf Board "CSS106-1G-4P-1S" (Marker "-4P-").
    model = (hexascii(sysobj.get("brd")) or "").upper()
    target._link_has_poe = (dia == "swos_lite" and "-4P-" in model)
    return target


def _post_subset(target, endpoint, width=None):
    """Aktuellen GET lesen und den schreibbaren Feld-Subset (WRITE_FIELDS "post")
    des Dialekts als frische Kopie zurueckgeben. `width` schneidet Array-Felder
    ab (poe.b: 8)."""
    cur = target.get(endpoint)
    if not isinstance(cur, dict):
        raise SystemExit(f"[{target.name}] {endpoint} nicht lesbar")
    post = {}
    for f in _wf_post(target, endpoint):
        if f not in cur:
            raise SystemExit(f"[{target.name}] {endpoint}: Feld {f} fehlt im aktuellen Blob")
        v = cur[f]
        if isinstance(v, list):
            v = list(v)[:width] if width else list(v)
        post[f] = v
    return cur, post


def _verify_subset(back, expected, width=None):
    """Read-back gegen den gesendeten Subset pruefen: jedes gepostete Feld muss
    exakt so zurueckkommen (nur Config-Felder, keine Runtime-Counter)."""
    if not isinstance(back, dict):
        return False, "kein Objekt zurueck"
    for f, ev in expected.items():
        bv = back.get(f)
        if width is not None and isinstance(ev, list) and isinstance(bv, list):
            bv = bv[:width]
        if _norm(bv) != _norm(ev):
            return False, f"{f}: read-back {bv} != erwartet {ev}"
    return True, ""


def _commit_write(target, endpoint, payload, describe, args, ok_msg,
                  width=None, verify_fn=None):
    """Dry-run/Commit-Pfad: Anzeige -> (bei --commit) Snapshot -> POST ->
    Read-back-Verify. `payload` = zu postender Wert (dict oder list)."""
    body = _ser(payload)
    for line in describe:
        print(line)
    print(f"  POST-Body   : {body}")
    if not args.commit:
        print("\n  DRY-RUN — nichts gesendet. Zum Ausfuehren --commit anhaengen.")
        return
    snap, fresh = _snapshot_once(target)
    print(f"\n  Snapshot    : {snap}" +
          ("  (neu gezogen)" if fresh else "  (bereits vorhanden)"))
    target.post_blob(endpoint, body)
    print("  POST        : gesendet")
    target._cache.pop(endpoint, None)
    back = target.get(endpoint)
    if verify_fn is not None:
        ok, why = verify_fn(back)
    else:
        ok, why = _verify_subset(back, payload, width)
    if ok:
        print(f"  Verify      : OK — {ok_msg}")
    else:
        print(f"  Verify      : FEHLGESCHLAGEN — {why}")
        raise SystemExit(f"[{target.name}] Read-back-Verify fehlgeschlagen — Zustand "
                         f"pruefen, ggf. Snapshot zurueckspielen: {snap}")


def _port_in_range(cmd, port, n, extra=""):
    if not (1 <= port <= n):
        raise SystemExit(f"{cmd}: Port {port} ungueltig (1..{n}{extra}).")


def cmd_poe_out(args):
    # Endpoint/Enum/Portbereich divergieren je Dialekt: css610 -> poe.b i01,
    # CSS106 -> link.b poe (anderes Enum, nur Ports 2..5, nur PoE-Modell).
    ep_map = {d: s["endpoint"] for d, s in POE_OUT_SPEC.items()}
    target = _write_guard(args, "poe-out", ep_map)
    dia = target._dialect
    spec = POE_OUT_SPEC[dia]
    ep, enum, width = spec["endpoint"], spec["enum"], spec["width"]
    if dia == "swos_lite" and not target._link_has_poe:
        raise SystemExit(f"poe-out: '{target.name}' ist kein PoE-Modell "
                         "(nur CSS106-1G-4P-1S fuehrt PoE) — Abbruch.")
    if args.mode not in enum:
        raise SystemExit(f"poe-out: Modus '{args.mode}' auf Dialekt '{dia}' ungueltig "
                         f"(erlaubt: {', '.join(enum)}).")
    names = {v: k for k, v in enum.items()}
    fld = _wf(target, ep)["poe_out"]
    cur, post = _post_subset(target, ep, width=width)
    arr = list(post[fld])
    if spec["ports"]:
        lo, hi = spec["ports"]
        if not (lo <= args.port <= hi):
            raise SystemExit(f"poe-out: Port {args.port} ungueltig (nur PoE-Ports "
                             f"{lo}..{hi}; Port 1 Uplink / Port 6 SFP haben kein PoE).")
    else:
        _port_in_range("poe-out", args.port, len(arr), "; SFP-Ports haben kein PoE")
    tv = enum[args.mode]
    cur_val = arr[args.port - 1]
    arr[args.port - 1] = tv
    post[fld] = arr
    cur_arr = cur[fld][:width] if width else cur[fld]
    describe = [
        f"# {target.name}  PoE Out  Port {args.port}: "
        f"{names.get(cur_val, hex(cur_val))} -> {args.mode}",
        f"  {fld} aktuell : {_blob_arr(cur_arr)}",
        f"  {fld} geplant : {_blob_arr(arr)}",
    ]
    if cur_val == tv:
        describe.append("  (keine Aenderung — Port steht bereits auf diesem Modus)")
    _commit_write(target, ep, post, describe, args,
                  f"Port {args.port} jetzt '{args.mode}', sonst unveraendert.", width=width)


