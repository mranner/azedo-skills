    _port_in_range(cmd, args.port, len(arr))
    tv = modes[args.to]
    old = arr[args.port - 1]
    changes = old != tv
    lnkf = _wf(target, "link.b")["link"]
    lnk = (target.get("link.b") or {}).get(lnkf, 0)
    has_link = bool((lnk >> (args.port - 1)) & 1)
    if changes and has_link and not args.force and args.commit:
        raise SystemExit(f"{cmd}: Port {args.port} hat aktuell LINK — Aenderung nur mit --force "
                         "(VLAN-Filterung kann den Zugriff kappen, evtl. Mgmt-/Uplink-Port).")
    arr[args.port - 1] = tv
    post[field] = arr
    warn = "  [LINK aktiv!]" if (changes and has_link) else ""
    describe = [
        f"# {target.name}  {label}  Port {args.port}: "
        f"{names.get(old, old)} -> {args.to}{warn}",
        f"  {field} aktuell : {_blob_arr(cur[field])}",
        f"  {field} geplant : {_blob_arr(arr)}",
    ]
    _commit_write(target, "fwd.b", post, describe, args,
                  f"Port {args.port} {label} = {args.to}, sonst unveraendert.")


