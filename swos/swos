def _emit(args, rep, which):
    if args.json:
        print(json.dumps(rep, indent=2, ensure_ascii=False))
        return
    portnames = [p["port"] for p in rep["ports"]]
    if which in ("sys", "all"):
        print_sys(rep)
    if which in ("vlan", "all"):
        if which == "all":
            print("\nVLANs:")
        print_vlans(rep, portnames)
    if which in ("ports", "all"):
        if which == "all":
            print("\nPorts (PVID / PoE):")
        print_ports(rep)
    if which in ("hosts", "all"):
        if which == "all":
            print("\nFDB (MAC -> Port):")
        print_fdb(rep)


def cmd_view(args, which):
    target = make_target(args)
    rep = build_report(target)
    _emit(args, rep, which)


def cmd_raw(args):
    target = make_target(args)
    val = target.get(args.endpoint)
    print(json.dumps(val, indent=2, ensure_ascii=False))


def cmd_backup(args):
    target = make_target(args)
    data = target.fetch_backup_bytes()
    if not data:
        raise SystemExit(f"[{target.name}] backup: leere Antwort "
                         "(Endpoint existiert vermutlich nicht auf diesem Modell)")
    path = args.output or f"{target.name}.swb"
    with open(path, "wb") as f:
        f.write(data)
    print(f"Backup gespeichert: {path} ({len(data)} Bytes)")
    print("Achtung: .swb enthaelt das Digest-Passwort hex-kodiert (.pwd.b) -- "
          "nicht unbedacht weitergeben/anhaengen.")


