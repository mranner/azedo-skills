def _first(sysobj, spec):
    """spec = str (ein Key) oder tuple (Keys der Reihe nach)."""
    if spec is None:
        return None
    if isinstance(spec, str):
        return sysobj.get(spec)
    for k in spec:
        if k in sysobj:
            return sysobj[k]
    return None


# ---------------------------------------------------------------------------
# Transporte — liefern den geparsten Blob eines Endpoints (oder None)
# ---------------------------------------------------------------------------

READ_ENDPOINTS = ["sys.b", "link.b", "vlan.b", "fwd.b", "poe.b", "!dhost.b"]


class Target:
    """Zugriffsobjekt: entweder live (direct/ssh-curl) oder offline (swb)."""

    def __init__(self, name, mode, ip=None, user="admin", password="",
                 jump=None, swb_data=None, timeout=8):
        self.name = name
        self.mode = mode
        self.ip = ip
        self.user = user
        self.password = password
        self.jump = jump
        self.swb_data = swb_data or {}
        self.timeout = timeout
        self._cache = {}
        self._dialect = None       # von _write_guard gesetzt (Schreibpfad)
        self._endpoint = None      # ggf. dialekt-aufgeloester Ziel-Endpoint
        self._link_has_poe = False # swos_lite: PoE-Felder in link.b (PoE-Modell)

    def get(self, endpoint):
        if endpoint in self._cache:
            return self._cache[endpoint]
        if self.mode == "swb":
            val = self.swb_data.get(endpoint)
        elif self.mode == "direct":
            val = self._fetch_direct(endpoint)
        elif self.mode == "ssh-curl":
            val = self._fetch_sshcurl(endpoint)
        else:
            raise SystemExit(f"unknown mode: {self.mode}")
        self._cache[endpoint] = val
        return val

    def _fetch_direct(self, endpoint):
        url = f"http://{self.ip}/{endpoint}"
        mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
        mgr.add_password(None, f"http://{self.ip}/", self.user, self.password)
        opener = urllib.request.build_opener(
            urllib.request.HTTPDigestAuthHandler(mgr))
        try:
            with opener.open(url, timeout=self.timeout) as resp:
                body = resp.read().decode("latin-1", errors="replace")
        except (urllib.error.URLError, OSError) as exc:
            raise SystemExit(f"[{self.name}] direct {endpoint}: {exc}")
        return parse_blob(body)                # None bei 303/HTML

    def _fetch_sshcurl(self, endpoint):
        # Passwort kann '$' enthalten -> auf dem Jump als Script an `sh` pipen,
        # Passwort/URL dort single-quoten (kein !-Escaping noetig).
        pw = self.password.replace("'", "'\\''")
        url = f"http://{self.ip}/{endpoint}"
        script = (f"curl -s -m {self.timeout} --digest "
                  f"-u 'admin:{pw}' '{url}'\n")
        cmd = ["sudo", "ssh", "-C", f"root@{self.jump}", "sh"]
        try:
            proc = subprocess.run(cmd, input=script, capture_output=True,
                                  text=True, timeout=self.timeout + 15)
        except subprocess.TimeoutExpired:
            raise SystemExit(f"[{self.name}] ssh-curl {endpoint}: timeout")
        if proc.returncode != 0:
            raise SystemExit(f"[{self.name}] ssh-curl {endpoint}: "
                             f"{proc.stderr.strip() or 'exit ' + str(proc.returncode)}")
        return parse_blob(proc.stdout)

    def fetch_backup_bytes(self):
        """GET /backup.swb roh (keine Blob-Parse -- Inhalt ist selbst ein
        .swb-Container mehrerer Endpoints). Reines Lesen, kein Schreibzugriff
        auf den Switch."""
        if self.mode == "swb":
            raise SystemExit(f"[{self.name}] backup: --swb ist bereits ein "
                             "Backup, kein Live-Ziel")
        if self.mode == "direct":
            url = f"http://{self.ip}/backup.swb"
            mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
            mgr.add_password(None, f"http://{self.ip}/", self.user, self.password)
            opener = urllib.request.build_opener(
                urllib.request.HTTPDigestAuthHandler(mgr))
            try:
                with opener.open(url, timeout=self.timeout) as resp:
                    return resp.read()
            except (urllib.error.URLError, OSError) as exc:
                raise SystemExit(f"[{self.name}] backup: {exc}")
        if self.mode == "ssh-curl":
            pw = self.password.replace("'", "'\\''")
            url = f"http://{self.ip}/backup.swb"
            script = (f"curl -s -m {self.timeout} --digest "
                      f"-u 'admin:{pw}' '{url}'\n")
            cmd = ["sudo", "ssh", "-C", f"root@{self.jump}", "sh"]
            try:
                proc = subprocess.run(cmd, input=script.encode(),
                                      capture_output=True,
                                      timeout=self.timeout + 15)
            except subprocess.TimeoutExpired:
                raise SystemExit(f"[{self.name}] backup: timeout")
            if proc.returncode != 0:
                raise SystemExit(f"[{self.name}] backup: "
                                 f"{proc.stderr.decode(errors='replace').strip() or 'exit ' + str(proc.returncode)}")
            return proc.stdout
        raise SystemExit(f"unknown mode: {self.mode}")

    def post_blob(self, endpoint, body):
        """POST eines Config-Blobs (Stufe 2, schreibend). Bisher nur direct-Modus.
        `body` ist ein fertiger SwOS-Blob-String (Content-Type text/plain, roh —
        so, wie die SwOS-Web-UI ihn sendet). Invalidiert den Cache des Endpoints."""
        if self.mode == "swb":
            raise SystemExit(f"[{self.name}] write: --swb ist offline, kein Schreibziel")
        if self.mode != "direct":
            raise SystemExit(f"[{self.name}] write: Schreibzugriff bisher nur im "
                             "direct-Modus implementiert (nicht ssh-curl)")
        url = f"http://{self.ip}/{endpoint}"
        mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
        mgr.add_password(None, f"http://{self.ip}/", self.user, self.password)
        opener = urllib.request.build_opener(
            urllib.request.HTTPDigestAuthHandler(mgr))
        req = urllib.request.Request(
            url, data=body.encode("latin-1"),
            headers={"Content-Type": "text/plain"}, method="POST")
        try:
            with opener.open(req, timeout=self.timeout) as resp:
                out = resp.read().decode("latin-1", errors="replace")
        except urllib.error.HTTPError as exc:
            raise SystemExit(f"[{self.name}] POST {endpoint}: HTTP {exc.code} {exc.reason}")
        except (urllib.error.URLError, OSError) as exc:
            raise SystemExit(f"[{self.name}] POST {endpoint}: {exc}")
        self._cache.pop(endpoint, None)
        return out


# .swb-Backup: strings, dann jeden `<ep>:` Blob extrahieren
_EP_RE = re.compile(r"(![a-z]+\.b|[a-z]+\.b):")


def read_swb(path):
    try:
        out = subprocess.run(["strings", path], capture_output=True,
                             text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        raise SystemExit(f"strings {path}: {exc}")
    data = {}
    for m in _EP_RE.finditer(out):
        ep = m.group(1)
        start = m.end()
        # ab hier steht der Blob ({...} oder [...]); tolerant parsen
        try:
            val = _Blob(out[start:]).parse()
        except BlobError:
            continue
        data[ep] = val
    return data


