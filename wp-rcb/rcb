#!/usr/bin/env python3
# version 1.73.11

"""wp-rcb, lokale Seite: PHP-Payload für `wp eval-file -` bauen, das
ausgelieferte Frontend einer Seite lesen und zwei JSON-Ausgaben vergleichen."""

import argparse
import base64
import json
import re
import sys
import urllib.request
from pathlib import Path

PHP = Path(__file__).resolve().parent / "rcb.php"
MARKER = "$rcb_input = null;"
CODE_FIELDS = ("codeOptIn", "codeOptOut", "codeOnPageLoad")

# RCB zeigt Headless-Browsern keinen Banner, ein normaler User-Agent ist Pflicht

USER_AGENT = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
              "(KHTML, like Gecko) Chrome/131.0 Safari/537.36")

# Listen eines Exports werden über diese Schlüssel abgeglichen, nicht über die
# Position - die IDs unterscheiden sich zwischen zwei Sites immer

LIST_KEYS = {
    "cookieGroups": "slug",
    "cookies": "post_name",
    "blocker": "post_name",
    "bannerLinks": "post_name",
    "tcfVendorConfigurations": "post_name",
}
IGNORE = {"ID", "term_id", "_meta", "created"}


def cmd_php(args):
    code = PHP.read_text(encoding="utf-8")
    if args.input:
        data = Path(args.input).read_bytes()
        encoded = base64.b64encode(data).decode()
        code = code.replace(MARKER, f"$rcb_input = base64_decode('{encoded}');", 1)
    sys.stdout.write(code)


def decode(value):
    if isinstance(value, str) and value.startswith("base64-encoded:"):
        return base64.b64decode(value[15:]).decode("utf-8", "replace")
    return value


def services_in(html):
    """Dienste mit Code-Feldern aus den `*-js-extra`-Daten von RCB.

    Teile davon liegen als JSON-String im JSON (lazy geladen), deshalb wird
    jeder String, der wie JSON aussieht, mit ausgepackt."""
    found = []

    def walk(node):
        if isinstance(node, str) and node[:1] in "{[":
            try:
                node = json.loads(node)
            except ValueError:
                return
        if isinstance(node, dict):
            if "codeOptIn" in node:
                found.append(node)
            for value in node.values():
                walk(value)
        elif isinstance(node, list):
            for value in node:
                walk(value)

    for m in re.finditer(r'<script[^>]*id="[^"]*-js-extra"[^>]*>(.*?)</script>', html, re.S):
        if "codeOptIn" not in m.group(1):
            continue
        try:
            walk(json.loads(m.group(1)))
        except ValueError:
            continue
    return found


def cmd_frontend(args):
    rows = []
    for url in args.url:
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        html = urllib.request.urlopen(req, timeout=30).read().decode("utf-8", "replace")
        services = services_in(html)
        rows.append({
            "url": url,
            "rcb": bool(services),
            "services": [{
                "id": s.get("id"),
                "name": s.get("name"),
                "unique_name": s.get("uniqueName"),
                "code": {f: decode(s[f]) for f in CODE_FIELDS if s.get(f)},
            } for s in services],
        })
    if args.json:
        json.dump(rows, sys.stdout, indent=2, ensure_ascii=False)
        print()
        return
    for row in rows:
        print(row["url"] + ("" if row["rcb"] else "  (keine RCB-Daten im HTML)"))
        for s in row["services"]:
            code = ", ".join(s["code"]) or "-"
            print(f"  {s['id']:>6} {s['name'][:40]:<40} {code}")
            if args.full:
                for field, text in s["code"].items():
                    print(f"    [{field}]\n" + "\n".join("    " + line for line in text.splitlines()))


def keyed(items, key):
    return {str(i.get(key)): i for i in items if isinstance(i, dict)}


def compare(a, b, path, out):
    if isinstance(a, dict) and isinstance(b, dict):
        for k in sorted(set(a) | set(b)):
            if k in IGNORE:
                continue
            sub = f"{path}.{k}" if path else k
            if k not in a:
                out.append((sub, "fehlt in A", b[k]))
            elif k not in b:
                out.append((sub, a[k], "fehlt in B"))
            elif k in LIST_KEYS and isinstance(a[k], list) and isinstance(b[k], list):
                compare(keyed(a[k], LIST_KEYS[k]), keyed(b[k], LIST_KEYS[k]), sub, out)
            else:
                compare(a[k], b[k], sub, out)
    elif a != b:
        out.append((path, a, b))


def short(value):
    text = json.dumps(value, ensure_ascii=False) if not isinstance(value, str) else value
    return text if len(text) <= 70 else text[:67] + "..."


def cmd_diff(args):
    a = json.loads(Path(args.a).read_text(encoding="utf-8"))
    b = json.loads(Path(args.b).read_text(encoding="utf-8"))
    # Schreibbefehle liefern den Export unter "backup"
    a, b = a.get("backup", a), b.get("backup", b)
    out = []
    compare(a, b, "", out)
    if args.json:
        json.dump([{"path": p, "a": x, "b": y} for p, x, y in out], sys.stdout, indent=2, ensure_ascii=False)
        print()
        return
    for p, x, y in out:
        print(f"{p}\n  A: {short(x)}\n  B: {short(y)}")
    print(f"\n{len(out)} Unterschiede")


def main():
    ap = argparse.ArgumentParser(prog="rcb", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("php", help="rcb.php ausgeben, optional mit Eingabedatei")
    sp.add_argument("--input", "-i", help="Datei, die rcb.php als $rcb_input erhält")
    sp.set_defaults(func=cmd_php)

    sp = sub.add_parser("frontend", help="ausgelieferte Dienste und Code-Felder einer Seite")
    sp.add_argument("url", nargs="+")
    sp.add_argument("--full", action="store_true", help="Code-Felder im Klartext ausgeben")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_frontend)

    sp = sub.add_parser("diff", help="zwei Exporte oder settings-Ausgaben vergleichen")
    sp.add_argument("a")
    sp.add_argument("b")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_diff)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
