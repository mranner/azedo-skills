#!/usr/bin/env python3

# Jira REST API helper (multi-instance): Data Center/Server (v2, Bearer-PAT)
# und Cloud (*.atlassian.net, v3, Basic email:token, ADF-Bodies)
# stdlib only, no pip dependencies
# version 1.33.0

import argparse
import base64
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from collections import namedtuple

SKILL_DIR = os.path.dirname(os.path.realpath(__file__))

# Aufgeloeste Instanz: name + host + Cloud-Flag + fertiger Authorization-Header
Instance = namedtuple("Instance", "name host is_cloud auth")


def config_path():
    override = os.environ.get("JIRA_CONFIG")
    if override:
        return override
    return os.path.join(os.path.expanduser("~"), ".claude", "jira.json")


CONFIG_FILE = config_path()
_config = None


def load_config():
    """Read ~/.claude/jira.json (cached)"""
    global _config
    if _config is not None:
        return _config
    if not os.path.exists(CONFIG_FILE):
        print(
            f"Error: {CONFIG_FILE} nicht gefunden (siehe jira.json.example)",
            file=sys.stderr,
        )
        sys.exit(1)
    try:
        with open(CONFIG_FILE) as f:
            cfg = json.load(f)
    except (OSError, ValueError) as e:
        print(f"Error: {CONFIG_FILE} nicht lesbar: {e}", file=sys.stderr)
        sys.exit(1)
    if not isinstance(cfg.get("instances"), dict) or not cfg["instances"]:
        print(f"Error: keine 'instances' in {CONFIG_FILE}", file=sys.stderr)
        sys.exit(1)
    _config = cfg
    return cfg


def list_instances():
    """Return configured instance names (as written in config)"""
    return list(load_config()["instances"].keys())


def _project_of_key(key):
    """CORTAB-1760 -> CORTAB"""
    if key and "-" in key:
        return key.split("-", 1)[0].upper()
    return None


def _project_of_jql(jql):
    """Best-effort: pull the first 'project = X' / 'project in (X, ...)' from a JQL"""
    if not jql:
        return None
    m = re.search(
        r'project\s*(?:=|in)\s*\(?\s*["\']?([A-Za-z][A-Za-z0-9_]+)',
        jql,
        re.IGNORECASE,
    )
    return m.group(1).upper() if m else None


def _instance_for_project(cfg, project):
    """Find the instance whose 'projects' list contains project (case-insensitive)"""
    if not project:
        return None
    for name, inst in cfg["instances"].items():
        projects = [p.upper() for p in inst.get("projects", [])]
        if project in projects:
            return name
    return None


def _is_cloud(host, inst):
    """Cloud, wenn type=cloud gesetzt ist oder der Host auf .atlassian.net endet"""
    if (inst.get("type") or "").lower() == "cloud":
        return True
    return host.lower().endswith(".atlassian.net")


def resolve_instance(name, project_hint=None):
    """Map (explicit name | project routing | default) to an Instance"""
    cfg = load_config()

    if not name:
        name = _instance_for_project(cfg, project_hint)
    if not name:
        name = cfg.get("default")
    if not name:
        print(
            "Error: keine Instanz bestimmbar (kein --instance, kein Projekt-Match, "
            "kein 'default' in der Config)",
            file=sys.stderr,
        )
        sys.exit(1)

    inst = cfg["instances"].get(name)
    if inst is None:
        # case-insensitive fallback
        for k, v in cfg["instances"].items():
            if k.lower() == str(name).lower():
                name, inst = k, v
                break
    if inst is None:
        avail = ", ".join(list_instances()) or "(keine)"
        print(
            f"Error: Instanz '{name}' unbekannt. Verfuegbar: {avail}", file=sys.stderr
        )
        sys.exit(1)

    host = inst.get("host")
    token = inst.get("token")
    if not host or not token:
        print(
            f"Error: Instanz '{name}' ohne host/token in {CONFIG_FILE}",
            file=sys.stderr,
        )
        sys.exit(1)
    host = host.rstrip("/")

    cloud = _is_cloud(host, inst)
    if cloud:
        email = inst.get("email")
        if not email:
            print(
                f"Error: Cloud-Instanz '{name}' braucht 'email' in {CONFIG_FILE} "
                "(Basic-Auth email:token)",
                file=sys.stderr,
            )
            sys.exit(1)
        auth = "Basic " + base64.b64encode(f"{email}:{token}".encode()).decode()
    else:
        auth = f"Bearer {token}"

    return Instance(name, host, cloud, auth)


def api_call(inst, method, path, data=None, params=None):
    """HTTP request an die Jira REST API (v2 fuer DC, v3 fuer Cloud)"""
    ver = "3" if inst.is_cloud else "2"
    url = f"{inst.host}/rest/api/{ver}/{path.lstrip('/')}"

    if params:
        qs = urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
        if qs:
            url += f"?{qs}"

    body = json.dumps(data).encode("utf-8") if data is not None else None
    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Authorization": inst.auth,
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
        method=method,
    )

    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            return json.loads(raw.decode("utf-8")) if raw else None
    except urllib.error.HTTPError as e:
        err = e.read().decode("utf-8", errors="replace")
        print(f"API error {e.code}: {err}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Verbindungsfehler: {e.reason}", file=sys.stderr)
        sys.exit(1)


def api_upload(inst, path, filepath):
    """Multipart-Upload (Datei-Anhang). Braucht X-Atlassian-Token: no-check (DC + Cloud)"""
    ver = "3" if inst.is_cloud else "2"
    url = f"{inst.host}/rest/api/{ver}/{path.lstrip('/')}"
    fname = os.path.basename(filepath)
    with open(filepath, "rb") as f:
        content = f.read()

    boundary = "----jira" + uuid.uuid4().hex
    body = b"".join(
        [
            (f"--{boundary}\r\n").encode(),
            (
                f'Content-Disposition: form-data; name="file"; filename="{fname}"\r\n'
            ).encode(),
            b"Content-Type: application/octet-stream\r\n\r\n",
            content,
            (f"\r\n--{boundary}--\r\n").encode(),
        ]
    )
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={
            "Authorization": inst.auth,
            "X-Atlassian-Token": "no-check",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            return json.loads(raw.decode("utf-8")) if raw else None
    except urllib.error.HTTPError as e:
        err = e.read().decode("utf-8", errors="replace")
        print(f"API error {e.code}: {err}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Verbindungsfehler: {e.reason}", file=sys.stderr)
        sys.exit(1)


class _StripAuthOnRedirect(urllib.request.HTTPRedirectHandler):
    """Beim Redirect auf einen fremden Host den Authorization-Header entfernen.
    Jira-Attachment-Downloads antworten mit 302 auf Media/S3 — der Bearer/Basic-
    Header wuerde dort abgelehnt."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        newreq = super().redirect_request(req, fp, code, msg, headers, newurl)
        if newreq is not None:
            same_host = (
                urllib.parse.urlparse(newurl).netloc
                == urllib.parse.urlparse(req.full_url).netloc
            )
            if not same_host:
                for h in list(newreq.headers):
                    if h.lower() == "authorization":
                        del newreq.headers[h]
        return newreq


def api_download(inst, content_url, output_path):
    """Anhang-Inhalt von der content-URL laden (folgt dem 302 ohne Auth-Leak)"""
    req = urllib.request.Request(content_url, headers={"Authorization": inst.auth})
    opener = urllib.request.build_opener(_StripAuthOnRedirect)
    try:
        with opener.open(req) as resp:
            data = resp.read()
    except urllib.error.HTTPError as e:
        err = e.read().decode("utf-8", errors="replace")
        print(f"API error {e.code}: {err}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Verbindungsfehler: {e.reason}", file=sys.stderr)
        sys.exit(1)
    with open(output_path, "wb") as f:
        f.write(data)
    return len(data)


def out_json(data):
    print(json.dumps(data, indent=2, ensure_ascii=False))


# ---- ADF (Cloud) <-> Plaintext -------------------------------------------
#
# Cloud liefert Beschreibungen und Kommentar-Bodies als ADF (Atlassian Document
# Format, verschachteltes JSON) und erwartet sie auch so beim Schreiben. DC nutzt
# an denselben Stellen Plaintext/Wiki-Markup. Diese zwei Helfer ueberbruecken das.

_ADF_BLOCK = {
    "paragraph",
    "heading",
    "blockquote",
    "codeBlock",
    "listItem",
    "rule",
    "panel",
    "mediaSingle",
}


def adf_to_text(node):
    """ADF-Knoten best-effort zu Plaintext verflachen (fuer die Anzeige)"""
    if node is None:
        return ""
    if isinstance(node, str):
        return node
    if isinstance(node, list):
        return "".join(adf_to_text(n) for n in node)
    if not isinstance(node, dict):
        return str(node)

    t = node.get("type")
    if t == "text":
        return node.get("text", "")
    if t == "hardBreak":
        return "\n"
    attrs = node.get("attrs") or {}
    if t == "mention":
        # attrs.text enthaelt i.d.R. bereits das fuehrende '@'
        label = attrs.get("text") or attrs.get("displayName") or ""
        return label if label.startswith("@") else "@" + label
    if t == "emoji":
        return attrs.get("text") or attrs.get("shortName") or ""

    inner = adf_to_text(node.get("content"))
    if t in _ADF_BLOCK:
        return inner + "\n"
    return inner


def text_to_adf(text):
    """Plaintext zu einem minimalen ADF-Dokument (fuer Cloud-Writes)"""
    paras = []
    for line in text.split("\n"):
        if line == "":
            paras.append({"type": "paragraph", "content": []})
        else:
            paras.append(
                {"type": "paragraph", "content": [{"type": "text", "text": line}]}
            )
    if not paras:
        paras = [{"type": "paragraph", "content": []}]
    return {"type": "doc", "version": 1, "content": paras}


def render_body(inst, value):
    """Body-Wert (Beschreibung/Kommentar) fuer die Anzeige zu Text machen"""
    if isinstance(value, (dict, list)):
        return adf_to_text(value).strip()
    return value


def comment_body_payload(inst, text):
    """Body im richtigen Format: ADF fuer Cloud, Plaintext fuer DC"""
    return text_to_adf(text) if inst.is_cloud else text


def _field(issue, *keys, default="-"):
    """Safely walk nested fields, returning default on any missing/None step"""
    cur = issue.get("fields", {})
    for k in keys:
        if not isinstance(cur, dict):
            return default
        cur = cur.get(k)
        if cur is None:
            return default
    return cur


def fmt_issue_row(issue):
    key = issue.get("key", "?")
    status = _field(issue, "status", "name")
    assignee = _field(issue, "assignee", "displayName")
    summary = _field(issue, "summary", default="")
    return f"{key:<16} {status:<16} {assignee:<22} {summary}"


# ---- subcommands ---------------------------------------------------------


def cmd_instances(args):
    cfg = load_config()
    default = cfg.get("default", "")
    for name, inst in cfg["instances"].items():
        host = inst.get("host", "?")
        kind = "cloud" if _is_cloud(host.rstrip("/"), inst) else "dc"
        projects = ", ".join(inst.get("projects", [])) or "-"
        mark = "  (default)" if name == default else ""
        print(f"{name:<12} {host:<32} [{kind:<5}] projects: {projects}{mark}")


def cmd_search(args):
    inst = resolve_instance(args.instance, _project_of_jql(args.jql))

    if inst.is_cloud:
        # Cloud: /search/jql loest den 2025 entfernten /search-Endpoint ab.
        # Token-basierte Paginierung (nextPageToken) statt startAt, kein 'total'.
        result = api_call(
            inst,
            "GET",
            "search/jql",
            params={
                "jql": args.jql,
                "maxResults": args.max,
                "fields": args.fields,
                "nextPageToken": args.token,
            },
        )
        if args.json:
            out_json(result)
            return
        issues = result.get("issues", [])
        for issue in issues:
            print(fmt_issue_row(issue))
        next_tok = result.get("nextPageToken")
        msg = f"\n[{inst.name}] {len(issues)} Treffer"
        if next_tok and not result.get("isLast"):
            msg += f" -- weiter mit --token {next_tok}"
        print(msg, file=sys.stderr)
        return

    result = api_call(
        inst,
        "GET",
        "search",
        params={
            "jql": args.jql,
            "maxResults": args.max,
            "startAt": args.start,
            "fields": args.fields,
        },
    )
    if args.json:
        out_json(result)
        return
    issues = result.get("issues", [])
    total = result.get("total", len(issues))
    for issue in issues:
        print(fmt_issue_row(issue))
    shown = args.start + len(issues)
    print(f"\n[{inst.name}] {len(issues)} von {total} (bis #{shown})", file=sys.stderr)


def cmd_issue(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    result = api_call(inst, "GET", f"issue/{args.key}", params={"fields": args.fields})
    if args.json:
        out_json(result)
        return
    print(f"{result.get('key')}: {_field(result, 'summary', default='')}")
    print(f"  Status:    {_field(result, 'status', 'name')}")
    print(f"  Typ:       {_field(result, 'issuetype', 'name')}")
    print(f"  Assignee:  {_field(result, 'assignee', 'displayName')}")
    print(f"  Reporter:  {_field(result, 'reporter', 'displayName')}")
    print(f"  Prioritaet: {_field(result, 'priority', 'name')}")
    desc = render_body(inst, _field(result, "description", default=""))
    if desc and desc != "-":
        print("\n--- Beschreibung ---")
        print(desc)


def cmd_comments(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    result = api_call(inst, "GET", f"issue/{args.key}/comment")
    if args.json:
        out_json(result)
        return
    comments = result.get("comments", [])
    for c in comments:
        author = (c.get("author") or {}).get("displayName", "?")
        created = c.get("created", "")[:16].replace("T", " ")
        print(f"[{created}] {author}:")
        print(render_body(inst, c.get("body", "")).rstrip())
        print()
    print(f"{len(comments)} Kommentar(e)", file=sys.stderr)


def cmd_transitions(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    result = api_call(inst, "GET", f"issue/{args.key}/transitions")
    if args.json:
        out_json(result)
        return
    for t in result.get("transitions", []):
        to = (t.get("to") or {}).get("name", "?")
        print(f"{t.get('id'):>4}  {t.get('name'):<24} -> {to}")


def cmd_comment(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    body = args.body
    if body == "-":
        body = sys.stdin.read()
    if not body or not body.strip():
        print("Error: leerer Kommentar-Body", file=sys.stderr)
        sys.exit(1)
    result = api_call(
        inst,
        "POST",
        f"issue/{args.key}/comment",
        data={"body": comment_body_payload(inst, body)},
    )
    print(f"[{inst.name}] Kommentar {result.get('id')} zu {args.key} hinzugefuegt.")


def cmd_transition(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    trans = api_call(inst, "GET", f"issue/{args.key}/transitions")
    target = args.to.strip().lower()

    match = None
    for t in trans.get("transitions", []):
        tname = (t.get("name") or "").strip().lower()
        to_status = ((t.get("to") or {}).get("name") or "").strip().lower()
        if target in (tname, to_status):
            match = t
            break

    if not match:
        avail = [
            f"{t.get('name')} (-> {(t.get('to') or {}).get('name')})"
            for t in trans.get("transitions", [])
        ]
        print(
            f"Error: kein Uebergang '{args.to}' fuer {args.key}. Moeglich: "
            + "; ".join(avail),
            file=sys.stderr,
        )
        sys.exit(1)

    to_status = (match.get("to") or {}).get("name", "?")
    if not args.yes:
        print(
            f"[dry-run/{inst.name}] {args.key}: Uebergang '{match.get('name')}' "
            f"(id {match.get('id')}) -> Status '{to_status}'.\n"
            f"Zum Ausfuehren --yes anhaengen."
        )
        return

    payload = {"transition": {"id": str(match.get("id"))}}
    if args.comment:
        payload["update"] = {
            "comment": [{"add": {"body": comment_body_payload(inst, args.comment)}}]
        }
    api_call(inst, "POST", f"issue/{args.key}/transitions", data=payload)
    print(f"[{inst.name}] {args.key}: -> '{to_status}' ausgefuehrt.")


def _assignee_ref(inst, who):
    """Assignee-Referenz: {'accountId': ...} (Cloud) / {'name': ...} (DC).
    'me' wird ueber myself aufgeloest (Cloud: accountId, DC: name/key)."""
    id_field = "accountId" if inst.is_cloud else "name"
    val = who
    if who.lower() == "me":
        me = api_call(inst, "GET", "myself")
        val = me.get("accountId") if inst.is_cloud else (me.get("name") or me.get("key"))
        if not val:
            print("Error: eigener Account nicht ermittelbar", file=sys.stderr)
            sys.exit(1)
    return {id_field: val}


def _subtask_issuetype_id(inst, project):
    """Subtask-Issuetype-ID des Projekts (Cloud: 'Unteraufgabe', DC: 'Sub-task' o.ae.)"""
    if inst.is_cloud:
        meta = api_call(inst, "GET", f"issue/createmeta/{project}/issuetypes")
        types = meta.get("issueTypes") or meta.get("values") or []
    else:
        meta = api_call(
            inst,
            "GET",
            "issue/createmeta",
            params={"projectKeys": project, "expand": "projects.issuetypes"},
        )
        projs = meta.get("projects", [])
        types = projs[0].get("issuetypes", []) if projs else []
    for it in types:
        if it.get("subtask"):
            return it.get("id")
    return None


def cmd_assign(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    id_field = "accountId" if inst.is_cloud else "name"
    if args.unassign:
        payload = {id_field: None}
        who = "(unassigned)"
    else:
        payload = _assignee_ref(inst, args.to)
        who = payload[id_field]
    api_call(inst, "PUT", f"issue/{args.key}/assignee", data=payload)
    print(f"[{inst.name}] {args.key}: Assignee -> {who}")


def cmd_describe(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    body = args.body
    if body == "-":
        body = sys.stdin.read()
    value = text_to_adf(body) if inst.is_cloud else body
    api_call(inst, "PUT", f"issue/{args.key}", data={"fields": {"description": value}})
    print(f"[{inst.name}] {args.key}: Beschreibung gesetzt.")


def cmd_subtask(args):
    inst = resolve_instance(args.instance, _project_of_key(args.parent))
    project = _project_of_key(args.parent)
    st_id = _subtask_issuetype_id(inst, project)
    if not st_id:
        print(
            f"Error: kein Subtask-Issuetype im Projekt {project} gefunden",
            file=sys.stderr,
        )
        sys.exit(1)
    fields = {
        "project": {"key": project},
        "parent": {"key": args.parent},
        "summary": args.title,
        "issuetype": {"id": st_id},
    }
    result = api_call(inst, "POST", "issue", data={"fields": fields})
    key = result.get("key")

    # Assignee separat per PUT — beim Create wird das Feld je nach Screen-Config
    # (v.a. Cloud) still ignoriert.
    who = ""
    if args.owner:
        ref = _assignee_ref(inst, args.owner)
        api_call(inst, "PUT", f"issue/{key}/assignee", data=ref)
        who = f", Assignee {list(ref.values())[0]}"
    print(f"[{inst.name}] Subtask {key} unter {args.parent} angelegt{who}.")


def cmd_attach(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    if not os.path.isfile(args.file):
        print(f"Error: Datei nicht gefunden: {args.file}", file=sys.stderr)
        sys.exit(1)
    result = api_upload(inst, f"issue/{args.key}/attachments", args.file)
    names = ", ".join(a.get("filename", "?") for a in (result or []))
    print(f"[{inst.name}] {args.key}: angehaengt -> {names}")


def cmd_attachments(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    r = api_call(inst, "GET", f"issue/{args.key}", params={"fields": "attachment"})
    atts = (r.get("fields") or {}).get("attachment") or []
    if args.json:
        out_json(atts)
        return
    for a in atts:
        created = (a.get("created", "") or "")[:16].replace("T", " ")
        author = (a.get("author") or {}).get("displayName", "?")
        print(
            f"{str(a.get('id')):>8}  {a.get('filename')}  "
            f"({a.get('size')} bytes, {a.get('mimeType')}, {created}, {author})"
        )
    print(f"{len(atts)} Anhang/Anhaenge", file=sys.stderr)


def cmd_download(args):
    inst = resolve_instance(args.instance, _project_of_key(args.key))
    r = api_call(inst, "GET", f"issue/{args.key}", params={"fields": "attachment"})
    atts = (r.get("fields") or {}).get("attachment") or []
    if args.id:
        atts = [a for a in atts if str(a.get("id")) == str(args.id)]
        if not atts:
            print(f"Error: kein Anhang {args.id} an {args.key}", file=sys.stderr)
            sys.exit(1)
    if not atts:
        print(f"[{inst.name}] {args.key}: keine Anhaenge", file=sys.stderr)
        return

    # --output: Verzeichnis -> Dateien darin; einzelne Datei nur bei genau 1 Anhang
    out_is_dir = args.output and os.path.isdir(args.output)
    single_file = args.output if (args.output and not out_is_dir and len(atts) == 1) else None
    outdir = args.output if out_is_dir else "."

    used = set()
    for a in atts:
        fname = a.get("filename") or f"attachment-{a.get('id')}"
        if single_file:
            dest = single_file
        else:
            dest = os.path.join(outdir, fname)
            # Namenskollision im selben Lauf -> ID voranstellen (kein stilles Ueberschreiben)
            if dest in used:
                dest = os.path.join(outdir, f"{a.get('id')}_{fname}")
            used.add(dest)
        n = api_download(inst, a.get("content"), dest)
        print(f"[{inst.name}] {a.get('id')} {fname} -> {dest} ({n} bytes)")


# ---- CLI -----------------------------------------------------------------


DEFAULT_FIELDS = "summary,status,assignee,updated,issuetype,priority"


def build_parser():
    p = argparse.ArgumentParser(
        prog="jira",
        description="Jira REST API helper (multi-instance): Data Center + Cloud",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_instance(sp):
        sp.add_argument(
            "-i",
            "--instance",
            help="Instanz-Name aus jira.json (ueberschreibt Projekt-Routing/Default)",
        )

    sp = sub.add_parser("instances", help="konfigurierte Instanzen auflisten")
    sp.set_defaults(func=cmd_instances)

    sp = sub.add_parser("search", help="Issues per JQL suchen")
    add_instance(sp)
    sp.add_argument("jql", help="JQL-Query, z.B. 'project = CORTAB AND status != Closed'")
    sp.add_argument("--max", type=int, default=20, help="maxResults (Default 20)")
    sp.add_argument("--start", type=int, default=0, help="startAt (DC-Paginierung)")
    sp.add_argument("--token", help="nextPageToken (Cloud-Paginierung)")
    sp.add_argument("--fields", default=DEFAULT_FIELDS, help="Feldliste (komma-getrennt)")
    sp.add_argument("--json", action="store_true", help="rohes JSON ausgeben")
    sp.set_defaults(func=cmd_search)

    sp = sub.add_parser("issue", help="einzelnes Issue anzeigen")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key, z.B. CORTAB-1762")
    sp.add_argument("--fields", default=DEFAULT_FIELDS + ",description,reporter")
    sp.add_argument("--json", action="store_true", help="rohes JSON ausgeben")
    sp.set_defaults(func=cmd_issue)

    sp = sub.add_parser("comments", help="Kommentare eines Issues anzeigen")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    sp.add_argument("--json", action="store_true", help="rohes JSON ausgeben")
    sp.set_defaults(func=cmd_comments)

    sp = sub.add_parser("transitions", help="moegliche Status-Uebergaenge anzeigen")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    sp.add_argument("--json", action="store_true", help="rohes JSON ausgeben")
    sp.set_defaults(func=cmd_transitions)

    sp = sub.add_parser("comment", help="Kommentar hinzufuegen (schreibend)")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    sp.add_argument("--body", required=True, help="Kommentartext ('-' liest von stdin)")
    sp.set_defaults(func=cmd_comment)

    sp = sub.add_parser(
        "transition", help="Status-Uebergang ausfuehren (schreibend, --yes noetig)"
    )
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    sp.add_argument(
        "--to", required=True, help="Uebergangs- ODER Ziel-Status-Name (case-insensitiv)"
    )
    sp.add_argument("--comment", help="optionaler Kommentar beim Uebergang")
    sp.add_argument("--yes", action="store_true", help="ausfuehren (ohne: nur dry-run)")
    sp.set_defaults(func=cmd_transition)

    sp = sub.add_parser("assign", help="Assignee setzen/entfernen (schreibend)")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    g = sp.add_mutually_exclusive_group(required=True)
    g.add_argument(
        "--to", help="'me' (eigener Account) ODER Cloud-accountId / DC-Username"
    )
    g.add_argument("--unassign", action="store_true", help="Assignee entfernen")
    sp.set_defaults(func=cmd_assign)

    sp = sub.add_parser("describe", help="Beschreibung setzen (schreibend)")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    sp.add_argument(
        "--body", required=True, help="Beschreibungstext ('-' liest von stdin)"
    )
    sp.set_defaults(func=cmd_describe)

    sp = sub.add_parser("subtask", help="Unteraufgabe anlegen (schreibend)")
    add_instance(sp)
    sp.add_argument("parent", help="Parent-Issue-Key, z.B. SADM-69")
    sp.add_argument("--title", required=True, help="Titel der Unteraufgabe")
    sp.add_argument(
        "--owner", help="Assignee: 'me' / accountId (Cloud) / Username (DC)"
    )
    sp.set_defaults(func=cmd_subtask)

    sp = sub.add_parser("attach", help="Datei anhaengen (schreibend)")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    sp.add_argument("--file", required=True, help="absoluter Pfad zur Datei")
    sp.set_defaults(func=cmd_attach)

    sp = sub.add_parser("attachments", help="Anhaenge eines Issues auflisten")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    sp.add_argument("--json", action="store_true", help="rohes JSON ausgeben")
    sp.set_defaults(func=cmd_attachments)

    sp = sub.add_parser("download", help="Anhaenge eines Issues herunterladen")
    add_instance(sp)
    sp.add_argument("key", help="Issue-Key")
    sp.add_argument("--id", help="nur diesen Anhang (Attachment-ID); sonst alle")
    sp.add_argument(
        "--output", help="Zielpfad: Verzeichnis, oder Dateiname (nur bei genau 1 Anhang)"
    )
    sp.set_defaults(func=cmd_download)

    return p


def main():
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
