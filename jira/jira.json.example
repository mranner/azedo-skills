{
  "default": "dc",
  "instances": {
    "dc": {
      "host": "https://jira.example.com",
      "token": "<PERSONAL_ACCESS_TOKEN>",
      "projects": ["CORTAB"]
    },
    "cloud": {
      "host": "https://example.atlassian.net",
      "type": "cloud",
      "email": "<ATLASSIAN_ACCOUNT_EMAIL>",
      "token": "<CLOUD_API_TOKEN>",
      "projects": ["SADM", "ITSD", "CSW"]
    }
  }
}
