def cmd_download_file(args):
    result = rpc_call("downloadTaskFile", {"file_id": int(args.file_id)})
    if not result:
        print(f"Error: file {args.file_id} not found or empty", file=sys.stderr)
        sys.exit(1)

    content = base64.b64decode(result)

    if args.output:
        outpath = os.path.abspath(args.output)
    else:
        tmpdir = os.path.join(os.getcwd(), ".tmp")
        os.makedirs(tmpdir, exist_ok=True)
        outpath = os.path.join(tmpdir, f"kanboard_file_{args.file_id}")

    with open(outpath, "wb") as f:
        f.write(content)
    output({"path": outpath, "size": len(content)})


