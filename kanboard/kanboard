        summary = load_instance().get("users", [])
    output(summary)


# Project administration

PROJECT_ROLES = ("project-manager", "project-member", "project-viewer")


def _check_role(role):
    if role not in PROJECT_ROLES:
        print(f"Error: invalid role '{role}' (allowed: {', '.join(PROJECT_ROLES)})", file=sys.stderr)
        sys.exit(1)


def cmd_create_project(args):
    params = {"name": args.name}
    owner_id = None
    if args.owner:
        owner_id = resolve_user(args.owner)
        params["owner_id"] = owner_id

    pid = rpc_call("createProject", params)
    if not pid:
        output({"success": False})
        return
    pid = int(pid)
    result = {"success": True, "project_id": pid, "name": args.name}

    if owner_id is not None:
        # Owner als Projekt-Manager-Mitglied fuehren (wie in bestehenden Projekten)
        rpc_try("addProjectUser", {"project_id": pid, "user_id": owner_id, "role": "project-manager"})

        # owner_id explizit setzen — createProject uebernimmt es nicht zuverlaessig.
        # updateProject verlangt den Key 'project_id' (nicht 'id')
        rpc_try("updateProject", {"project_id": pid, "owner_id": owner_id})
        result["owner_id"] = owner_id

    result["hint"] = "Neues Projekt — 'setup' ausfuehren, damit instance.json es kennt."
    output(result)


def cmd_remove_project(args):
    project_id = resolve_project(args.project)
    proj = rpc_try("getProjectById", {"project_id": project_id})
    name = proj.get("name", "") if proj else ""

    # removeProject nimmt alle Tasks mit und ist nicht umkehrbar — deshalb beide
    # Status zaehlen (status_id 1 = offen, 0 = geschlossen) und ohne --force abbrechen
    open_tasks = rpc_call("getAllTasks", {"project_id": project_id, "status_id": 1}) or []
    closed_tasks = rpc_call("getAllTasks", {"project_id": project_id, "status_id": 0}) or []
    total = len(open_tasks) + len(closed_tasks)

    if total and not args.force:
        output({
            "success": False,
            "project_id": project_id,
            "name": name,
            "open_tasks": len(open_tasks),
            "closed_tasks": len(closed_tasks),
            "error": f"Projekt enthaelt {total} Task(s) — Loeschen nimmt sie mit. "
                     "Mit --force ausfuehren, wenn das gewollt ist."
        })
        sys.exit(1)

    ok = rpc_call("removeProject", {"project_id": project_id})
    result = {
        "success": bool(ok),
        "project_id": project_id,
        "name": name,
        "removed_tasks": total,
    }
    if not ok:
        result["error"] = "removeProject lieferte kein Ergebnis — Projekt existiert nicht (mehr)?"
        output(result)
        sys.exit(1)

    result["hint"] = "Projekt entfernt — 'setup' ausfuehren, damit instance.json aktuell ist."
    output(result)


