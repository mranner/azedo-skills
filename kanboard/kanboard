def parse_cr_id(raw):
    """Normalize CR input: CR4326, cr4326, CR 4326, #4326, 4326 -> 4326"""
    s = raw.strip().lstrip("#")
    if s.lower().startswith("cr"):
        s = s[2:].strip()
    if not s.isdigit():
        print(f"Error: '{raw}' is not a valid task reference", file=sys.stderr)
        sys.exit(1)
    return int(s)


def cmd_cr(args):
    """Load one or more tasks as CR context"""
    results = []
    for raw_id in args.task_ids:
        task_id = parse_cr_id(raw_id)
        task = rpc_call("getTask", {"task_id": task_id})
        if not task:
            print(f"Error: task {task_id} not found", file=sys.stderr)
            sys.exit(1)
        results.append({
            "cr": f"CR{task_id}",
            "task_id": task_id,
            "title": task["title"],
            "project_id": int(task["project_id"]),
            "project_name": task.get("project_name", ""),
            "column": task.get("column_name", ""),
            "owner": task.get("owner_username", ""),
        })

    output(results if len(results) > 1 else results[0])


def cmd_setup(args):
    """Query instance for projects, swimlanes, columns, users and write instance.json"""
    skill_dir = os.path.dirname(os.path.abspath(__file__))
    out_path = os.path.join(skill_dir, "instance.json")

    # Detect role via getMe (fails with 403 for jsonrpc API user)
    me = rpc_try("getMe")
    if me:
        role = me.get("role", "app-user")
    else:
        role = "app-admin"
    admin = role == "app-admin"

    # Projects: admin sees all, non-admin only own
    projects_raw = rpc_call("getAllProjects") if admin else rpc_call("getMyProjects")
    projects = []
    for p in projects_raw:
        if int(p.get("is_active", 0)) != 1:
            continue
        pid = int(p["id"])
        swimlanes = rpc_call("getActiveSwimlanes", {"project_id": pid})
        columns = rpc_call("getColumns", {"project_id": pid})
        projects.append({
            "id": pid,
            "name": p["name"],
            "swimlanes": [s["name"] for s in swimlanes],
            "columns": [c["title"] for c in columns],
        })

    # Users: admin gets all, non-admin collects project members
    if admin:
        users_raw = rpc_call("getAllUsers")
        users = []
        for u in users_raw:
            if int(u.get("is_active", 0)) != 1:
                continue
            users.append({
                "id": int(u["id"]),
                "username": u["username"],
                "name": u.get("name", ""),
            })
    else:
        seen_ids = set()
        users = []
        # Own user first
        own = {"id": int(me["id"]), "username": me["username"], "name": me.get("name", me["username"])}
        users.append(own)
        seen_ids.add(own["id"])
        # Collect members from all accessible projects
        for p in projects:
            members = rpc_call("getProjectUsers", {"project_id": p["id"]})
            # getProjectUsers returns {id: username, ...}
            if isinstance(members, dict):
                for uid, uname in members.items():
                    uid = int(uid)
                    if uid not in seen_ids:
                        users.append({"id": uid, "username": uname, "name": uname})
                        seen_ids.add(uid)

    instance = {"role": role, "projects": projects, "users": users}

    if args.default_user:
        usernames = [u["username"] for u in users]
        if args.default_user not in usernames:
            print(f"Error: user '{args.default_user}' not found (available: {', '.join(usernames)})", file=sys.stderr)
            sys.exit(1)
        instance["default_user"] = args.default_user

    with open(out_path, "w") as f:
        json.dump(instance, f, indent=2, ensure_ascii=False)

    print(f"Written to {out_path}")
    output(instance)


# CLI setup

def main():
    parser = argparse.ArgumentParser(description="Kanboard JSON-RPC API helper")
    sub = parser.add_subparsers(dest="command", required=True)

    # cr (context)
    p = sub.add_parser("cr")
    p.add_argument("task_ids", nargs="+")
    p.set_defaults(func=cmd_cr)

    # setup
    p = sub.add_parser("setup")
    p.add_argument("--default-user", dest="default_user")
    p.set_defaults(func=cmd_setup)

    # create-task
    p = sub.add_parser("create-task")
    p.add_argument("--project", required=True)
    p.add_argument("--title", required=True)
    p.add_argument("--description")
    p.add_argument("--column")
    p.add_argument("--owner")
    p.add_argument("--swimlane")
    p.set_defaults(func=cmd_create_task)

    # get-task
    p = sub.add_parser("get-task")
