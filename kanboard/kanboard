#!/usr/bin/env python3

# Kanboard JSON-RPC 2.0 API helper
# stdlib only, no pip dependencies
# version 1.53.0

import argparse
import base64
import json
import os
import sys
import urllib.request
from datetime import datetime


def format_ts(ts):
    """Format a Unix timestamp as 'YYYY-MM-DD HH:MM' (local time).

    Returns '' for falsy/unparseable input so empty timestamps (Kanboard uses 0
    for 'not set') stay blank instead of showing the epoch.
    """
    if not ts:
        return ""
    try:
        return datetime.fromtimestamp(int(ts)).strftime("%Y-%m-%d %H:%M")
    except (ValueError, OSError, OverflowError):
        return ""

def _find_env():
    override = os.environ.get("KANBOARD_ENV")
    if override:
        return override
    cwd_env = os.path.join(os.getcwd(), ".env")
    if os.path.exists(cwd_env):
        return cwd_env
    return os.path.join(os.path.expanduser("~"), ".env")

ENV_FILE = _find_env()

_request_id = 0
_config = None


def load_env():
    """Read KANBOARD_URL and KANBOARD_TOKEN from .env (cached)"""
    global _config
    if _config is not None:
        return _config

    config = {}
    if not os.path.exists(ENV_FILE):
        print(f"Error: {ENV_FILE} not found", file=sys.stderr)
        sys.exit(1)
    with open(ENV_FILE) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                key, val = line.split("=", 1)
                config[key.strip()] = val.strip()
    for key in ("KANBOARD_URL", "KANBOARD_TOKEN"):
        if key not in config:
            print(f"Error: {key} not set in {ENV_FILE}", file=sys.stderr)
            sys.exit(1)

    _config = config
    return _config


def _rpc(method, params, strict):
    """Core JSON-RPC 2.0 call to Kanboard.

    strict=True  -> print a diagnostic and sys.exit(1) on any failure (rpc_call).
    strict=False -> swallow every failure and return None instead (rpc_try),
                    e.g. for optional/plugin methods that may not exist.
    """
    global _request_id
    _request_id += 1
    config = load_env()
    payload = json.dumps({
        "jsonrpc": "2.0",
        "method": method,
        "id": _request_id,
        "params": params or {}
    }).encode("utf-8")

    api_user = config.get("KANBOARD_USER", "jsonrpc")
    credentials = base64.b64encode(
        f"{api_user}:{config['KANBOARD_TOKEN']}".encode()
    ).decode()

    req = urllib.request.Request(
        config["KANBOARD_URL"],
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Basic {credentials}"
        }
    )

    try:
        with urllib.request.urlopen(req) as resp:
            body = resp.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        if not strict:
            return None
        body = e.read().decode("utf-8", errors="replace") if e.fp else ""
        print(f"HTTP {e.code}: {e.reason}", file=sys.stderr)
        if body:
            print(body[:500], file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        if not strict:
            return None
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        data = json.loads(body)
    except json.JSONDecodeError:
        if not strict:
            return None
        print(f"Error: API returned non-JSON response", file=sys.stderr)
        print(body[:500], file=sys.stderr)
        sys.exit(1)

    if "error" in data and data["error"]:
        if not strict:
            return None
        err = data["error"]
        print(f"API error: {json.dumps(err)}", file=sys.stderr)
        if isinstance(err, dict) and err.get("code") == -32601:
            print(
                "Hinweis: 'Method not found' — diese Methode wird evtl. von einem "
                "Kanboard-Plugin bereitgestellt, das nicht installiert/aktiviert ist "
                "(z.B. TaskHandoff fuer set-/get-/remove-handoff).",
                file=sys.stderr,
            )
        sys.exit(1)

    return data.get("result")


def rpc_call(method, params=None):
    """Make a JSON-RPC 2.0 call; print a diagnostic and exit on any failure."""
    return _rpc(method, params, strict=True)


def rpc_try(method, params=None):
    """Like rpc_call but returns None on any error instead of exiting."""
    return _rpc(method, params, strict=False)


# Resolver helpers

def resolve_project(project):
    """Resolve project name or ID to numeric ID"""
    if project.isdigit():
        return int(project)
    result = rpc_call("getProjectByName", {"name": project})
    if not result:
        print(f"Error: project '{project}' not found", file=sys.stderr)
        sys.exit(1)
    return int(result["id"])


def resolve_column(project_id, column_name):
    """Resolve column name to ID within a project"""
    columns = rpc_call("getColumns", {"project_id": project_id})
    for col in columns:
        if col["title"].lower() == column_name.lower():
            return int(col["id"])
    names = [c["title"] for c in columns]
    print(f"Error: column '{column_name}' not found (available: {', '.join(names)})", file=sys.stderr)
    sys.exit(1)


def resolve_user(username):
    """Resolve username to user ID via instance.json cache"""
    data = load_instance()
    for u in data.get("users", []):
        if u["username"] == username:
            return int(u["id"])
    print(f"Error: user '{username}' not found in instance.json (run: setup --default-user {username})", file=sys.stderr)
    sys.exit(1)


def resolve_swimlane(project_id, swimlane_name):
    """Resolve swimlane name to ID"""
    swimlanes = rpc_call("getActiveSwimlanes", {"project_id": project_id})
    for sl in swimlanes:
        if sl["name"].lower() == swimlane_name.lower():
            return int(sl["id"])
    names = [s["name"] for s in swimlanes]
    print(f"Error: swimlane '{swimlane_name}' not found (available: {', '.join(names)})", file=sys.stderr)
    sys.exit(1)


def resolve_link(link):
    """Resolve link label or numeric ID to a link_id via getAllLinks"""
    if str(link).isdigit():
        return int(link)
    links = rpc_call("getAllLinks")
    for l in links:
        if l.get("label", "").lower() == link.lower():
            return int(l["id"])
    labels = [l.get("label", "") for l in links]
    print(f"Error: link label '{link}' not found (available: {', '.join(labels)})", file=sys.stderr)
    sys.exit(1)


def output(data):
    """Print result as formatted JSON"""
    print(json.dumps(data, indent=2, ensure_ascii=False))


# Subcommands

def cmd_create_task(args):
    project_id = resolve_project(args.project)
    params = {
        "project_id": project_id,
        "title": args.title,
    }
    if args.description:
        params["description"] = args.description
    if args.column:
        params["column_id"] = resolve_column(project_id, args.column)

    # Owner: explizites --owner hat Vorrang, sonst Fallback auf default_user aus
    # instance.json (wie bei add-comment). Ohne beides bleibt der Task unassigned.
    owner = args.owner or get_default_user()
    if owner:
        params["owner_id"] = resolve_user(owner)

    if args.swimlane:
        params["swimlane_id"] = resolve_swimlane(project_id, args.swimlane)

    task_id = rpc_call("createTask", params)
    if not task_id:
        print("Error: task creation failed", file=sys.stderr)
        sys.exit(1)
    output({"task_id": task_id, "project_id": project_id})


def enrich_task(task):
    """Add human-readable names to a raw task dict without removing anything.

    getTask returns column_id/owner_id/swimlane_id but no names. We add
    column_title, swimlane_name and owner_username/owner_name so callers do not
    have to cross-reference list-columns/list-users themselves.
    """
    if not isinstance(task, dict):
        return task
    project_id = task.get("project_id")

    col_id = task.get("column_id")
    if project_id and col_id and "column_title" not in task:
        for c in rpc_call("getColumns", {"project_id": int(project_id)}) or []:
            if str(c.get("id")) == str(col_id):
                task["column_title"] = c.get("title")
                break

    sl_id = task.get("swimlane_id")
    if project_id and sl_id and "swimlane_name" not in task:
        for s in rpc_call("getActiveSwimlanes", {"project_id": int(project_id)}) or []:
            if str(s.get("id")) == str(sl_id):
                task["swimlane_name"] = s.get("name")
                break

    owner_id = task.get("owner_id")
    if owner_id and str(owner_id) != "0" and "owner_username" not in task:
        for u in load_instance().get("users", []):
            if str(u.get("id")) == str(owner_id):
                task["owner_username"] = u.get("username")
                task["owner_name"] = u.get("name")
                break

    return task


def cmd_get_task(args):
    result = rpc_call("getTask", {"task_id": int(args.task_id)})
    if not result:
        print(f"Error: task {args.task_id} not found", file=sys.stderr)
        sys.exit(1)
    output(enrich_task(result))


def cmd_update_task(args):
    params = {"id": int(args.task_id)}
    if args.title:
        params["title"] = args.title
    if args.description:
        params["description"] = args.description
    if args.owner:
        params["owner_id"] = resolve_user(args.owner)

    if len(params) == 1:
        print("Error: nothing to update (specify --title, --description, or --owner)", file=sys.stderr)
        sys.exit(1)

    result = rpc_call("updateTask", params)
    output({"success": result})


def cmd_move_task(args):
    task = rpc_call("getTask", {"task_id": int(args.task_id)})
    if not task:
        print(f"Error: task {args.task_id} not found", file=sys.stderr)
        sys.exit(1)

    project_id = int(task["project_id"])
    if args.project:
        target_project_id = resolve_project(args.project)

        # Liegt der Task noch im Ausgangsprojekt, verweigert Kanboard
        # moveTaskPosition mit einem fremden project_id und liefert nur false.
        # Der Projektwechsel gehoert zu move-project, also dorthin delegieren.

        if target_project_id != project_id:
            cmd_move_project(args)
            return

        project_id = target_project_id

    column_id = resolve_column(project_id, args.column)
    if args.swimlane:
        swimlane_id = resolve_swimlane(project_id, args.swimlane)
    else:
        swimlane_id = int(task["swimlane_id"])

    # Position 9999: Kanboard clampt auf die letzte Position
    result = rpc_call("moveTaskPosition", {
        "project_id": project_id,
        "task_id": int(args.task_id),
        "column_id": column_id,
        "position": 9999,
        "swimlane_id": swimlane_id
    })
    output({"success": result})


def cmd_move_project(args):
    task = rpc_call("getTask", {"task_id": int(args.task_id)})
    if not task:
        print(f"Error: task {args.task_id} not found", file=sys.stderr)
        sys.exit(1)

    # Offen/Geschlossen-Status vor dem Move merken: moveTaskToProject oeffnet
    # geschlossene Tasks automatisch wieder (is_active 0 -> 1). War der Task
    # geschlossen, wird er nach dem Verschieben wieder geschlossen.
    was_active = int(task.get("is_active", 1))

    target_project_id = resolve_project(args.project)

    # moveTaskToProject verschiebt task-uebergreifend; column/swimlane werden
    # danach separat gesetzt, da moveTaskToProject die Zielspalte nicht kennt

    moved = rpc_call("moveTaskToProject", {
        "task_id": int(args.task_id),
        "project_id": target_project_id
    })
    if not moved:
        output({"success": False})
        return

    result = {"success": True, "project_id": target_project_id}

    if args.column:
        column_id = resolve_column(target_project_id, args.column)
        if args.swimlane:
            swimlane_id = resolve_swimlane(target_project_id, args.swimlane)
        else:
            swimlanes = rpc_call("getActiveSwimlanes", {"project_id": target_project_id})
            swimlane_id = int(swimlanes[0]["id"]) if swimlanes else int(task["swimlane_id"])

        # Position 9999: Kanboard clampt auf die letzte Position

        placed = rpc_call("moveTaskPosition", {
            "project_id": target_project_id,
            "task_id": int(args.task_id),
            "column_id": column_id,
            "position": 9999,
            "swimlane_id": swimlane_id
        })
        result["success"] = placed

    # Status erhalten: war der Task geschlossen, wieder schliessen
    if was_active == 0:
        result["reclosed"] = bool(rpc_call("closeTask", {"task_id": int(args.task_id)}))

    output(result)


def cmd_open_task(args):
    result = rpc_call("openTask", {"task_id": int(args.task_id)})
    output({"success": result})


def cmd_close_task(args):
    result = rpc_call("closeTask", {"task_id": int(args.task_id)})
    output({"success": result})


def cmd_remove_task(args):
    task = rpc_try("getTask", {"task_id": int(args.task_id)})
    if not task:
        print(f"Error: task {args.task_id} not found", file=sys.stderr)
        sys.exit(1)

    # removeTask ist nicht umkehrbar und nimmt Kommentare, Anhaenge und
    # Teilaufgaben mit. Ohne --force wird deshalb nur gezeigt, was getroffen
    # waere — ein Vertipper in der ID loescht sonst still den falschen Task.
    task = enrich_task(task)
    proj = rpc_try("getProjectById", {"project_id": int(task.get("project_id") or 0)})
    info = {
        "task_id": int(args.task_id),
        "title": task.get("title", ""),
        "project_name": (proj or {}).get("name", ""),
        "column_title": task.get("column_title", ""),
        "is_active": task.get("is_active"),
    }

    if not args.force:
        output({
            **info,
            "success": False,
            "error": "Loeschen ist nicht umkehrbar (Kommentare, Anhaenge und "
                     "Teilaufgaben gehen mit). Titel pruefen und mit --force "
                     "wiederholen; zum Abschliessen 'move-task --column erledigt'."
        })
        sys.exit(1)

    ok = rpc_call("removeTask", {"task_id": int(args.task_id)})
    result = {**info, "success": bool(ok)}
    if not ok:
        result["error"] = "removeTask lieferte kein Ergebnis — Task existiert nicht (mehr)?"
        output(result)
        sys.exit(1)
    output(result)


def cmd_attach_file(args):
    filepath = os.path.abspath(args.file)
    if not os.path.exists(filepath):
        print(f"Error: file '{filepath}' not found", file=sys.stderr)
        sys.exit(1)

    size = os.path.getsize(filepath)
    if size > 10 * 1024 * 1024:
        print(f"Warning: file is {size // (1024*1024)} MB, upload may be slow", file=sys.stderr)

    task = rpc_call("getTask", {"task_id": int(args.task_id)})
    if not task:
        print(f"Error: task {args.task_id} not found", file=sys.stderr)
        sys.exit(1)

    with open(filepath, "rb") as f:
        blob = base64.b64encode(f.read()).decode("ascii")

    filename = os.path.basename(filepath)
    result = rpc_call("createTaskFile", {
        "project_id": int(task["project_id"]),
        "task_id": int(args.task_id),
        "filename": filename,
        "blob": blob
    })
    output({"file_id": result, "filename": filename})


def cmd_set_handoff(args):
    if args.file:
        filepath = os.path.abspath(args.file)
        if not os.path.exists(filepath):
            print(f"Error: file '{filepath}' not found", file=sys.stderr)
            sys.exit(1)
        with open(filepath, "r", encoding="utf-8") as f:
            content = f.read()
    else:
        content = args.value

    result = rpc_call("saveTaskHandoff", {
        "task_id": int(args.task_id),
        "content": content,
    })
    output({"task_id": int(args.task_id), "saved": result, "length": len(content)})


def cmd_get_handoff(args):
    content = rpc_call("getTaskHandoff", {"task_id": int(args.task_id)})
    if content is None:
        content = ""

    if args.output:
        outpath = os.path.abspath(args.output)
        with open(outpath, "w", encoding="utf-8") as f:
            f.write(content)
        output({"path": outpath, "length": len(content)})
    else:
        sys.stdout.write(content)
        if content and not content.endswith("\n"):
            sys.stdout.write("\n")


def cmd_remove_handoff(args):
    result = rpc_call("removeTaskHandoff", {"task_id": int(args.task_id)})
    output({"task_id": int(args.task_id), "removed": result})


def cmd_list_tasks(args):
    project_id = resolve_project(args.project)
    status = 1 if not args.closed else 0
    tasks = rpc_call("getAllTasks", {
        "project_id": project_id,
        "status_id": status
    })

    # getAllTasks liefert column_name/owner_username NICHT mit — daher aus
    # column_id (getColumns) bzw. owner_id (instance.json) selbst aufloesen,
    # sonst blieben beide Felder in der Ausgabe leer.
    col_by_id = {str(c["id"]): c["title"]
                 for c in rpc_call("getColumns", {"project_id": project_id}) or []}
    user_by_id = {str(u["id"]): u["username"] for u in load_instance().get("users", [])}

    if args.column:
        column_id = resolve_column(project_id, args.column)
        tasks = [t for t in tasks if int(t["column_id"]) == column_id]

    summary = []
    for t in tasks:
        summary.append({
            "id": t["id"],
            "title": t["title"],
            "column_name": col_by_id.get(str(t.get("column_id")), ""),
            "owner_username": user_by_id.get(str(t.get("owner_id")), ""),
            "date_due": format_ts(t.get("date_due")),
            "is_active": t.get("is_active", "")
        })
    output(summary)


def _accessible_projects():
    """Return {project_id: name} for all accessible projects.

    Prefers the instance.json cache (no RPC); falls back to getAllProjects /
    getMyProjects only if the cache is empty.
    """
    inst = load_instance()
    projects = inst.get("projects", [])
    if not projects:
        projects = (rpc_call("getAllProjects") if is_admin() else rpc_call("getMyProjects")) or []
    return {int(p["id"]): p.get("name", "") for p in projects}


def _search_summary(pid, pname, query, active_only):
    """Run searchTasks for one project and shape the hits into summary rows.

    searchTasks (unlike getAllTasks) already returns column_name and
    assignee_username, so no extra column/user lookups are needed here.
    """
    rows = []
    found = rpc_try("searchTasks", {"project_id": pid, "query": query})
    if not isinstance(found, list):
        return rows
    for t in found:
        if active_only and int(t.get("is_active", 1)) != 1:
            continue
        rows.append({
            "id": t["id"],
            "title": t["title"],
            "project_id": pid,
            "project_name": pname,
            "column": t.get("column_name", ""),
            "owner": t.get("assignee_username", "") or "",
            "is_active": t.get("is_active", ""),
        })
    return rows


SEARCH_FIELDS = ("title", "description", "comment")


def _field_query(field, term):
    """Wrap a plain search term into a single-field Kanboard query.

    Kanboard's searchTasks matches a bare term against the TITLE only; the body
    and comments need the explicit 'description:' / 'comment:' operators. Terms
    with whitespace are quoted so the parser keeps them as one phrase.
    """
    q = '"%s"' % term if any(c.isspace() for c in term) else term
    return "%s:%s" % (field, q)


def cmd_search(args):
    """Find tasks by keyword across all accessible projects (or one via --project).

    Uses Kanboard's searchTasks, so the query understands the same operators as
    the web UI (e.g. 'status:open', 'assignee:mmuster', 'title:...'). By default
    only open tasks are shown; --all includes closed ones.

    A bare term matches only the TITLE. To search body/comments too, pass
    --anywhere (title+description+comment) or --in <fields>; in that mode the
    query is treated as a plain term, wrapped into each field filter, and the
    per-field hits are unioned (deduped by id, with a matched_in list).
    """
    projects = _accessible_projects()
    if args.project:
        pid = resolve_project(args.project)
        projects = {pid: projects.get(pid, "")}

    active_only = not args.all

    fields = None
    if args.anywhere:
        fields = list(SEARCH_FIELDS)
    elif args.in_fields:
        fields = [f.strip().lower() for f in args.in_fields.split(",") if f.strip()]
        bad = [f for f in fields if f not in SEARCH_FIELDS]
        if bad:
            print("Error: unbekannte(s) Feld(er) fuer --in: %s (erlaubt: %s)"
                  % (", ".join(bad), ", ".join(SEARCH_FIELDS)), file=sys.stderr)
            sys.exit(1)

    # Klassischer Modus: Query 1:1 an searchTasks durchreichen
    if not fields:
        results = []
        for pid, pname in projects.items():
            results.extend(_search_summary(pid, pname, args.query, active_only=active_only))
        output(results)
        return

    # Feld-uebergreifend: pro Feld eine Query, Union nach id (matched_in merkt sich das Feld)
    by_id = {}
    order = []
    for pid, pname in projects.items():
        for field in fields:
            for row in _search_summary(pid, pname, _field_query(field, args.query), active_only=active_only):
                rid = row["id"]
                if rid not in by_id:
                    by_id[rid] = dict(row, matched_in=[])
                    order.append(rid)
                if field not in by_id[rid]["matched_in"]:
                    by_id[rid]["matched_in"].append(field)
    output([by_id[i] for i in order])


def cmd_my_tasks(args):
    """Open tasks assigned to a user (default: default_user) across all projects."""
    username = args.user or get_default_user()
    if not username:
        print("Error: no --user given and no default_user in instance.json (run: setup --default-user <username>)", file=sys.stderr)
        sys.exit(1)

    query = f"status:open assignee:{username}"
    results = []
    for pid, pname in _accessible_projects().items():
        results.extend(_search_summary(pid, pname, query, active_only=True))
    output(results)


