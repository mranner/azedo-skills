# Tags

def _get_tag_names(task_id):
    """Return the task's tag names as a sorted list. getTaskTags -> {id: name}."""
    tags_map = rpc_call("getTaskTags", {"task_id": int(task_id)})
    if isinstance(tags_map, dict):
        return sorted(tags_map.values())
    return []


def _set_tag_names(task_id, project_id, names):
    """Replace the task's full tag set. setTaskTags creates unknown tags on the
    fly at project level, so no separate create step is needed."""
    return rpc_call("setTaskTags", {
        "project_id": int(project_id),
        "task_id": int(task_id),
        "tags": names,
    })


def _task_project_id(task_id):
    task = rpc_call("getTask", {"task_id": int(task_id)})
    if not task:
        print(f"Error: task {task_id} not found", file=sys.stderr)
        sys.exit(1)
    return int(task["project_id"])


def cmd_get_tags(args):
    output(_get_tag_names(args.task_id))


def cmd_set_tags(args):
    """Replace ALL tags with the given comma-separated list (empty clears)."""
    project_id = _task_project_id(args.task_id)
    names = [t.strip() for t in args.tags.split(",") if t.strip()]
    ok = _set_tag_names(args.task_id, project_id, names)
    output({"success": bool(ok), "tags": names})


def cmd_add_tag(args):
    """Add one tag without clobbering existing ones (read-merge-write)."""
    project_id = _task_project_id(args.task_id)
    names = _get_tag_names(args.task_id)
    if args.tag not in names:
        names = sorted(names + [args.tag])
    ok = _set_tag_names(args.task_id, project_id, names)
    output({"success": bool(ok), "tags": names})


def cmd_remove_tag(args):
    """Remove one tag, keep the rest."""
    project_id = _task_project_id(args.task_id)
    names = [n for n in _get_tag_names(args.task_id) if n != args.tag]
    ok = _set_tag_names(args.task_id, project_id, names)
    output({"success": bool(ok), "tags": names})


def cmd_set_kimai(args):
    """Tag the task with the Kimai shortcut as 'kimai:<shortcut>'.

    One Kimai shortcut per task: any existing 'kimai:*' tag is replaced. cr
    surfaces this as the 'kimai' field so later time entries can pick the right
    shortcut automatically.
    """
    project_id = _task_project_id(args.task_id)
    shortcut = args.shortcut.strip()
    names = [n for n in _get_tag_names(args.task_id) if not n.lower().startswith("kimai:")]
    names.append(f"kimai:{shortcut}")
    ok = _set_tag_names(args.task_id, project_id, sorted(names))
    output({"success": bool(ok), "kimai": shortcut, "tags": sorted(names)})


def cmd_set_jira(args):
    """Tag the task with a linked Jira issue key as 'jira:<KEY>'.

    One Jira key per task: any existing 'jira:*' tag is replaced. cr surfaces this
    as the 'jira' field so the jira skill can act on the linked issue without the
    key being restated.
    """
    project_id = _task_project_id(args.task_id)
    key = args.key.strip().upper()
    names = [n for n in _get_tag_names(args.task_id) if not n.lower().startswith("jira:")]
    names.append(f"jira:{key}")
    ok = _set_tag_names(args.task_id, project_id, sorted(names))
    output({"success": bool(ok), "jira": key, "tags": sorted(names)})


def parse_cr_id(raw):
    """Normalize CR input: CR4326, cr4326, CR 4326, #4326, 4326 -> 4326"""
    s = raw.strip().lstrip("#")
    if s.lower().startswith("cr"):
        s = s[2:].strip()
    if not s.isdigit():
        print(f"Error: '{raw}' is not a valid task reference", file=sys.stderr)
        sys.exit(1)
    return int(s)


def cmd_cr(args):
    """Load one or more tasks as CR context.

    Der CR-Kontext ist die Arbeitsgrundlage fuer die gesamte Session (Commit-/
    Kimai-Prefixing). Deshalb laedt cr bewusst den *Inhalt* des Tasks mit — vor
    allem die **Beschreibung**, in der im Regelfall die menschlich verfasste
    Ausgangslage steht (Zusammenfassung, Mail-Auszug, Kurzbeschreibung). Fehlt
    sie, sieht ein voller Task faelschlich leer aus.

    Bewusst *nicht* automatisch geladen (eigene Befehle): Kommentar-Volltext
    (get-comments), Teilaufgaben (list-subtasks), Task-Links (list-task-links),
    Anhang-Details (list-files). Von Kommentaren und Anhaengen kommt nur ein
    Zaehler als Signal mit.
    """
    instance = load_instance()
    proj_names = {int(p["id"]): p.get("name", "") for p in instance.get("projects", [])}

    results = []
    for raw_id in args.task_ids:
        task_id = parse_cr_id(raw_id)
        task = rpc_call("getTask", {"task_id": task_id})
        if not task:
            print(f"Error: task {task_id} not found", file=sys.stderr)
            sys.exit(1)

        project_id = int(task["project_id"])

        # Spalten-Titel aufloesen (getTask liefert nur column_id). Die Swimlane
        # braucht cr nicht — daher hier bewusst kein getActiveSwimlanes-Call.
        column_title = ""
        col_id = task.get("column_id")
        if col_id:
            for c in rpc_call("getColumns", {"project_id": project_id}) or []:
                if str(c.get("id")) == str(col_id):
                    column_title = c.get("title", "")
                    break

        # Owner-Username aus dem instance.json-Cache (kein RPC).
        owner_username = ""
        owner_id = task.get("owner_id")
        if owner_id and str(owner_id) != "0":
            for u in instance.get("users", []):
                if str(u.get("id")) == str(owner_id):
                    owner_username = u.get("username", "")
                    break

        # Projektname aus dem Cache; nur wenn dort unbekannt, per RPC nachladen.
        project_name = proj_names.get(project_id)
        if not project_name:
            project_name = (rpc_try("getProjectById", {"project_id": project_id}) or {}).get("name", "")

        entry = {
            "cr": f"CR{task_id}",
            "task_id": task_id,
            "title": task["title"],
            "project_id": project_id,
            "project_name": project_name,
            "column": column_title,
            "owner": owner_username,
            "modified": format_ts(task.get("date_modification")),
            "description": task.get("description", "") or "",
        }

        # Handoff-Feld (TaskHandoff-Plugin) automatisch mitladen, falls befuellt.
        # Ergaenzt die Description, ist nicht redundant: Description = was ist die
        # Aufgabe, Handoff = wo stehen wir / wie geht es weiter (Uebergabestand).
        # rpc_try statt rpc_call: fehlt das Plugin (Method not found), liefert es
        # None statt cr komplett abzubrechen.
        handoff = rpc_try("getTaskHandoff", {"task_id": task_id})
        if handoff:
            entry["handoff"] = handoff

        # Tags. Zwei Praefix-Tags werden als eigene Felder herausgehoben, damit ihr
        # Kontext direkt im CR steht: 'kimai:<shortcut>' -> Feld 'kimai' (Zeiterfassungs-
        # Shortcut aus .claude/kimai-shortcuts.json) und 'jira:<KEY>' -> Feld 'jira'
        # (verknuepftes Jira-Issue, z.B. OPS-69 / PROJ-1762 fuer den jira-Skill).
        # getTaskTags liefert {tag_id: name}.
        tags_map = rpc_try("getTaskTags", {"task_id": task_id})
        tag_names = sorted(tags_map.values()) if isinstance(tags_map, dict) else []
        if tag_names:
            entry["tags"] = tag_names
            for t in tag_names:
                low = t.lower()
                if low.startswith("kimai:") and "kimai" not in entry:
                    entry["kimai"] = t.split(":", 1)[1].strip()
                elif low.startswith("jira:") and "jira" not in entry:
                    entry["jira"] = t.split(":", 1)[1].strip()

        # Zaehler fuer Kommentare/Anhaenge — nur wenn > 0, damit leere Tasks
        # schlank bleiben. Kanboard hat keine Count-Methode; len() der Liste.
        comments = rpc_try("getAllComments", {"task_id": task_id})
        if comments:
            entry["comments"] = len(comments)
        files = rpc_try("getAllTaskFiles", {"task_id": task_id})
        if files:
            entry["attachments"] = len(files)

        results.append(entry)

    output(results if len(results) > 1 else results[0])


def cmd_setup(args):
    """Query instance for projects, swimlanes, columns, users and write instance.json"""
    skill_dir = os.path.dirname(os.path.abspath(__file__))
    out_path = os.path.join(skill_dir, "instance.json")

    # Detect role via getMe (fails with 403 for jsonrpc API user)
    me = rpc_try("getMe")
    if me:
        role = me.get("role", "app-user")
    else:
        role = "app-admin"
    admin = role == "app-admin"

    # Projects: admin sees all, non-admin only own
    projects_raw = rpc_call("getAllProjects") if admin else rpc_call("getMyProjects")
    projects = []
    for p in projects_raw:
        if int(p.get("is_active", 0)) != 1:
            continue
        pid = int(p["id"])
        swimlanes = rpc_call("getActiveSwimlanes", {"project_id": pid})
        columns = rpc_call("getColumns", {"project_id": pid})
        projects.append({
            "id": pid,
            "name": p["name"],
            "swimlanes": [s["name"] for s in swimlanes],
            "columns": [c["title"] for c in columns],
        })

    # Users: admin gets all, non-admin collects project members
    if admin:
        users_raw = rpc_call("getAllUsers")
        users = []
        for u in users_raw:
            if int(u.get("is_active", 0)) != 1:
                continue
            users.append({
                "id": int(u["id"]),
                "username": u["username"],
                "name": u.get("name", ""),
            })
    else:
        seen_ids = set()
        users = []
        # Own user first
        own = {"id": int(me["id"]), "username": me["username"], "name": me.get("name", me["username"])}
        users.append(own)
        seen_ids.add(own["id"])
        # Collect members from all accessible projects
        for p in projects:
            members = rpc_call("getProjectUsers", {"project_id": p["id"]})
            # getProjectUsers returns {id: username, ...}
            if isinstance(members, dict):
                for uid, uname in members.items():
                    uid = int(uid)
                    if uid not in seen_ids:
                        users.append({"id": uid, "username": uname, "name": uname})
                        seen_ids.add(uid)

    instance = {"role": role, "projects": projects, "users": users}

    if args.default_user:
        usernames = [u["username"] for u in users]
        if args.default_user not in usernames:
            print(f"Error: user '{args.default_user}' not found (available: {', '.join(usernames)})", file=sys.stderr)
            sys.exit(1)
        instance["default_user"] = args.default_user

    with open(out_path, "w") as f:
        json.dump(instance, f, indent=2, ensure_ascii=False)

    print(f"Written to {out_path}")
    output(instance)


# CLI setup

def main():
    parser = argparse.ArgumentParser(description="Kanboard JSON-RPC API helper")
    sub = parser.add_subparsers(dest="command", required=True)

    # cr (context)
    p = sub.add_parser("cr")
    p.add_argument("task_ids", nargs="+")
    p.set_defaults(func=cmd_cr)

    # setup
    p = sub.add_parser("setup")
    p.add_argument("--default-user", dest="default_user")
    p.set_defaults(func=cmd_setup)

    # create-task
    p = sub.add_parser("create-task")
    p.add_argument("--project", required=True)
    p.add_argument("--title", required=True)
    p.add_argument("--description")
    p.add_argument("--column")
    p.add_argument("--owner")
    p.add_argument("--swimlane")
    p.set_defaults(func=cmd_create_task)

    # get-task
    p = sub.add_parser("get-task")
    p.add_argument("task_id")
    p.set_defaults(func=cmd_get_task)

    # update-task
    p = sub.add_parser("update-task")
    p.add_argument("task_id")
    p.add_argument("--title")
    p.add_argument("--description")
    p.add_argument("--owner")
    p.set_defaults(func=cmd_update_task)

    # move-task
    p = sub.add_parser("move-task")
    p.add_argument("task_id")
    p.add_argument("--column", required=True)
    p.add_argument("--swimlane")
    p.add_argument("--project")
    p.set_defaults(func=cmd_move_task)

    # move-project (task in anderes Projekt verschieben)
    p = sub.add_parser("move-project")
    p.add_argument("task_id")
    p.add_argument("--project", required=True)
    p.add_argument("--column")
    p.add_argument("--swimlane")
    p.set_defaults(func=cmd_move_project)

    # open-task
    p = sub.add_parser("open-task")
    p.add_argument("task_id")
    p.set_defaults(func=cmd_open_task)

    # close-task
    p = sub.add_parser("close-task")
    p.add_argument("task_id")
    p.set_defaults(func=cmd_close_task)

    # remove-task
    p = sub.add_parser("remove-task")
    p.add_argument("task_id")
    p.add_argument("--force", action="store_true",
                   help="wirklich loeschen (ohne: nur anzeigen, was getroffen waere)")
    p.set_defaults(func=cmd_remove_task)

    # attach-file
    p = sub.add_parser("attach-file")
    p.add_argument("task_id")
    p.add_argument("--file", required=True)
    p.set_defaults(func=cmd_attach_file)

    # set-handoff (TaskHandoff-Plugin)
    p = sub.add_parser("set-handoff")
    p.add_argument("task_id")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--file", help="Handoff-Text aus Datei lesen")
    g.add_argument("--value", help="Handoff-Text direkt uebergeben")
    p.set_defaults(func=cmd_set_handoff)

    # get-handoff (TaskHandoff-Plugin)
    p = sub.add_parser("get-handoff")
