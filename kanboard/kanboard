def cmd_attach_file(args):
    filepath = os.path.abspath(args.file)
    if not os.path.exists(filepath):
        print(f"Error: file '{filepath}' not found", file=sys.stderr)
        sys.exit(1)

    size = os.path.getsize(filepath)
    if size > 10 * 1024 * 1024:
        print(f"Warning: file is {size // (1024*1024)} MB, upload may be slow", file=sys.stderr)

    task = rpc_call("getTask", {"task_id": int(args.task_id)})
    if not task:
        print(f"Error: task {args.task_id} not found", file=sys.stderr)
        sys.exit(1)

    with open(filepath, "rb") as f:
        blob = base64.b64encode(f.read()).decode("ascii")

    filename = os.path.basename(filepath)
    result = rpc_call("createTaskFile", {
        "project_id": int(task["project_id"]),
        "task_id": int(args.task_id),
        "filename": filename,
        "blob": blob
    })
    output({"file_id": result, "filename": filename})


def cmd_set_handoff(args):
    if args.file:
        filepath = os.path.abspath(args.file)
        if not os.path.exists(filepath):
            print(f"Error: file '{filepath}' not found", file=sys.stderr)
            sys.exit(1)
        with open(filepath, "r", encoding="utf-8") as f:
            content = f.read()
    else:
        content = args.value

    result = rpc_call("saveTaskHandoff", {
        "task_id": int(args.task_id),
        "content": content,
    })
    output({"task_id": int(args.task_id), "saved": result, "length": len(content)})


def cmd_get_handoff(args):
    content = rpc_call("getTaskHandoff", {"task_id": int(args.task_id)})
    if content is None:
        content = ""

    if args.output:
        outpath = os.path.abspath(args.output)
        with open(outpath, "w", encoding="utf-8") as f:
            f.write(content)
        output({"path": outpath, "length": len(content)})
    else:
        sys.stdout.write(content)
        if content and not content.endswith("\n"):
            sys.stdout.write("\n")


def cmd_remove_handoff(args):
    result = rpc_call("removeTaskHandoff", {"task_id": int(args.task_id)})
    output({"task_id": int(args.task_id), "removed": result})


def cmd_list_tasks(args):
    project_id = resolve_project(args.project)
    status = 1 if not args.closed else 0
    tasks = rpc_call("getAllTasks", {
        "project_id": project_id,
        "status_id": status
    })

    if args.column:
        column_id = resolve_column(project_id, args.column)
        tasks = [t for t in tasks if int(t["column_id"]) == column_id]

    summary = []
    for t in tasks:
        summary.append({
            "id": t["id"],
            "title": t["title"],
            "column_name": t.get("column_name", ""),
            "owner_username": t.get("owner_username", ""),
            "date_due": t.get("date_due", ""),
            "is_active": t.get("is_active", "")
        })
    output(summary)


