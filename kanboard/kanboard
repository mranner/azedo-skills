_instance = None


def load_instance():
    """Read instance.json (cached)"""
    global _instance
    if _instance is not None:
        return _instance
    skill_dir = os.path.dirname(os.path.abspath(__file__))
    path = os.path.join(skill_dir, "instance.json")
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        _instance = json.load(f)
    return _instance


def is_admin():
    """Check if cached role is app-admin"""
    return load_instance().get("role") == "app-admin"


def get_default_user():
    """Read default_user from instance.json"""
    return load_instance().get("default_user")


def cmd_add_comment(args):
    if args.user:
        username = args.user
    else:
        username = get_default_user()
        if not username:
            print("Error: no --user given and no default_user in instance.json (run: setup --default-user <username>)", file=sys.stderr)
            sys.exit(1)

    user_id = resolve_user(username)
    result = rpc_call("createComment", {
        "task_id": int(args.task_id),
        "user_id": user_id,
        "content": args.text
    })
    output({"comment_id": result})


