#!/usr/bin/env python3

# Envato Market API helper (ThemeForest, CodeCanyon, etc.)
# stdlib only, no pip dependencies
# version 1.11.1

import argparse
import json
import os
import sys
import urllib.request
import urllib.error

def _env_has_envato(path):
    """Check if .env file contains ENVATO_TOKEN"""
    try:
        with open(path) as f:
            for line in f:
                if line.strip().startswith("ENVATO_TOKEN"):
                    return True
    except OSError:
        pass
    return False


def _find_env():
    override = os.environ.get("ENVATO_ENV")
    if override:
        return override
    cwd_env = os.path.join(os.getcwd(), ".env")
    if os.path.exists(cwd_env) and _env_has_envato(cwd_env):
        return cwd_env
    return os.path.join(os.path.expanduser("~"), ".env")


ENV_FILE = _find_env()
API_BASE = "https://api.envato.com"

_config = None


def load_env():
    """Read ENVATO_TOKEN from .env (cached)"""
    global _config
    if _config is not None:
        return _config

    config = {}
    if not os.path.exists(ENV_FILE):
        print(f"Error: {ENV_FILE} not found", file=sys.stderr)
        sys.exit(1)
    with open(ENV_FILE) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                key, val = line.split("=", 1)
                config[key.strip()] = val.strip().strip('"').strip("'")
    if "ENVATO_TOKEN" not in config:
        print(f"Error: ENVATO_TOKEN not set in {ENV_FILE}", file=sys.stderr)
        sys.exit(1)

    _config = config
    return _config


def api_call(path, params=None):
    """Make a GET request to Envato API"""
    config = load_env()
    url = f"{API_BASE}{path}"

    if params:
        qs = "&".join(f"{k}={v}" for k, v in params.items() if v is not None)
        if qs:
            url += f"?{qs}"

    req = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {config['ENVATO_TOKEN']}",
        },
        method="GET",
    )

    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            if not raw:
                return None
            return json.loads(raw.decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")
        print(f"API error {e.code}: {err_body}", file=sys.stderr)
        sys.exit(1)


def download_file(url, output_path):
    """Download a file from a URL to a local path"""
    req = urllib.request.Request(url)
    try:
        with urllib.request.urlopen(req) as resp:
            with open(output_path, "wb") as f:
                while True:
                    chunk = resp.read(8192)
                    if not chunk:
                        break
                    f.write(chunk)
        return output_path
    except urllib.error.HTTPError as e:
        print(f"Download error {e.code}: {e.reason}", file=sys.stderr)
        sys.exit(1)


def output(data):
    """Print result as formatted JSON"""
    print(json.dumps(data, indent=2, ensure_ascii=False))


# --- Subcommands ---

def cmd_list_purchases(args):
    """List all purchases"""
    params = {}
    if args.page:
        params["page"] = args.page
    if args.filter_by:
        params["filter_by"] = args.filter_by
    result = api_call("/v3/market/buyer/list-purchases", params or None)
    output(result)


def cmd_get_purchase(args):
    """Get purchase details by purchase code"""
    result = api_call(f"/v3/market/buyer/purchase?code={args.purchase_code}")
    output(result)


def cmd_download(args):
    """Get download URL for a purchased item"""
    params = {}
    if args.item_id:
        params["item_id"] = args.item_id
    if args.purchase_code:
        params["purchase_code"] = args.purchase_code
    if args.shorten_url:
        params["shorten_url"] = "true"

    if not params:
        print("Error: either --item-id or --purchase-code required", file=sys.stderr)
        sys.exit(1)

    result = api_call("/v3/market/buyer/download", params)

    if args.output:
        if "download_url" in result:
            path = download_file(result["download_url"], args.output)
            print(f"Downloaded to: {path}")
        elif "wordpress_theme" in result:
            path = download_file(result["wordpress_theme"], args.output)
            print(f"Downloaded to: {path}")
        else:
            print("Download URL not found in response. Full response:", file=sys.stderr)
            output(result)
    else:
        output(result)


def cmd_search(args):
    """Search items on Envato Market"""
    params = {"term": args.term, "site": args.site or "themeforest.net"}
    if args.sort:
        params["sort_by"] = args.sort
    if args.page:
        params["page"] = args.page
    result = api_call("/v1/discovery/search/search/item", params)
    output(result)


def cmd_item_details(args):
    """Get details for a specific item"""
    result = api_call(f"/v3/market/catalog/item?id={args.item_id}")
    output(result)


def cmd_user_account(args):
    """Show current user account details"""
    result = api_call("/v1/market/private/user/account.json")
    output(result)


def cmd_user_email(args):
    """Show current user email"""
    result = api_call("/v1/market/private/user/email.json")
    output(result)


def cmd_ping(args):
    """Test API connection"""
    result = api_call("/v1/market/private/user/account.json")
    if result:
        acct = result.get("account", {})
        name = f'{acct.get("firstname", "")} {acct.get("surname", "")}'.strip() or "unknown"
        print(f"OK — connected as: {name}")
    else:
        print("Error: no response", file=sys.stderr)
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(description="Envato Market API")
    sub = parser.add_subparsers(dest="command")
    sub.required = True

    # ping
    sub.add_parser("ping", help="Test API connection")

    # list-purchases
    lp = sub.add_parser("list-purchases", help="List all purchases")
    lp.add_argument("--page", type=int, help="Page number")
    lp.add_argument("--filter-by", dest="filter_by",
                     help="Filter: wordpress-themes, wordpress-plugins, etc.")

    # get-purchase
    gp = sub.add_parser("get-purchase", help="Get purchase by code")
    gp.add_argument("purchase_code", help="Purchase code")

    # download
    dl = sub.add_parser("download", help="Download a purchased item")
    dl.add_argument("--item-id", dest="item_id", help="Item ID")
    dl.add_argument("--purchase-code", dest="purchase_code", help="Purchase code")
    dl.add_argument("--output", "-o", help="Output file path (downloads directly)")
    dl.add_argument("--shorten-url", dest="shorten_url", action="store_true",
                     help="Get shortened download URL")

    # search
    sr = sub.add_parser("search", help="Search items on Envato Market")
    sr.add_argument("term", help="Search term")
    sr.add_argument("--site", help="Site (default: themeforest.net)")
    sr.add_argument("--sort", help="Sort by: relevance, rating, date, sales, price")
    sr.add_argument("--page", type=int, help="Page number")

    # item-details
    idet = sub.add_parser("item-details", help="Get item details")
    idet.add_argument("item_id", help="Item ID")

    # user-account
    sub.add_parser("user-account", help="Show account details")

    # user-email
    sub.add_parser("user-email", help="Show account email")

    args = parser.parse_args()
    cmd_map = {
        "ping": cmd_ping,
        "list-purchases": cmd_list_purchases,
        "get-purchase": cmd_get_purchase,
        "download": cmd_download,
        "search": cmd_search,
        "item-details": cmd_item_details,
        "user-account": cmd_user_account,
        "user-email": cmd_user_email,
    }
    cmd_map[args.command](args)


if __name__ == "__main__":
    main()
