#!/usr/bin/env python3

# Telegram Bot API helper (outbound-first)
# Sendet Nachrichten via api.telegram.org/bot<TOKEN>/sendMessage.
# stdlib only, keine pip-Abhaengigkeiten. Lauffaehig auf macOS + FreeBSD.
# version 1.23.0

import argparse
import json
import os
import ssl
import sys
import time
import urllib.parse
import urllib.request
import urllib.error

API_BASE = "https://api.telegram.org"


# --- .env laden -------------------------------------------------------------

def _env_has_token(path):
    """True, wenn die .env einen TELEGRAM_BOT_TOKEN enthaelt."""
    try:
        with open(path) as f:
            for line in f:
                if line.strip().startswith("TELEGRAM_BOT_TOKEN"):
                    return True
    except OSError:
        pass
    return False


def _find_env():
    override = os.environ.get("TELEGRAM_ENV")
    if override:
        return override
    cwd_env = os.path.join(os.getcwd(), ".env")
    if os.path.exists(cwd_env) and _env_has_token(cwd_env):
        return cwd_env
    return os.path.join(os.path.expanduser("~"), ".env")


ENV_FILE = _find_env()

_config = None


def load_env(require_token=True):
    """TELEGRAM_* aus .env lesen (gecached). Environment-Variablen haben Vorrang."""
    global _config
    if _config is not None:
        return _config

    config = {}
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    key, val = line.split("=", 1)
                    config[key.strip()] = val.strip().strip('"').strip("'")

    # Environment ueberschreibt .env (praktisch fuer cron/CI)
    for key in ("TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "TELEGRAM_CA_BUNDLE"):
        if os.environ.get(key):
            config[key] = os.environ[key]

    if require_token and not config.get("TELEGRAM_BOT_TOKEN"):
        die("TELEGRAM_BOT_TOKEN nicht gesetzt (weder in %s noch als Env-Variable)."
            % ENV_FILE)

    _config = config
    return _config


# --- TLS-Kontext ------------------------------------------------------------

def _ssl_context():
    """Default-Kontext; auf FreeBSD ggf. via TELEGRAM_CA_BUNDLE ein CA-Bundle
    (z.B. /usr/local/share/certs/ca-root-nss.crt aus ca_root_nss) erzwingen."""
    ca = load_env(require_token=False).get("TELEGRAM_CA_BUNDLE")
    if ca:
        return ssl.create_default_context(cafile=ca)
    return ssl.create_default_context()


# --- Fehler/HTTP ------------------------------------------------------------

def die(msg):
    print("Fehler: " + msg, file=sys.stderr)
    sys.exit(1)


def api(method, params=None, timeout=30):
    """Ruft eine Bot-API-Methode auf (POST, x-www-form-urlencoded).
    Gibt das 'result'-Feld zurueck; bricht bei ok:false ab."""
    token = load_env()["TELEGRAM_BOT_TOKEN"]
    url = "%s/bot%s/%s" % (API_BASE, token, method)

    data = None
    if params:
        clean = {k: v for k, v in params.items() if v is not None}
        data = urllib.parse.urlencode(clean).encode("utf-8")

    req = urllib.request.Request(
        url, data=data,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_ssl_context()) as r:
            payload = json.load(r)
    except urllib.error.HTTPError as e:
        # Telegram legt bei 4xx eine JSON-Fehlerbeschreibung in den Body
        try:
            payload = json.load(e)
        except Exception:
            die("HTTP %s bei %s" % (e.code, method))
        desc = payload.get("description", "unbekannter Fehler")
        die("Telegram-API (%s): %s" % (method, desc))
    except urllib.error.URLError as e:
        die("Netzwerkfehler bei %s: %s" % (method, e.reason))

    if not payload.get("ok"):
        die("Telegram-API (%s): %s" % (method, payload.get("description", "ok:false")))
    return payload.get("result")


# --- Text-Helfer ------------------------------------------------------------

def html_escape(s):
    """Escaping fuer parse_mode=HTML (nur & < > sind zu escapen)."""
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def resolve_text(args):
    """Nachrichtentext aus Positional-Arg, --file oder STDIN ('-') beziehen."""
    if getattr(args, "file", None):
        with open(args.file, encoding="utf-8") as f:
            return f.read().rstrip("\n")
    if getattr(args, "text", None) in (None, "-"):
        data = sys.stdin.read()
        if not data.strip():
            die("Kein Text: weder Argument noch --file noch STDIN geliefert.")
        return data.rstrip("\n")
    return args.text


def resolve_chat_id(args):
    cid = getattr(args, "chat_id", None) or load_env().get("TELEGRAM_CHAT_ID")
    if not cid:
        die("Keine chat_id: weder --chat-id noch TELEGRAM_CHAT_ID gesetzt. "
            "Zuerst 'telegram setup' ausfuehren.")
    return cid


PARSE_MODE = {
    "none": None,
    "plain": None,
    "html": "HTML",
    "markdown": "MarkdownV2",
    "markdownv2": "MarkdownV2",
    "markdown-legacy": "Markdown",
}


def _send(chat_id, text, parse_mode=None, silent=False, no_preview=False):
    result = api("sendMessage", {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": parse_mode,
        "disable_notification": "true" if silent else None,
        "disable_web_page_preview": "true" if no_preview else None,
    })
    return result


# --- Subcommands ------------------------------------------------------------

def cmd_me(args):
    """getMe — Token pruefen, Bot-Identitaet anzeigen."""
    me = api("getMe")
    if args.json:
        print(json.dumps(me, indent=2, ensure_ascii=False))
        return
    print("Bot OK: @%s (%s, id %s)" % (
        me.get("username"), me.get("first_name"), me.get("id")))


def cmd_send(args):
    """sendMessage — Kernbefehl (outbound)."""
    text = resolve_text(args)
    chat_id = resolve_chat_id(args)
    parse_mode = PARSE_MODE.get(args.parse_mode, None)
    result = _send(chat_id, text, parse_mode, args.silent, args.no_preview)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print("Gesendet an %s (message_id %s)" % (
            result.get("chat", {}).get("id"), result.get("message_id")))


def _template_send(args, emoji, label):
    """Gemeinsame Logik fuer alert/recovery (parse_mode=HTML, Emoji + Titel)."""
    body = resolve_text(args)
    chat_id = resolve_chat_id(args)
    lines = ["%s <b>%s</b>" % (emoji, html_escape(args.title or label))]
    lines.append("")
    lines.append(html_escape(body))
    meta = []
    if getattr(args, "host", None):
        meta.append("Host: %s" % html_escape(args.host))
    if meta:
        lines.append("")
        lines.append("<i>%s</i>" % " · ".join(meta))
    text = "\n".join(lines)
    result = _send(chat_id, text, "HTML", args.silent, no_preview=True)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print("Gesendet (%s) an %s (message_id %s)" % (
            label, result.get("chat", {}).get("id"), result.get("message_id")))


def cmd_alert(args):
    _template_send(args, "\U0001F534", "ALERT")


def cmd_recovery(args):
    _template_send(args, "✅", "RECOVERY")


def cmd_digest(args):
    """Daily-Digest: Titel + Bullet-Zeilen (je Zeile aus Text/STDIN ein Punkt)."""
    body = resolve_text(args)
    chat_id = resolve_chat_id(args)
    items = [ln.strip() for ln in body.splitlines() if ln.strip()]
    lines = ["\U0001F4CB <b>%s</b>" % html_escape(args.title or "Digest"), ""]
    for it in items:
        lines.append("• %s" % html_escape(it))
    text = "\n".join(lines)
    result = _send(chat_id, text, "HTML", args.silent, no_preview=True)
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print("Digest gesendet an %s (message_id %s, %d Punkte)" % (
            result.get("chat", {}).get("id"), result.get("message_id"), len(items)))


def _extract_msg(update):
    """Die Nachricht aus einem Update ziehen (message/edited/channel_post)."""
    return (update.get("message") or update.get("edited_message")
            or update.get("channel_post") or {})


def _collect_chats(updates):
    """Aus getUpdates-Ergebnissen die distinkten Chats extrahieren."""
    chats = {}
    for u in updates:
        chat = _extract_msg(u).get("chat")
        if chat and chat.get("id") not in chats:
            chats[chat["id"]] = chat
    return chats


def cmd_setup(args):
    """Setup-Helfer: Webhook loesen, getUpdates lesen, chat_id(s) anzeigen.
    Voraussetzung: dem Bot wurde vorher einmal eine Nachricht geschickt."""
    me = api("getMe")
    print("Bot: @%s (id %s)" % (me.get("username"), me.get("id")))

    # Ein aktiver Webhook blockiert getUpdates -> vorher loesen
    api("deleteWebhook")

    updates = api("getUpdates", {"timeout": "0"}) or []
    chats = _collect_chats(updates)
    if not chats:
        print("\nKeine Chats gefunden. Schreib dem Bot in Telegram einmal eine "
              "Nachricht (z.B. 'hi') und fuehre 'setup' erneut aus.")
        return

    print("\nGefundene Chats:")
    for cid, chat in chats.items():
        who = chat.get("title") or chat.get("username") or chat.get("first_name") or ""
        print("  chat_id=%s  typ=%s  %s" % (cid, chat.get("type"), who))

    if args.write:
        if len(chats) > 1 and not args.chat_id:
            die("Mehrere Chats gefunden — mit --chat-id <id> gezielt schreiben.")
        chosen = str(args.chat_id) if args.chat_id else str(next(iter(chats)))
        _write_env_chat_id(chosen)
        print("\nTELEGRAM_CHAT_ID=%s in %s geschrieben." % (chosen, ENV_FILE))
    else:
        first = next(iter(chats))
        print("\nUebernehmen mit:")
        print("  echo 'TELEGRAM_CHAT_ID=%s' >> %s" % (first, ENV_FILE))
        print("  (oder 'telegram setup --write [--chat-id <id>]')")


def _write_env_chat_id(chat_id):
    """TELEGRAM_CHAT_ID in die .env schreiben/ersetzen (idempotent)."""
    lines = []
    found = False
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                if line.strip().startswith("TELEGRAM_CHAT_ID"):
                    lines.append("TELEGRAM_CHAT_ID=%s\n" % chat_id)
                    found = True
                else:
                    lines.append(line)
    if not found:
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        lines.append("TELEGRAM_CHAT_ID=%s\n" % chat_id)
    with open(ENV_FILE, "w") as f:
        f.writelines(lines)


def cmd_get_updates(args):
    """Roh-getUpdates (Empfangs-Baustein). Optional mit offset/timeout."""
    result = api("getUpdates", {
        "offset": args.offset,
        "timeout": str(args.timeout),
    }, timeout=args.timeout + 10)
    print(json.dumps(result, indent=2, ensure_ascii=False))


def cmd_poll(args):
    """Long-Poll-Scaffold (Empfang). getUpdates?timeout=50 in Schleife:
    Telegram haelt die Verbindung offen, antwortet sofort bei Nachricht.
    Gibt eingehende Nachrichten aus; verarbeitet sie NICHT (Basis zum Ausbauen).
    Kein festes Intervall, kein Daemon — laeuft im Vordergrund bis Ctrl-C."""
    offset = args.offset
    if not args.quiet:
        print("Long-Poll gestartet (timeout=%ss). Ctrl-C zum Beenden."
              % args.timeout, file=sys.stderr)
    # Ein aktiver Webhook wuerde getUpdates blockieren
    api("deleteWebhook")
    try:
        while True:
            updates = api("getUpdates", {
                "offset": offset,
                "timeout": str(args.timeout),
            }, timeout=args.timeout + 10) or []
            for u in updates:
                offset = u["update_id"] + 1
                if args.json:
                    print(json.dumps(u, ensure_ascii=False), flush=True)
                    continue
                msg = _extract_msg(u)
                chat = msg.get("chat", {})
                frm = msg.get("from", {})
                who = frm.get("username") or frm.get("first_name") or chat.get("title") or "?"
                text = msg.get("text", "")
                print("[chat %s] %s: %s" % (chat.get("id"), who, text), flush=True)
            if args.once:
                break
    except KeyboardInterrupt:
        if not args.quiet:
            print("\nBeendet.", file=sys.stderr)


def _drain_offset():
    """Backlog bestaetigen: aktuellen offset (max update_id + 1) ermitteln, damit
    das Warten nur Nachrichten zaehlt, die DANACH eintreffen. None = nichts offen."""
    ups = api("getUpdates", {"timeout": "0"}) or []
    if ups:
        return ups[-1]["update_id"] + 1
    return None


def _wait_for_message(offset, budget, poll_timeout, accept_chat):
    """Blockiert bis zu 'budget' Sekunden auf eingehende Nachricht(en).
    Long-Poll in poll_timeout-Zyklen. Nachrichten aus fremden Chats werden
    (offset-)konsumiert und ignoriert, wenn accept_chat gesetzt ist.
    Rueckgabe: (liste_der_update-dicts, neuer_offset). Leere Liste = Timeout."""
    start = time.monotonic()
    while True:
        remaining = budget - (time.monotonic() - start)
        if remaining <= 0:
            return [], offset
        per = int(min(poll_timeout, remaining))
        if per < 1:
            per = 1
        updates = api("getUpdates", {
            "offset": offset,
            "timeout": str(per),
        }, timeout=per + 10) or []
        matched = []
        for u in updates:
            offset = u["update_id"] + 1
            chat = _extract_msg(u).get("chat", {})
            if accept_chat and str(chat.get("id")) != str(accept_chat):
                continue
            matched.append(u)
        if matched:
            return matched, offset


def _print_incoming(updates, as_json):
    """Eingegangene Nachrichten ausgeben. Plain: nur der Text (eine Zeile je
    Nachricht) — bewusst schlicht, damit der Aufrufer (Claude Code) die
    Anweisung direkt weiterverarbeiten kann."""
    if as_json:
        print(json.dumps(updates, indent=2, ensure_ascii=False))
        return
    for u in updates:
        print(_extract_msg(u).get("text", ""), flush=True)


def cmd_wait(args):
    """Einmalig blockieren, bis eine Nachricht eintrifft, ihren Text ausgeben und
    beenden. Fuer den interaktiven Fall: Claude Code wartet auf eine Anweisung.
    Exit 0 = Nachricht(en) empfangen, Exit 2 = Timeout ohne Nachricht."""
    api("deleteWebhook")
    accept = None if args.any_chat else resolve_chat_id(args)
    offset = None if args.no_drain else _drain_offset()
    updates, _ = _wait_for_message(offset, args.timeout, args.poll, accept)
    if not updates:
        if not args.quiet:
            print("Timeout: keine Nachricht innerhalb %ss." % args.timeout,
                  file=sys.stderr)
        sys.exit(2)
    _print_incoming(updates, args.json)


def cmd_ask(args):
    """Frage senden UND auf die Antwort warten (send + wait in einem Schritt).
    Gibt den Antworttext aus. Exit 2 = keine Antwort innerhalb des Timeouts."""
    api("deleteWebhook")
    chat_id = resolve_chat_id(args)
    accept = None if args.any_chat else chat_id
    # Backlog VOR dem Senden bestaetigen, damit alte Nachrichten nicht als
    # "Antwort" zaehlen; die eigene Frage erzeugt kein eingehendes Update.
    offset = None if args.no_drain else _drain_offset()
    parse_mode = PARSE_MODE.get(args.parse_mode, None)
    _send(chat_id, resolve_text(args), parse_mode, args.silent, no_preview=True)
    updates, _ = _wait_for_message(offset, args.timeout, args.poll, accept)
    if not updates:
        if not args.quiet:
            print("Timeout: keine Antwort innerhalb %ss." % args.timeout,
                  file=sys.stderr)
        sys.exit(2)
    _print_incoming(updates, args.json)


# --- CLI --------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="telegram",
        description="Telegram-Bot-Wrapper (outbound-first, stdlib only).")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_common_send(sp, with_title=False, with_host=False):
        sp.add_argument("text", nargs="?", default=None,
                        help="Nachrichtentext (oder '-'/leer = STDIN)")
        sp.add_argument("--file", help="Text aus Datei lesen")
        sp.add_argument("--chat-id", help="Ziel-Chat (Default: TELEGRAM_CHAT_ID)")
        sp.add_argument("--silent", action="store_true",
                        help="ohne Ton/Benachrichtigung (disable_notification)")
        sp.add_argument("--json", action="store_true", help="Roh-JSON ausgeben")
        if with_title:
            sp.add_argument("--title", help="Titelzeile der Vorlage")
        if with_host:
            sp.add_argument("--host", help="Host/Quelle fuer die Fusszeile")

    # me
    sp = sub.add_parser("me", help="Token pruefen (getMe)")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_me)

    # send
    sp = sub.add_parser("send", help="Nachricht senden (sendMessage)")
    add_common_send(sp)
    sp.add_argument("--parse-mode", default="none",
                    choices=sorted(PARSE_MODE.keys()),
                    help="Formatierung (Default: none = Klartext)")
    sp.add_argument("--no-preview", action="store_true",
                    help="Link-Vorschau unterdruecken")
    sp.set_defaults(func=cmd_send)

    # alert
    sp = sub.add_parser("alert", help="Alert-Vorlage (rot, HTML)")
    add_common_send(sp, with_title=True, with_host=True)
    sp.set_defaults(func=cmd_alert)

    # recovery
    sp = sub.add_parser("recovery", help="Recovery-Vorlage (gruen, HTML)")
    add_common_send(sp, with_title=True, with_host=True)
    sp.set_defaults(func=cmd_recovery)

    # digest
    sp = sub.add_parser("digest", help="Digest-Vorlage (Titel + Bullet-Zeilen)")
    add_common_send(sp, with_title=True)
    sp.set_defaults(func=cmd_digest)

    # setup
    sp = sub.add_parser("setup", help="chat_id via getUpdates ermitteln")
    sp.add_argument("--write", action="store_true",
                    help="TELEGRAM_CHAT_ID in die .env schreiben")
    sp.add_argument("--chat-id", help="bei mehreren Chats: gezielt diesen waehlen")
    sp.set_defaults(func=cmd_setup)

    # get-updates
    sp = sub.add_parser("get-updates", help="Roh-getUpdates (Empfangs-Baustein)")
    sp.add_argument("--offset", help="Update-Offset (Doubletten vermeiden)")
    sp.add_argument("--timeout", type=int, default=0,
                    help="Long-Poll-Timeout in s (Default 0 = sofort)")
    sp.set_defaults(func=cmd_get_updates)

    # poll
    sp = sub.add_parser("poll", help="Long-Poll-Scaffold (Empfang, Vordergrund)")
    sp.add_argument("--offset", help="Start-Offset")
    sp.add_argument("--timeout", type=int, default=50,
                    help="Long-Poll-Timeout in s (Sweet Spot 30-50)")
    sp.add_argument("--once", action="store_true",
                    help="nur ein getUpdates-Zyklus, dann beenden")
    sp.add_argument("--json", action="store_true",
                    help="je Update eine JSON-Zeile")
    sp.add_argument("--quiet", action="store_true", help="keine Status-Zeilen")
    sp.set_defaults(func=cmd_poll)

    def add_wait_opts(sp):
        sp.add_argument("--timeout", type=int, default=290,
                        help="gesamtes Warte-Budget in s (Default 290)")
        sp.add_argument("--poll", type=int, default=50,
                        help="Long-Poll-Zykluslaenge in s (Sweet Spot 30-50)")
        sp.add_argument("--any-chat", action="store_true",
                        help="Nachrichten aus JEDEM Chat annehmen (Default: nur "
                             "TELEGRAM_CHAT_ID/--chat-id)")
        sp.add_argument("--no-drain", action="store_true",
                        help="Backlog NICHT vorab bestaetigen (auch alte Nachrichten)")
        sp.add_argument("--json", action="store_true", help="Roh-JSON ausgeben")
        sp.add_argument("--quiet", action="store_true",
                        help="keine Timeout-/Status-Zeile auf stderr")

    # wait
    sp = sub.add_parser("wait",
                        help="blockieren bis Nachricht kommt, Text ausgeben (Exit 2 = Timeout)")
    sp.add_argument("--chat-id", help="erwarteter Chat (Default: TELEGRAM_CHAT_ID)")
    add_wait_opts(sp)
    sp.set_defaults(func=cmd_wait)

    # ask
    sp = sub.add_parser("ask", help="Frage senden UND auf Antwort warten")
    sp.add_argument("text", nargs="?", default=None,
                    help="Fragetext (oder '-'/leer = STDIN)")
    sp.add_argument("--file", help="Fragetext aus Datei lesen")
    sp.add_argument("--chat-id", help="Ziel/erwarteter Chat (Default: TELEGRAM_CHAT_ID)")
    sp.add_argument("--parse-mode", default="none",
                    choices=sorted(PARSE_MODE.keys()),
                    help="Formatierung der Frage (Default: none = Klartext)")
    sp.add_argument("--silent", action="store_true",
                    help="Frage still zustellen (disable_notification)")
    add_wait_opts(sp)
    sp.set_defaults(func=cmd_ask)

    return p


def main():
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
