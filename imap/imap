def select_parts(parts, args):
    """Auswahl aufloesen. Ein ausdruecklich benannter Teil wird immer geliefert,
    auch wenn er inline ist - der Inline-Filter gilt nur fuer --all."""
    if args.all:
        chosen = parts if args.include_inline else [p for p in parts if not p["inline"]]
        if not chosen:
            die("keine Anhaenge zum Speichern")
        return chosen

    if args.index is not None:
        hit = [p for p in parts if p["index"] == args.index]
        if not hit:
            die(f"kein Anhang mit Index {args.index} "
                f"(vorhanden: {', '.join(str(p['index']) for p in parts) or 'keiner'})")
        return hit

    hit = [p for p in parts if p["name"] == args.name]
    if not hit:
        hit = [p for p in parts if p["name"].lower() == args.name.lower()]
    if not hit:
        die(f"kein Anhang namens '{args.name}' "
            f"(vorhanden: {', '.join(p['name'] for p in parts) or 'keiner'})")
    if len(hit) > 1:
        die(f"'{args.name}' kommt {len(hit)}x vor - mit --index waehlen: "
            f"{', '.join(str(p['index']) for p in hit)}")
    return hit


def target_path(part, args, multiple):
    """Zielpfad bestimmen. --output ist ein Verzeichnis, sobald es eines ist,
    auf '/' endet oder mehrere Dateien geschrieben werden."""
    if not args.output:
        directory = default_dir()
    elif multiple or os.path.isdir(args.output) or args.output.endswith(os.sep):
        directory = args.output
    else:
        path = os.path.abspath(args.output)
        parent = os.path.dirname(path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        return path

    directory = os.path.abspath(directory)
    os.makedirs(directory, exist_ok=True)
    path = os.path.abspath(os.path.join(directory, part["name"]))

    # Gegenprobe: safe_filename hat Pfadanteile bereits entfernt, aber ein
    # Schreibziel wird nicht auf eine einzelne Funktion hin geglaubt

    if os.path.dirname(path) != directory:
        die(f"Anhang '{part['name']}' zeigt aus {directory} heraus")
    return path


