def build_parser():
    p = argparse.ArgumentParser(
        prog="imap",
        description="IMAP-Helper fuer Posteingang-Triage (Zugangsdaten aus muttrc)",
    )
    p.add_argument("--muttrc", default=DEFAULT_MUTTRC, help="Pfad zur muttrc")
    p.add_argument("--json", action="store_true", help="Ausgabe als JSON")

    # Dieselben Optionen zusaetzlich hinter dem Subcommand erlauben.
    # SUPPRESS ist noetig, sonst ueberschreibt der Default des Subparsers
    # einen vor dem Subcommand gesetzten Wert wieder mit False.

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--muttrc", default=argparse.SUPPRESS)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS)

    sub = p.add_subparsers(dest="command", required=True)

    sp = sub.add_parser("accounts", parents=[common], help="konfigurierte Konten zeigen")
    sp.set_defaults(func=cmd_accounts)

    sp = sub.add_parser("folders", parents=[common], help="Ordner und Sonderordner eines Kontos")
    sp.add_argument("--account", "-a")
    sp.set_defaults(func=cmd_folders)

    sp = sub.add_parser("list", parents=[common], help="Kopfdaten des Posteingangs (ohne Body)")
    sp.add_argument("--account", "-a", help="ohne Angabe: alle Konten")
    sp.add_argument("--folder", "-f", default="INBOX")
    sp.add_argument("--limit", "-n", type=int, default=DEFAULT_LIMIT)
    sp.add_argument("--unseen", action="store_true", help="nur ungelesene")
    sp.add_argument("--since", type=int, metavar="TAGE")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("read", parents=[common],
                        help="Textkoerper einer Mail (setzt \\Seen nicht)")
    sp.add_argument("uid", type=int)
    sp.add_argument("--account", "-a")
    sp.add_argument("--folder", "-f", default="INBOX")
    sp.add_argument("--max-chars", type=int, default=DEFAULT_MAX_CHARS)
    sp.add_argument("--headers", action="store_true",
                    help="alle Rohheader statt der Kopfzeilen-Auswahl")
    sp.add_argument("--raw", action="store_true",
                    help="komplette unbearbeitete Nachricht (Header + Body)")
    sp.set_defaults(func=cmd_read)

    sp = sub.add_parser("fetch", parents=[common],
                        help="mehrere Mails mit einem Login holen (setzt \\Seen nicht)")
    pick = sp.add_mutually_exclusive_group(required=True)
    pick.add_argument("--uids", metavar="LISTE",
                      help="UIDs, durch Komma oder Leerzeichen getrennt")
    pick.add_argument("--uid-file", metavar="DATEI",
                      help="Datei mit UIDs, '-' fuer stdin")
    sp.add_argument("--account", "-a")
    sp.add_argument("--folder", "-f", default="INBOX")
    sp.add_argument("--max-chars", type=int, default=DEFAULT_MAX_CHARS)
    sp.add_argument("--headers", action="store_true",
                    help="alle Rohheader statt der Kopfzeilen-Auswahl")
    sp.add_argument("--raw", action="store_true",
                    help="komplette unbearbeitete Nachrichten (Header + Body)")
    sp.add_argument("--output", "-o", metavar="VERZEICHNIS",
                    help="je UID eine Datei (<uid>.eml bei --raw, sonst <uid>.txt)")
    sp.add_argument("--overwrite", action="store_true",
                    help="vorhandene Dateien ueberschreiben statt ueberspringen")
    sp.set_defaults(func=cmd_fetch)

    sp = sub.add_parser("attachments", parents=[common],
                        help="Anhaenge einer Mail auflisten (setzt \\Seen nicht)")
    sp.add_argument("uid", type=int)
    sp.add_argument("--account", "-a")
    sp.add_argument("--folder", "-f", default="INBOX")
    sp.add_argument("--include-inline", action="store_true",
                    help="Inline-Teile (Signatur-Logos) mitzeigen")
    sp.set_defaults(func=cmd_attachments)

    sp = sub.add_parser("save-attachment", parents=[common],
                        help="Anhang speichern (Default .tmp/ im Arbeitsverzeichnis)")
    sp.add_argument("uid", type=int)
    sp.add_argument("--account", "-a")
    sp.add_argument("--folder", "-f", default="INBOX")
    pick = sp.add_mutually_exclusive_group(required=True)
    pick.add_argument("--name", help="Dateiname laut 'attachments'")
    pick.add_argument("--index", type=int, help="Index laut 'attachments'")
    pick.add_argument("--all", action="store_true", help="alle Anhaenge")
    sp.add_argument("--output", "-o", metavar="PFAD",
                    help="Datei oder Verzeichnis; ohne Angabe .tmp/")
    sp.add_argument("--include-inline", action="store_true",
                    help="bei --all auch Inline-Teile schreiben")
    sp.set_defaults(func=cmd_save_attachment)

    for name, help_text in (
        ("move", "verschieben"),
        ("copy", "kopieren"),
        ("delete", "in den Papierkorb verschieben"),
        ("spam", "in den Junk-Ordner verschieben"),
        ("seen", "als gelesen markieren"),
        ("unseen", "als ungelesen markieren"),
        ("flag", "markieren"),
        ("unflag", "Markierung entfernen"),
    ):
        sp = sub.add_parser(name, parents=[common], help=help_text)
        sp.add_argument("uid", type=int)
        sp.add_argument("--account", "-a")
        sp.add_argument("--folder", "-f", default="INBOX")
        if name in ("move", "copy"):
            sp.add_argument("--target", "-t", required=True,
                            help="Ordnername oder Sonderrolle (junk/trash/archive/sent/drafts)")
            sp.add_argument("--to-account", help="Zielkonto fuer kontouebergreifende Kopien")
        sp.add_argument("--dry-run", action="store_true")
        sp.set_defaults(func=cmd_op)

    sp = sub.add_parser("batch", parents=[common],
                        help="Operationen gebuendelt ausfuehren (ein Login je Konto)")
    sp.add_argument("file", help="JSON-Datei mit Operationen, '-' fuer stdin")
    sp.add_argument("--dry-run", action="store_true")
    sp.set_defaults(func=cmd_batch)

    return p


def main():
    args = build_parser().parse_args()
    accounts = load_accounts(os.path.expanduser(args.muttrc))
    args.func(args, accounts)


if __name__ == "__main__":
    try:
        try:
            main()
        finally:

            # Ausgabe hier leeren, solange der Fehler noch fangbar ist. Passt
            # die Ausgabe komplett in den Puffer, schreibt Python sie sonst
            # erst beim Interpreter-Exit - und ein Fehler dort landet
            # ungefiltert als "Exception ignored" auf stderr.

            sys.stdout.flush()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:

        # `read --raw | head` schliesst die Pipe frueh - das ist der
        # Normalfall, kein Fehler. stdout wird auf devnull umgebogen, damit
        # ein spaeterer Schreibversuch ins Leere laeuft; beendet wird ueber
        # os._exit, weil der regulaere Exit den Puffer noch einmal auf die
        # tote Pipe schreiben wuerde - dann mit einem Fehler, den an dieser
        # Stelle niemand mehr abfangen kann.

        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        os._exit(0)
