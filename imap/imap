def format_message(msg, max_chars, with_headers=False, with_raw=False):
    """Aufbereitete Textausgabe einer Mail - von read und fetch genutzt."""

    # --raw ersetzt die Aufbereitung: wer die Rohfassung will, will sie ungefiltert

    if with_raw:
        return msg["raw"]

    lines = []
    if with_headers:
        for name, value in msg["headers"]:
            lines.append(f"{name}: {value}")
    else:
        for k in ("from", "to", "subject", "date"):
            if msg[k]:
                lines.append(f"{k.capitalize():<9}{msg[k]}")
        if msg["attachments"]:
            names = ", ".join(x["name"] for x in msg["attachments"])
            lines.append(f"{'Anhang':<9}{names}")
    lines.append("-" * 72)
    lines.append(msg["body"])
    if msg["truncated"]:
        lines.append(f"\n[gekuerzt auf {max_chars} Zeichen]")
    return "\n".join(lines)


def collect_uids(args):
    """UID-Liste aus --uids oder --uid-file lesen.

    Getrennt wird an Komma und Leerraum, '#' leitet einen Kommentar ein - damit
    taugt eine Datei, in der neben den UIDs Notizen stehen, ohne Vorverarbeitung."""
    if args.uid_file:
        if args.uid_file == "-":
            text = sys.stdin.read()
        else:
            with open(args.uid_file, encoding="utf-8") as f:
                text = f.read()
    else:
        text = args.uids

    text = re.sub(r"#[^\n]*", " ", text)
    uids, seen = [], set()
    for token in re.split(r"[,\s]+", text.strip()):
        if not token:
            continue
        if not token.isdigit():
            die(f"'{token}' ist keine UID")
        uid = int(token)
        if uid not in seen:
            seen.add(uid)
            uids.append(uid)
    if not uids:
        die("keine UIDs angegeben")
    return uids


def cmd_fetch(args, accounts):
    """Mehrere Mails mit einem Login holen - lesendes Gegenstueck zu batch."""
    uids = collect_uids(args)
    acc = pick_account(accounts, args.account)

    with Account(acc) as a:
        found = a.peek_raw_many(uids, args.folder)
        msgs = [
            a.render(found[u], u, args.folder, args.max_chars, args.headers, args.raw)
            for u in uids if u in found
        ]
    missing = [u for u in uids if u not in found]

    if args.output:
        write_fetched(args, acc, found, msgs, missing, uids)
        return

    if args.json:
        out_json({
            "account": acc["alias"],
            "folder": args.folder,
            "count": len(msgs),
            "missing": missing,
            "messages": msgs,
        })
        return

    # Ohne Trennzeile waere ein Stapel Rohmails auf stdout nicht mehr
    # aufteilbar - byte-genau kommt die Rohfassung ohnehin nur ueber -o

    for msg in msgs:
        print(f"── {msg['account']}/{msg['uid']} " + "─" * 40)
        print(format_message(msg, args.max_chars, args.headers, args.raw))
        print()
    summary = f"{len(msgs)} Mails"
    if missing:
        summary += f", {len(missing)} nicht gefunden: {', '.join(str(u) for u in missing)}"
    print(summary)


def write_fetched(args, acc, found, msgs, missing, uids):
    """Je UID eine Datei schreiben.

    Vorhandene Dateien werden uebersprungen statt ueberschrieben oder
    durchnummeriert: der Dateiname ist die UID, ein zweiter Lauf meint also
    dieselbe Mail. So ist ein abgebrochener Stapelabruf wiederholbar, ohne
    einen Korpus mit Dubletten zu fuellen (--overwrite erzwingt das Schreiben)."""
    os.makedirs(args.output, exist_ok=True)
    ext = ".eml" if args.raw else ".txt"

    saved, skipped = [], []
    for msg in msgs:
        path = os.path.join(args.output, f"{msg['uid']}{ext}")
        if os.path.exists(path) and not args.overwrite:
            skipped.append({"uid": msg["uid"], "path": path})
            continue

        # Rohfassung byte-genau schreiben - das Decoding in render() ersetzt
        # ungueltige Sequenzen und taugt fuer eine .eml-Ablage nicht

        if args.raw:
            data = found[msg["uid"]]
        else:
            data = (format_message(msg, args.max_chars, args.headers) + "\n").encode("utf-8")
        with open(path, "wb") as f:
            f.write(data)
        saved.append({"uid": msg["uid"], "path": path, "bytes": len(data)})

    if args.json:
        out_json({
            "account": acc["alias"],
            "folder": args.folder,
            "requested": len(uids),
            "saved": saved,
            "skipped": skipped,
            "missing": missing,
        })
        return
    for s in saved:
        print(f"{s['path']}  ({human_size(s['bytes'])})")
    print(f"\n{len(saved)} geschrieben, {len(skipped)} uebersprungen, "
          f"{len(missing)} nicht gefunden")


def human_size(n):
    for unit in ("B", "K", "M"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.1f}G"


