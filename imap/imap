def resolve_target(a, target):
    """Zielordner aufloesen: Sonderrolle (junk/trash/...) oder echter Name."""
    key = target.lower()
    if key in SPECIAL_FALLBACK:
        found = a.special_folder(key)
        if not found:
            die(f"[{a.alias}] kein Ordner fuer '{target}' gefunden - echten Namen angeben")
        return found
    return target


def cmd_batch(args, accounts):
    """Operationen gebuendelt ausfuehren - ein Login je Konto statt eins je Mail."""
    if args.file == "-":
        payload = sys.stdin.read()
    else:
        with open(args.file, encoding="utf-8") as f:
            payload = f.read()
    try:
        ops = json.loads(payload)
    except json.JSONDecodeError as e:
        die(f"Batch-Datei ist kein gueltiges JSON: {e}")
    if isinstance(ops, dict):
        ops = ops.get("operations", [])
    if not isinstance(ops, list) or not ops:
        die("Batch enthaelt keine Operationen")

    by_account = {}
    for op in ops:
        by_account.setdefault(op.get("account"), []).append(op)

    results = []
    for alias, group in by_account.items():
        cfg = pick_account(accounts, alias)

        # Ziel-Konten fuer kontouebergreifende Kopien erst bei Bedarf oeffnen

        with Account(cfg) as a:
            targets = {}
            try:
                for op in group:
                    results.append(run_op(a, op, accounts, targets, args.dry_run))
            finally:
                for t in targets.values():
                    t.__exit__(None, None, None)

    ok = sum(1 for r in results if r["ok"])
    if args.json:
        out_json({"ok": ok, "failed": len(results) - ok, "results": results})
        return
    for r in results:
        mark = "ok  " if r["ok"] else "FEHL"
        print(f"{mark} {r['action']:<8} {r['account']}/{r['uid']:<7} {r['detail']}")
    print(f"\n{ok} von {len(results)} Operationen erfolgreich")


def run_op(a, op, accounts, targets, dry_run):
    """Einzelne Operation gegen ein offenes Konto ausfuehren."""
    action = (op.get("action") or "").lower()
    uid = op.get("uid")
    folder = op.get("folder", "INBOX")
    base = {"account": a.alias, "uid": uid, "action": action}

    if uid is None:
        return {**base, "ok": False, "detail": "uid fehlt"}

    try:
        if action in ("move", "copy", "delete", "spam"):
            if action == "delete":
                target_name = "trash"
            elif action == "spam":
                target_name = "junk"
            else:
                target_name = op.get("target")
            if not target_name:
                return {**base, "ok": False, "detail": "target fehlt"}

            to_account = op.get("to_account")

            if to_account and to_account != a.alias:
                return run_cross(a, op, accounts, targets, target_name, dry_run, base)

            resolved = resolve_target(a, target_name)
            if dry_run:
                return {**base, "ok": True, "detail": f"[dry-run] -> {resolved}"}
            if action == "copy":
                ok, detail = a.copy_local(uid, resolved, folder)
            else:
                ok, detail = a.move(uid, resolved, folder)
            return {**base, "ok": ok, "detail": f"{detail} -> {resolved}"}

        if action in ("seen", "unseen", "flag", "unflag"):
            flag = "\\Seen" if action in ("seen", "unseen") else "\\Flagged"
            on = action in ("seen", "flag")
            if dry_run:
                return {**base, "ok": True, "detail": f"[dry-run] {flag} {'setzen' if on else 'entfernen'}"}
            ok, detail = a.set_flag(uid, flag, on, folder)
            return {**base, "ok": ok, "detail": detail}

        return {**base, "ok": False, "detail": f"unbekannte Aktion '{action}'"}

    except Exception as e:
        return {**base, "ok": False, "detail": f"{type(e).__name__}: {e}"}


def run_cross(a, op, accounts, targets, target_name, dry_run, base):
    """Kontouebergreifend: FETCH, APPEND ins Ziel, erst danach Quelle aufraeumen."""
    uid = op["uid"]
    folder = op.get("folder", "INBOX")
    to_alias = op["to_account"]

    if to_alias not in targets:
        t = Account(pick_account(accounts, to_alias))
        t.__enter__()
        targets[to_alias] = t
    tgt = targets[to_alias]

    resolved = resolve_target(tgt, target_name)

    raw, flags, internaldate = a.raw_message(uid, folder)

    msg = email.message_from_bytes(raw)
    mid = (msg.get("Message-ID") or "").strip()

    existing = tgt.find_by_message_id(mid, resolved)
    if existing:
        detail = f"schon vorhanden in {to_alias}/{resolved}, uebersprungen"
        if op.get("action") == "move" and not dry_run:
            ok, d = a.move(uid, resolve_target(a, "trash"), folder)
            detail += f"; Quelle: {d}"
        return {**base, "ok": True, "detail": detail}

    if dry_run:
        return {**base, "ok": True, "detail": f"[dry-run] -> {to_alias}/{resolved} ({len(raw)} B)"}

    ok, detail = tgt.append(resolved, raw, flags, internaldate)
    if not ok:

        # Quelle bleibt unangetastet - lieber ein fehlender Transfer als eine verlorene Mail

        return {**base, "ok": False, "detail": f"APPEND nach {to_alias}/{resolved}: {detail}"}

    result = f"-> {to_alias}/{resolved}"
    if op.get("action") == "move":
        trash = resolve_target(a, "trash")
        ok2, d2 = a.move(uid, trash, folder)
        result += f"; Quelle -> {trash} ({d2})" if ok2 else f"; Quelle NICHT geraeumt: {d2}"
    return {**base, "ok": True, "detail": result}


def cmd_op(args, accounts):
    """Einzeloperation - identische Semantik wie ein Batch mit einem Eintrag."""
    op = {
        "account": args.account,
        "action": args.command,
        "uid": args.uid,
        "folder": args.folder,
    }
    if args.command in ("move", "copy"):
        op["target"] = args.target
    if getattr(args, "to_account", None):
        op["to_account"] = args.to_account

    cfg = pick_account(accounts, args.account)
    with Account(cfg) as a:
        targets = {}
        try:
            r = run_op(a, op, accounts, targets, args.dry_run)
        finally:
            for t in targets.values():
                t.__exit__(None, None, None)

    if args.json:
        out_json(r)
        return
    mark = "ok" if r["ok"] else "FEHLER"
    print(f"{mark}: {r['action']} {r['account']}/{r['uid']} - {r['detail']}")
    if not r["ok"]:
        sys.exit(1)


